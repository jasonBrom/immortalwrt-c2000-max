#!/bin/sh /etc/rc.common

START=08

tm_path=/tmp/.testmode

profile_value() {
	local key="$1"
	sed -n "s/^${key}[[:space:]]*=[[:space:]]*//p" \
		/etc/wireless/l1profile.dat 2>/dev/null | head -n 1 | tr -d '\r'
}

find_factory_partition() {
	local dev

	for dev in $(blkid -t PARTLABEL=factory -o device 2>/dev/null) \
		$(blkid -t PARTLABEL=Factory -o device 2>/dev/null); do
		[ -b "$dev" ] || continue
		printf '%s\n' "$dev"
		return 0
	done
	return 1
}

check_testmode() {
	local factory_part
	factory_part="$(find_factory_partition)"

        # boot up to check 0x1af[0]

        for idx in 0 1 2; do
                option="INDEX${idx}_profile_path"
		profile_path="$(profile_value "$option")"
		# Missing INDEX1/INDEX2 used to feed an empty path to `grep -r`,
		# recursively scanning the entire root filesystem several times.
		[ -n "$profile_path" ] && [ -f "$profile_path" ] || continue
		CardAccessMode="$(sed -n 's/^E2pAccessMode[[:space:]]*=[[:space:]]*//p' \
			"$profile_path" | head -n 1 | tr -d '[:space:]')"
		case "$CardAccessMode" in ''|*[!0-9]*) CardAccessMode=0 ;; esac

                if [ -n "$factory_part" ]; then
			CardE2p1AF=$(hexdump -v -n 1 -s 0x1af -e '1/1 "%u"' \
				"$factory_part" 2>/dev/null)
                else
			CardE2p1AF=$(mtk_factory_rw.sh -r 1 0x1af 2>/dev/null)
                fi
		case "$CardE2p1AF" in ''|*[!0-9]*) CardE2p1AF=0 ;; esac

                echo "idx ${idx} 2:${profile_path} 3:${CardAccessMode}, 4:${CardE2p1AF}"
		if [ "$CardAccessMode" -eq 2 ]; then
                        if [ $((CardE2p1AF & 1)) -eq 1 ]; then
                                echo "card${idx} e2p_1af: Test mode"
				sed -i 's/^TestModeEn=0/TestModeEn=1/' "$profile_path"
				touch "$tm_path" && chmod +x "$tm_path"
				IF="$(profile_value "INDEX${idx}_main_ifname")"
				IF="${IF%%;*}"
				[ -z "$IF" ] || echo "mwctl ${IF} set ATE=ATESTART" >> "$tm_path"
                        else
                                echo "card${idx} e2p_1af: Normal mode"
				sed -i 's/^TestModeEn=1/TestModeEn=0/' "$profile_path"
                        fi
                else
			CardTestModeEn="$(sed -n 's/^TestModeEn[[:space:]]*=[[:space:]]*//p' \
				"$profile_path" | head -n 1 | tr -d '[:space:]')"
			case "$CardTestModeEn" in ''|*[!0-9]*) CardTestModeEn=0 ;; esac
                        if [ $((CardTestModeEn & 1)) -eq 1 ]; then
				touch "$tm_path" && chmod +x "$tm_path"
				IF="$(profile_value "INDEX${idx}_main_ifname")"
				IF="${IF%%;*}"
				[ -z "$IF" ] || echo "mwctl ${IF} set ATE=ATESTART" >> "$tm_path"
                        fi
                fi
        done
}


boot() {
	rm -f "$tm_path"
	check_testmode
}
