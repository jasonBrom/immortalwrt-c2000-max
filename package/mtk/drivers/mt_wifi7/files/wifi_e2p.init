#!/bin/sh /etc/rc.common

START=07

mtk_wifi_e2p_die() {
	echo "mtk wifi eeprom:" "$*" >&2
}

profile_value() {
	local key="$1"
	sed -n "s/^${key}[[:space:]]*=[[:space:]]*//p" \
		/etc/wireless/l1profile.dat 2>/dev/null | head -n 1 | tr -d '\r'
}

find_ubi_volume() {
	local vol_name="$1" vol name
	for vol in /sys/class/ubi/ubi*_*/name; do
		[ -r "$vol" ] || continue
		name="$(cat "$vol" 2>/dev/null)"
		[ "$name" = "$vol_name" ] || continue
		vol="${vol%/name}"
		echo "/dev/${vol##*/}"
		return 0
	done
	return 1
}

mtk_wifi_e2p_extract() {
	local part="$1" offset="$2" count="$3"
	local mtd ubi mmc input_dev output temporary

	. /lib/functions.sh
	output="/lib/firmware/$FIRMWARE"
	temporary="${output}.new"
	mtd="$(find_mtd_part "$part" 2>/dev/null)"
	mtd="$(echo "$mtd" | sed 's/mtdblock/mtd/')"
	ubi="$(find_ubi_volume "$part")"
	mmc="$(blkid -t PARTLABEL=factory -o device 2>/dev/null | head -n 1)"
	rm -f "$temporary"

	if [ -n "$mtd" ]; then
		nanddump "$mtd" -f "$temporary" -s "$offset" -l "$count" 2>/dev/null
	elif [ -n "$ubi" ]; then
		input_dev="$ubi"
	elif [ -n "$mmc" ]; then
		input_dev="$mmc"
	else
		mtk_wifi_e2p_die "no flash device found for partition $part"
		return 1
	fi

	if [ -n "$input_dev" ]; then
		if [ "$offset" -eq 0 ]; then
			dd if="$input_dev" of="$temporary" bs="$count" count=1 2>/dev/null
		else
			dd if="$input_dev" of="$temporary" bs=1 skip="$offset" count="$count" 2>/dev/null
		fi
	fi

	if [ -f "$temporary" ] && [ "$(wc -c < "$temporary")" = "$count" ]; then
		mv -f "$temporary" "$output"
		return 0
	fi

	rm -f "$temporary"
	mtk_wifi_e2p_die "failed to extract $count bytes from partition $part"
	return 1
}

check_e2p() {
	local board idx name offset size final_size fw

	[ -f /etc/wireless/l1profile.dat ] || return 0
	[ -n "$FIRMWARE" ] || FIRMWARE="$(profile_value INDEX0_EEPROM_name)"
	[ -n "$FIRMWARE" ] || return 0
	fw="/lib/firmware/$FIRMWARE"

	for idx in 2 1 0; do
		name="$(profile_value "INDEX${idx}_EEPROM_name")"
		[ -n "$name" ] && [ "$FIRMWARE" = "$name" ] || continue
		offset="$(profile_value "INDEX${idx}_EEPROM_offset")"
		size="$(profile_value "INDEX${idx}_EEPROM_size")"
		offset="$(printf '%d' "$offset" 2>/dev/null)" || return 1
		size="$(printf '%d' "$size" 2>/dev/null)" || return 1
		final_size=$((offset + size))
		break
	done
	[ -n "$final_size" ] || return 0

	board="$(cat /tmp/sysinfo/board_name 2>/dev/null)"
	if [ "$board" = nradio,c2000-max ] && [ -x /usr/sbin/c2000max-factory ]; then
		/usr/sbin/c2000max-factory prepare-eeprom "$fw" "$final_size" \
			/lib/firmware/MT7993_EEPROM.bin
		return $?
	fi

	[ -f "$fw" ] && [ "$(wc -c < "$fw")" = "$final_size" ] && return 0
	mtk_wifi_e2p_extract Factory 0 "$final_size"
}

boot() {
	check_e2p
}
