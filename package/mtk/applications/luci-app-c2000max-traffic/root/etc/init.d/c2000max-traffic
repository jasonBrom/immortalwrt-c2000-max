#!/bin/sh /etc/rc.common

START=51
STOP=89
USE_PROCD=1

start_service()
{
	local enabled

	config_load c2000max_traffic
	config_get_bool enabled config enabled 1
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/c2000max-traffic daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service()
{
	/usr/sbin/c2000max-traffic flush >/dev/null 2>&1 || true
	rm -f /tmp/c2000max-traffic/daemon.pid
}

reload_service()
{
	local enabled pid

	config_load c2000max_traffic
	config_get_bool enabled config enabled 1
	pid="$(cat /tmp/c2000max-traffic/daemon.pid 2>/dev/null)"
	if [ "$enabled" -ne 1 ]; then
		stop
		return 0
	fi

	case "$pid" in
		''|*[!0-9]*) ;;
		*)
			if kill -0 "$pid" 2>/dev/null; then
				# The daemon reads sampling/retention/storage settings on each
				# iteration. Apply only the small nft policy delta here; do not
				# flush a potentially 100 MB log or restart a healthy collector.
				/usr/sbin/c2000max-traffic audit-policy >/dev/null 2>&1 || true
				return 0
			fi
			;;
	esac
	start
}

service_triggers()
{
	procd_add_reload_trigger c2000max_traffic
}
