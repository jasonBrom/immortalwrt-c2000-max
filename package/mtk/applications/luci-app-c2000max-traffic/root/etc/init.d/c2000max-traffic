#!/bin/sh /etc/rc.common

START=51
STOP=89
USE_PROCD=1

disable_conntrack_accounting_if_unused()
{
	local enabled audit_enabled

	config_load c2000max_traffic
	config_get_bool enabled config enabled 0
	config_get_bool audit_enabled audit enabled 0
	[ "$enabled" -ne 1 ] && [ "$audit_enabled" -ne 1 ] || return 0
	sysctl -qw net.netfilter.nf_conntrack_acct=0 2>/dev/null || true
}

start_service()
{
	local enabled audit_enabled

	config_load c2000max_traffic
	config_get_bool enabled config enabled 0
	config_get_bool audit_enabled audit enabled 0
	# Statistics and audit/control share the lightweight supervisor, but are
	# independent features.  With statistics disabled the daemon only refreshes
	# schedule boundaries and never walks conntrack or the MediaTek MIB.
	[ "$enabled" -eq 1 ] || [ "$audit_enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/c2000max-traffic daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service()
{
	/usr/sbin/c2000max-traffic flush >/dev/null 2>&1 || true
	rm -f /tmp/c2000max-traffic/daemon.pid
	disable_conntrack_accounting_if_unused
}

reload_service()
{
	local enabled audit_enabled pid

	config_load c2000max_traffic
	config_get_bool enabled config enabled 0
	config_get_bool audit_enabled audit enabled 0
	pid="$(cat /tmp/c2000max-traffic/daemon.pid 2>/dev/null)"
	if [ "$enabled" -ne 1 ] && [ "$audit_enabled" -ne 1 ]; then
		/etc/init.d/c2000max-appfilter stop >/dev/null 2>&1 || true
		stop
		return 0
	fi
	# This service owns the UCI reload trigger.  Start/reconfigure OAF before
	# applying its nft consumer policy; when audit was disabled at boot the
	# appfilter procd instance does not yet exist and cannot receive a trigger.
	if [ "$audit_enabled" -eq 1 ]; then
		if [ -r /proc/sys/oaf/version ]; then
			/etc/init.d/c2000max-appfilter reload >/dev/null 2>&1 || return 1
		else
			/usr/sbin/c2000max-traffic audit-engine-sync >/dev/null 2>&1 || return 1
		fi
	else
		/etc/init.d/c2000max-appfilter stop >/dev/null 2>&1 || true
	fi

	case "$pid" in
		''|*[!0-9]*) ;;
		*)
			if kill -0 "$pid" 2>/dev/null; then
				# The daemon reads sampling/retention/storage settings on each
				# iteration. Apply only the small nft policy delta here; do not
				# flush a potentially 100 MB log or restart a healthy collector.
				/usr/sbin/c2000max-traffic audit-policy >/dev/null 2>&1 || true
				return 0
			fi
			;;
	esac
	start
}

service_triggers()
{
	procd_add_reload_trigger c2000max_traffic
}
