#!/bin/sh

set -eu

UPLOAD="${1:-/tmp/c2000max-feature-upload}"
FEATURE_DIR="${C2000_FEATURE_DIR:-/etc/appfilter}"
FEATURE_FILE="$FEATURE_DIR/feature.cfg"
META_FILE="${C2000_FEATURE_META:-/etc/c2000max-traffic/feature.meta}"
ICON_DIR="${C2000_FEATURE_ICON_DIR:-/www/luci-static/resources/c2000max-app-icons}"
WORK="/tmp/c2000max-feature.$$"
MAX_UPLOAD=$((8 * 1024 * 1024))
MAX_EXPANDED=$((32 * 1024 * 1024))
MAX_ENTRIES=2048

fail()
{
	echo "feature update failed: $*" >&2
	exit 1
}

cleanup()
{
	rm -rf "$WORK"
}

trap cleanup EXIT HUP INT TERM
umask 077

[ -f "$UPLOAD" ] || fail "upload is missing"
size="$(stat -c '%s' "$UPLOAD" 2>/dev/null || wc -c < "$UPLOAD")"
case "$size" in ''|*[!0-9]*) fail "cannot read upload size" ;; esac
[ "$size" -gt 0 ] && [ "$size" -le "$MAX_UPLOAD" ] ||
	fail "upload must be between 1 byte and 8 MiB"

mkdir -p "$WORK/content" "$FEATURE_DIR" "$(dirname "$META_FILE")"
magic="$(od -An -tx1 -N2 "$UPLOAD" 2>/dev/null | tr -d ' \n')"

case "$magic" in
	504b)
		unzip -Z1 "$UPLOAD" > "$WORK/zip.list" 2>/dev/null ||
			fail "invalid ZIP container"
		awk '
			BEGIN { bad=0; bins=0 }
			/^\// || /(^|\/)\.\.($|\/)/ || /\\/ || /[[:cntrl:]]/ { bad=1 }
			/\.bin$/ { bins++ }
			END { exit bad || bins != 1 }
		' "$WORK/zip.list" || fail "ZIP must contain exactly one safe .bin library"
		bin_name="$(awk '/\.bin$/ { print; exit }' "$WORK/zip.list")"
		unzip -p "$UPLOAD" "$bin_name" > "$WORK/library.bin" 2>/dev/null ||
			fail "cannot extract the .bin library"
		;;
	1f8b)
		cp "$UPLOAD" "$WORK/library.bin"
		;;
	*)
		fail "supported inputs are the official ZIP or its gzip .bin file"
		;;
esac

bin_magic="$(od -An -tx1 -N2 "$WORK/library.bin" 2>/dev/null | tr -d ' \n')"
[ "$bin_magic" = 1f8b ] || fail ".bin is not the expected gzip archive"

tar -tzf "$WORK/library.bin" > "$WORK/tar.list" 2>/dev/null ||
	fail "invalid gzip/tar feature library"
entries="$(wc -l < "$WORK/tar.list")"
[ "$entries" -le "$MAX_ENTRIES" ] || fail "feature archive has too many entries"
awk '
	function normalized(s) { sub(/^\.\//, "", s); return s }
	{
		p=normalized($0)
		if (p == "" || p == "app_icons" || p == "app_icons/") next
		if (p == "feature.cfg") { feature++; next }
		if (p ~ /^app_icons\/([0-9]+|default)\.png$/) next
		bad=1
	}
	END { exit bad || feature != 1 }
' "$WORK/tar.list" || fail "archive contains an unsafe or unsupported path"

tar -tvzf "$WORK/library.bin" > "$WORK/tar.verbose" 2>/dev/null ||
	fail "cannot inspect the feature archive"
awk -v max="$MAX_EXPANDED" '
	$1 !~ /^[-d]/ { bad=1 }
	$3 ~ /^[0-9]+$/ { total += $3 }
	END { exit bad || total > max }
' "$WORK/tar.verbose" || fail "archive contains links/devices or expands beyond 32 MiB"

tar -xzf "$WORK/library.bin" -C "$WORK/content" 2>/dev/null ||
	fail "cannot unpack the feature library"
[ "$(du -sk "$WORK/content" | awk '{print $1}')" -le $((MAX_EXPANDED / 1024)) ] ||
	fail "unpacked feature library exceeds 32 MiB"
[ -f "$WORK/content/feature.cfg" ] || fail "feature.cfg is missing"

awk '
	NR == 1 && $1 == "#version" && $2 ~ /^v[0-9]+([.][0-9]+)*$/ { version=1; next }
	NR == 2 && $1 == "#format" && $2 == "v3.0" { format=1; next }
	length($0) >= 600 { bad=1 }
	/^#class[[:space:]]+/ { classes++; next }
	/^[0-9]+[[:space:]]+[^:]+:\[/ {
		id=$1+0
		if (id <= 1000 || id >= 32000) bad=1
		app_ids[id]=1
		next
	}
	/^[[:space:]]*$/ || /^#/ { next }
	{ bad=1 }
	END {
		for (id in app_ids) apps++
		exit bad || !version || !format || apps < 1 || classes < 1
	}
' "$WORK/content/feature.cfg" || fail "feature.cfg is not valid OAF v3.0 data"

version="$(awk 'NR == 1 { print $2 }' "$WORK/content/feature.cfg")"
app_count="$(awk '/^[0-9]+[[:space:]]+[^:]+:\[/ { ids[$1]=1 } \
	END { for (id in ids) count++; print count+0 }' \
	"$WORK/content/feature.cfg")"
sha256="$(sha256sum "$WORK/content/feature.cfg" | awk '{print $1}')"

[ ! -f "$FEATURE_FILE" ] || cp "$FEATURE_FILE" "$FEATURE_FILE.previous"
cp "$WORK/content/feature.cfg" "$FEATURE_FILE.new"
chmod 0644 "$FEATURE_FILE.new"
mv "$FEATURE_FILE.new" "$FEATURE_FILE"

if [ -d "$WORK/content/app_icons" ]; then
	mkdir -p "$ICON_DIR"
	for icon in "$WORK/content"/app_icons/*.png; do
		[ -f "$icon" ] || continue
		name="${icon##*/}"
		case "$name" in default.png|[0-9]*.png) ;; *) continue ;; esac
		cp "$icon" "$ICON_DIR/$name.new"
		chmod 0644 "$ICON_DIR/$name.new"
		mv "$ICON_DIR/$name.new" "$ICON_DIR/$name"
	done
fi

{
	printf 'version=%s\n' "$version"
	printf 'format=v3.0\n'
	printf 'apps=%s\n' "$app_count"
	printf 'sha256=%s\n' "$sha256"
	printf 'updated=%s\n' "$(date +%s)"
} > "$META_FILE.new"
chmod 0644 "$META_FILE.new"
mv "$META_FILE.new" "$META_FILE"

if pidof c2000max-oafd >/dev/null 2>&1; then
	kill -USR1 "$(pidof c2000max-oafd | awk '{print $1}')" 2>/dev/null || true
fi

printf '{"success":true,"version":"%s","format":"v3.0","apps":%s,"sha256":"%s"}\n' \
	"$version" "$app_count" "$sha256"
