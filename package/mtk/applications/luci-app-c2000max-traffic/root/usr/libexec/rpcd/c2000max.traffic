#!/bin/sh

case "$1" in
	list)
		cat <<'EOF'
{
	"status": {},
	"sample": {},
	"reset": {},
	"catalog": {},
	"audit": {
		"device": "String",
		"from": "Integer",
		"to": "Integer"
	},
	"feature_install": {},
	"policy_reload": {}
}
EOF
		;;
	call)
		read -r input
		case "$2" in
			status)
				exec /usr/sbin/c2000max-traffic status
				;;
			sample)
				if /usr/sbin/c2000max-traffic sample; then
					exec /usr/sbin/c2000max-traffic status
				else
					echo '{"success":false,"message":"traffic sample failed"}'
				fi
				;;
			reset)
				exec /usr/sbin/c2000max-traffic reset
				;;
			catalog)
				exec /usr/sbin/c2000max-traffic catalog
				;;
			audit)
				device="$(printf '%s' "$input" | jsonfilter -e '@.device' 2>/dev/null)"
				from="$(printf '%s' "$input" | jsonfilter -e '@.from' 2>/dev/null)"
				to="$(printf '%s' "$input" | jsonfilter -e '@.to' 2>/dev/null)"
				exec /usr/sbin/c2000max-traffic audit "$device" "$from" "$to"
				;;
			feature_install)
				exec /usr/sbin/c2000max-feature-install /tmp/c2000max-feature-upload
				;;
			policy_reload)
				/usr/sbin/c2000max-traffic audit-policy >/dev/null 2>&1 || true
				exec /usr/sbin/c2000max-traffic status
				;;
		esac
		;;
esac
