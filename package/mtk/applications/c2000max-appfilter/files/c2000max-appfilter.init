#!/bin/sh /etc/rc.common

START=50
STOP=90
USE_PROCD=1
OAF_SYSCTL_DIR="${C2000_OAF_SYSCTL_DIR:-/proc/sys/oaf}"

audit_enabled()
{
	[ "$(uci -q get c2000max_traffic.audit.enabled)" = 1 ]
}

apply_lan_device_profile()
{
	[ -w "$OAF_SYSCTL_DIR/lan_ifname" ] || return 1
	# Keep the legacy module on the bridge device.  Broadening this to the
	# substring "lan" makes old kernels inspect DSA slave ingress directly and
	# can re-enter the packet path which previously caused an OAF watchdog boot
	# loop.  The flowctl1 kernel handles DSA slaves through their bridge master,
	# so it also uses the exact bridge name.
	printf '%s\n' br-lan > "$OAF_SYSCTL_DIR/lan_ifname"
}

apply_recognition_profile()
{
	local mode hold packets

	mode="$(uci -q get c2000max_traffic.audit.recognition_mode)"
	case "$mode" in
		seamless)
			hold=0
			packets=8
			;;
		balanced)
			hold=1
			packets=8
			;;
		precise)
			hold=1
			packets=64
			;;
		*)
			hold=1
			packets=8
			;;
	esac

	printf '%s\n' "$hold" > "$OAF_SYSCTL_DIR/hold_acceleration" || return 1
	printf '%s\n' "$packets" > "$OAF_SYSCTL_DIR/max_dpi_packets" || return 1
	apply_lan_device_profile || return 1
}

start_service()
{
	# Complete or safely roll back the durable identity side of an interrupted
	# profile switch before the kernel reads feature.cfg.  The manager is an
	# optional companion package, so standalone appfilter installs still work.
	if [ -x /usr/sbin/c2000max-feature-manager ]; then
		/usr/sbin/c2000max-feature-manager init >/dev/null 2>&1 || {
			logger -t c2000max-appfilter "cannot reconcile the active OAF feature profile"
			return 1
		}
	fi
	audit_enabled || return 0

	# OAF uses conntrack packet counters to bound first-packet inspection.
	# Enable accounting before new audited connections are created.
	sysctl -qw net.netfilter.nf_conntrack_acct=1 2>/dev/null || true
	mkdir -p /tmp
	ln -sf /etc/appfilter/feature.cfg /tmp/feature.cfg
	# The module performs an immediate feature load from this path. Create the
	# link before modprobe rather than waiting for oafd's first timer.
	modprobe oaf || return 1
	apply_recognition_profile || {
		logger -t c2000max-appfilter "cannot apply OAF recognition profile"
		modprobe -r oaf >/dev/null 2>&1 || true
		return 1
	}
	# Classification and visit recording stay enabled, while blocking is
	# enforced by the C2000MAX nft policy compiler after APP_ID is known.
	uci -q set appfilter.global.enable='0'
	uci -q set appfilter.global.record_enable='1'
	uci -q set appfilter.global.disable_hnat='0'
	uci -q set appfilter.global.work_mode='0'
	uci -q set appfilter.global.lan_ifname='br-lan'
	# The init script owns module lifetime. Avoid a second daemon-side modprobe,
	# which otherwise produces a misleading startup warning after a clean load.
	uci -q set appfilter.global.auto_load_engine='0'
	uci -q commit appfilter

	procd_open_instance
	procd_set_param command /usr/bin/c2000max-oafd
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance

	# Establish the byte-accounting baseline without destroying every LAN
	# conntrack/PPE entry.  A native IK profile contains roughly 15k features;
	# forcing all devices to reconnect at once made both A53 CPUs enter DPI
	# softirq together and could starve the 30-second hardware watchdog.  Old
	# sessions age out naturally while all newly created sessions are audited.
	/usr/sbin/c2000max-traffic sample >/dev/null 2>&1 || true
}

stop_service()
{
	/usr/sbin/c2000max-traffic audit-policy-clear >/dev/null 2>&1 || true
	modprobe -r oaf >/dev/null 2>&1 || true
}

reload_service()
{
	if ! audit_enabled; then
		stop
		return 0
	fi

	# Most c2000max_traffic changes are schedules, retention or UI settings.
	# Restarting the engine for those changes used to run audit-reset, destroy
	# every LAN conntrack entry and flush all PPE flows. Keep a healthy engine
	# alive and update only the two runtime recognition controls. A full start
	# (and its one-time connection reset) is reserved for first enable/recovery.
	if [ -d /sys/module/oaf ] && pidof c2000max-oafd >/dev/null 2>&1; then
		apply_recognition_profile || {
			logger -t c2000max-appfilter "cannot hot-apply OAF recognition profile"
			return 1
		}
		return 0
	fi

	stop
	start
}

service_triggers()
{
	procd_add_reload_trigger c2000max_traffic appfilter
}
