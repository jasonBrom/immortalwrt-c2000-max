#!/bin/sh

RUNTIME_DIR=/var/run/eqos
ERROR_FILE="$RUNTIME_DIR/last_error"

status_json()
{
	local enabled backend effective active=0 reason error qos_state diagnostic
	local upload_profiles=0 download_profiles=0

	enabled="$(uci -q get eqos.config.enabled)"
	[ "$enabled" = 1 ] || enabled=0
	backend="$(cat "$RUNTIME_DIR/backend" 2>/dev/null)"
	effective="$(cat /var/run/c2000max-hnat-effective 2>/dev/null)"
	error="$(cat "$ERROR_FILE" 2>/dev/null)"
	upload_profiles="$(sed -n 's/^upload=//p' "$RUNTIME_DIR/profiles" 2>/dev/null)"
	download_profiles="$(sed -n 's/^download=//p' "$RUNTIME_DIR/profiles" 2>/dev/null)"
	case "$upload_profiles" in ''|*[!0-9]*) upload_profiles=0 ;; esac
	case "$download_profiles" in ''|*[!0-9]*) download_profiles=0 ;; esac

	if [ "$enabled" = 1 ]; then
		case "$backend" in
			hnat)
				qos_state="$(cat /sys/kernel/debug/hnat/qos_toggle 2>/dev/null)"
				if [ "$effective" = mediatek_hnat ] &&
				   [ "$(cat /sys/kernel/debug/hnat/hook_toggle 2>/dev/null)" = enabled ] &&
				   printf '%s' "$qos_state" | grep -Fq 'mode=hqos uplink=enabled downlink=enabled' &&
				   nft list table inet eqos >/dev/null 2>&1; then
					active=1
				else
					reason="HNAT HQoS 运行态校验失败"
				fi
				;;
			hybrid)
				qos_state="$(cat /sys/kernel/debug/hnat/qos_toggle 2>/dev/null)"
				if [ "$effective" = mediatek_hnat ] &&
				   [ "$(cat /sys/kernel/debug/hnat/hook_toggle 2>/dev/null)" = enabled ] &&
				   printf '%s\n' "$qos_state" | grep -Fq 'mode=disabled' &&
				   tc qdisc show dev br-lan 2>/dev/null | grep -q 'qdisc htb 1:' &&
				   tc qdisc show dev br-lan 2>/dev/null | grep -q 'qdisc ingress ffff:' &&
				   nft list table inet eqos >/dev/null 2>&1; then
					active=1
				else
					reason="HNAT 选择性 tc 限速运行态校验失败"
				fi
				;;
			software)
				if tc qdisc show dev br-lan 2>/dev/null | grep -q 'qdisc htb 1:' &&
				   tc qdisc show dev br-lan 2>/dev/null | grep -q 'qdisc ingress ffff:' &&
				   nft list table inet eqos >/dev/null 2>&1; then
					active=1
				else
					reason="tc HTB/Police 运行态校验失败"
				fi
				;;
			*) reason="配置已启用，但没有已应用的限速后端" ;;
		esac
	fi
	if [ -z "$error" ] && [ -n "$reason" ]; then
		diagnostic="$(/usr/sbin/eqos diagnose "$effective" "$backend" 2>&1)"
		error="${diagnostic:-$reason}"
	fi

	. /usr/share/libubox/jshn.sh
	json_init
	json_add_boolean enabled "$enabled"
	json_add_boolean active "$active"
	json_add_string acceleration "${effective:-unknown}"
	json_add_string backend "${backend:-inactive}"
	json_add_int upload_profiles "$upload_profiles"
	json_add_int download_profiles "$download_profiles"
	json_add_string error "$error"
	json_dump
}

apply_config()
{
	local tmp

	mkdir -p "$RUNTIME_DIR" || exit 1
	tmp="$RUNTIME_DIR/apply.$$"
	if /etc/init.d/eqos reload >"$tmp" 2>&1; then
		rm -f "$ERROR_FILE" "$tmp"
	else
		[ -s "$tmp" ] || echo "EQoS reload failed without command output; check logread -e eqos" >"$tmp"
		mv "$tmp" "$ERROR_FILE"
	fi
	status_json
}

case "$1" in
	list)
		printf '%s\n' '{"status":{},"apply":{}}'
		;;
	call)
		read -r input
		case "$2" in
			status) status_json ;;
			apply) apply_config ;;
		esac
		;;
esac
