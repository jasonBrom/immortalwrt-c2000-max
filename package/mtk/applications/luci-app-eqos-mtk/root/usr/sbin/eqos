#!/bin/sh

. /lib/functions.sh
. /lib/functions/system.sh

DEV_DEFAULT="${EQOS_LAN_DEV:-br-lan}"
IFB_DEV="${EQOS_IFB_DEV:-ifb-eqos}"
HNAT_DIR="${EQOS_HNAT_DIR:-/sys/kernel/debug/hnat}"
NFT="${EQOS_NFT:-/usr/sbin/nft}"
RUNTIME_DIR="${EQOS_RUNTIME_DIR:-/var/run/eqos}"
BACKEND_FILE="$RUNTIME_DIR/backend"
SELECTORS_FILE="$RUNTIME_DIR/selectors"
HNAT_READY_WAIT="${EQOS_HNAT_READY_WAIT:-5}"

TABLE_FAMILY="inet"
TABLE_NAME="eqos"
CHAIN_NAME="forward"
MARK_CLEAR_MASK="0xffff0000"
FLOW_BYPASS_MARK="0x00800000"

QDMA_QUEUE_COUNT=64
QDMA_RATE_MAX=1000000
TOTAL_RATE_MAX=1000
UP_SCH=2
DL_SCH=3
UP_QID_BASE=1
DL_QID_BASE=32
HNAT_PROFILE_MAX=31
RULE_ID_MAX=4094
PPD_QID=63
MANAGED_QID_LAST=62
DEFAULT_QUEUE_CFG="0 0 0 0 0 0 4"

die() {
	echo "eqos: $*" >&2
	exit 1
}

require_c2000_accel_locks() {
	[ "$(board_name)" != "nradio,c2000-max" ] ||
		[ "${C2000MAX_ACCEL_LOCKS_HELD:-0}" = "1" ] ||
		die "C2000-MAX EQoS must be changed through /etc/init.d/eqos"
}

is_uinteger() {
	case "$1" in
		''|*[!0-9]*|0[0-9]*) return 1 ;;
	esac

	return 0
}

valid_ipv4() {
	[ -n "$1" ] || return 1

	case "$1" in
		*[!0-9./]*) return 1 ;;
	esac

	return 0
}

valid_ipv6() {
	[ -n "$1" ] || return 1
	# A MAC address also consists only of hexadecimal digits and colons.  Keep
	# it out of the IPv6 path even when this validator is called directly.
	valid_mac "$1" && return 1

	case "$1" in
		*[!0-9A-Fa-f:./]*) return 1 ;;
	esac

	return 0
}

valid_mac() {
	case "$1" in
		[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]) return 0 ;;
	esac
	return 1
}

need_nft() {
	[ -x "$NFT" ] || die "nftables is not available"
}

need_hnat() {
	[ -d "$HNAT_DIR" ] || insmod mtkhnat 2>/dev/null
	[ -d "$HNAT_DIR" ] || die "HNAT debugfs is not available"
}

write_hnat() {
	local node="$1"
	local value="$2"

	# access(W_OK) is not reliable for debugfs files whose vendor mode is 0444
	# even though their file_operations implement write and root can open them.
	# Check presence here and let the real write report the authoritative error.
	[ -e "$HNAT_DIR/$node" ] || die "$HNAT_DIR/$node is missing"
	printf '%s' "$value" > "$HNAT_DIR/$node" ||
		die "failed to write $HNAT_DIR/$node"
}

need_qdma_layout() {
	need_hnat

	for node in qdma_sch$UP_SCH qdma_sch$DL_SCH \
		qdma_txq$UP_QID_BASE qdma_txq$DL_QID_BASE qdma_txq$MANAGED_QID_LAST; do
		[ -e "$HNAT_DIR/$node" ] || die "$HNAT_DIR/$node is missing"
	done

	[ -e "$HNAT_DIR/qdma_txq0" ] ||
		die "qid0 is missing; expected $QDMA_QUEUE_COUNT-QDMA NETSYS layout"
	[ -e "$HNAT_DIR/qdma_txq$PPD_QID" ] ||
		die "qid$PPD_QID is missing; expected PPD-reserved queue"
}

wait_qdma_layout() {
	local waited=0 ready node

	case "$HNAT_READY_WAIT" in
		''|*[!0-9]*) HNAT_READY_WAIT=5 ;;
	esac
	while [ "$waited" -lt "$HNAT_READY_WAIT" ]; do
		ready=1
		[ -d "$HNAT_DIR" ] || ready=0
		for node in qos_toggle hnat_entry qdma_sch$UP_SCH qdma_sch$DL_SCH \
			qdma_txq0 qdma_txq$UP_QID_BASE qdma_txq$DL_QID_BASE \
			qdma_txq$MANAGED_QID_LAST qdma_txq$PPD_QID; do
			[ -e "$HNAT_DIR/$node" ] || ready=0
		done
		[ "$ready" -eq 0 ] || return 0
		sleep 1
		waited=$((waited + 1))
	done

	need_qdma_layout
	[ -e "$HNAT_DIR/qos_toggle" ] || die "$HNAT_DIR/qos_toggle is missing"
	[ -e "$HNAT_DIR/hnat_entry" ] || die "$HNAT_DIR/hnat_entry is missing"
}

stop_qos() {
	local dev="$1"
	local have_ifb=0

	[ ! -d "/sys/class/net/$IFB_DEV" ] || have_ifb=1

	if tc qdisc show dev "$dev" 2>/dev/null | grep -q "qdisc htb 1:"; then
		tc qdisc del dev "$dev" root 2>/dev/null
	fi
	if tc qdisc show dev "$dev" 2>/dev/null | grep -q "qdisc ingress ffff:"; then
		tc qdisc del dev "$dev" ingress 2>/dev/null
	fi
	if [ "$have_ifb" -eq 1 ]; then
		tc qdisc del dev "$IFB_DEV" root 2>/dev/null
		ip link del dev "$IFB_DEV" 2>/dev/null
	fi
}

start_qos() {
	local dev="$1"
	local dl="$2"
	local up="$3"
	local root_qdisc

	root_qdisc="$(tc qdisc show dev "$dev" 2>/dev/null | sed -n '/ root /p')"
	case "$root_qdisc" in
		''|qdisc\ noqueue\ 0:*|qdisc\ noop\ 0:*) ;;
		*)
			echo "eqos: $dev already has a root qdisc" >&2
			return 1
			;;
	esac

	if tc qdisc show dev "$dev" 2>/dev/null |
	   grep -Eq 'qdisc (ingress|clsact) '; then
		echo "eqos: $dev already has an ingress qdisc" >&2
		return 1
	fi

	if ! tc qdisc add dev "$dev" root handle 1: htb ||
	   ! tc class add dev "$dev" parent 1: classid 1:1 htb rate "${dl}mbit" ||
	   ! tc qdisc add dev "$dev" ingress; then
		stop_qos "$dev"
		return 1
	fi
}

nft_stop() {
	need_nft
	"$NFT" delete table "$TABLE_FAMILY" "$TABLE_NAME" 2>/dev/null
}

nft_start() {
	local dev="$1"
	local backend="$2"

	need_nft
	nft_stop

	"$NFT" -f - <<EOF || return 1
table $TABLE_FAMILY $TABLE_NAME {
	chain $CHAIN_NAME {
		type filter hook forward priority mangle; policy accept;
	}
}
EOF

	if [ "$backend" = hnat ]; then
		"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
			iifname "$dev" meta mark '&' "$FLOW_BYPASS_MARK" '==' 0 \
			meta mark set meta mark '&' "$MARK_CLEAR_MASK" || return 1
		"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
			oifname "$dev" meta mark '&' "$FLOW_BYPASS_MARK" '==' 0 \
			meta mark set meta mark '&' "$MARK_CLEAR_MASK" || return 1
	fi
}

reset_hnat_qdma() {
	local i

	need_qdma_layout
	write_hnat "qdma_sch$UP_SCH" "0 wrr 0"
	write_hnat "qdma_sch$DL_SCH" "0 wrr 0"

	i=$UP_QID_BASE
	while [ "$i" -le "$MANAGED_QID_LAST" ]; do
		write_hnat "qdma_txq$i" "$DEFAULT_QUEUE_CFG"
		i=$((i + 1))
	done
}

flush_hnat_entries() {
	local command

	[ -e "$HNAT_DIR/hnat_entry" ] || return 0
	for command in 3 5 7; do
		write_hnat "hnat_entry" "$command -1"
	done
}

start_hnat_qos() {
	local dl="$1"
	local up="$2"
	local direction="${3:-both}"
	local qos_state up_state dl_state expected

	wait_qdma_layout
	# Keep HQoS disabled until every scheduler and queue has a complete,
	# internally consistent configuration. Enabling it last also repairs a
	# stale disabled toggle left by an interrupted earlier transaction.
	reset_hnat_qdma
	case "$direction" in
		downlink)
			# External USB/5G uploads use the PPD path. Enabling uplink
			# HQoS there can collapse throughput for the whole LAN.
			write_hnat "qdma_sch$DL_SCH" "1 wrr $((dl * 1000))"
			write_hnat "qos_toggle" "1 downlink"
			expected='mode=hqos uplink=disabled downlink=enabled'
			;;
		both)
			write_hnat "qdma_sch$UP_SCH" "1 wrr $((up * 1000))"
			write_hnat "qdma_sch$DL_SCH" "1 wrr $((dl * 1000))"
			write_hnat "qos_toggle" "1"
			expected='mode=hqos uplink=enabled downlink=enabled'
			;;
		*) die "invalid HNAT HQoS direction: $direction" ;;
	esac

	qos_state="$(cat "$HNAT_DIR/qos_toggle" 2>/dev/null)"
	printf '%s\n' "$qos_state" | grep -Fq "$expected" ||
		die "HNAT rejected HQoS mode: ${qos_state:-unreadable}"
	up_state="$(cat "$HNAT_DIR/qdma_sch$UP_SCH" 2>/dev/null)"
	dl_state="$(cat "$HNAT_DIR/qdma_sch$DL_SCH" 2>/dev/null)"
	if [ "$direction" = both ]; then
		printf '%s\n' "$up_state" | grep -Eq '^1[[:space:]]+WRR' ||
			die "QDMA upload scheduler $UP_SCH did not enable"
	else
		printf '%s\n' "$up_state" | grep -Eq '^0[[:space:]]+WRR' ||
			die "QDMA upload scheduler $UP_SCH did not stay disabled"
	fi
	printf '%s\n' "$dl_state" | grep -Eq '^1[[:space:]]+WRR' ||
		die "QDMA download scheduler $DL_SCH did not enable"
}

stop_hnat_qos() {
	[ -d "$HNAT_DIR" ] || return 0
	[ -e "$HNAT_DIR/qos_toggle" ] || return 0

	need_qdma_layout
	write_hnat "qos_toggle" "0"
	reset_hnat_qdma
	# Bound FOE entries retain their old fqos/QID fields. Invalidate them now
	# so disabling a bad HQoS setup restores normal forwarding immediately.
	flush_hnat_entries
}

queue_from_profile() {
	local profile="$1"
	local dir="$2"

	case "$dir" in
		up) echo $((UP_QID_BASE + profile - 1)) ;;
		dl) echo $((DL_QID_BASE + profile - 1)) ;;
	esac
}

tc_classid_from_rule() {
	# classid 1:1 belongs to the aggregate parent. Keep every device in a
	# distinct child class even when its persistent rule ID starts at one.
	printf '%x\n' "$((1 + $1))"
}

ensure_tc_qos() {
	local dev="$1"
	local dl="$2"
	local up="$3"

	[ -n "$dl" ] || dl="$(uci -q get eqos.config.download)"
	[ -n "$up" ] || up="$(uci -q get eqos.config.upload)"
	is_uinteger "$dl" || die "download rate must be an integer"
	is_uinteger "$up" || die "upload rate must be an integer"
	[ "$dl" -gt 0 ] || die "download rate must be greater than 0"
	[ "$up" -gt 0 ] || die "upload rate must be greater than 0"
	[ "$dl" -le "$TOTAL_RATE_MAX" ] && [ "$up" -le "$TOTAL_RATE_MAX" ] ||
		die "total rate must not exceed $TOTAL_RATE_MAX Mbit/s"

	if tc qdisc show dev "$dev" 2>/dev/null | grep -q "qdisc htb 1:" &&
	   tc qdisc show dev "$dev" 2>/dev/null | grep -q "qdisc ingress ffff:"; then
		return 0
	fi

	stop_qos "$dev"
	start_qos "$dev" "$dl" "$up"
}

remember_selector() {
	local family="$1" value="$2"

	[ -n "$value" ] || return 0
	mkdir -p "$RUNTIME_DIR" || return 1
	touch "$SELECTORS_FILE" || return 1
	grep -Fqx "$family	$value" "$SELECTORS_FILE" 2>/dev/null ||
		printf '%s\t%s\n' "$family" "$value" >> "$SELECTORS_FILE"
}

flush_limited_conntrack() {
	local family value

	[ -s "$SELECTORS_FILE" ] || return 0
	command -v conntrack >/dev/null 2>&1 || return 0
	while IFS="$(printf '\t')" read -r family value; do
		[ -n "$value" ] || continue
		case "$family" in
			ip)
				conntrack -D -f ipv4 -s "$value" >/dev/null 2>&1 || true
				conntrack -D -f ipv4 -d "$value" >/dev/null 2>&1 || true
				;;
			ip6)
				conntrack -D -f ipv6 -s "$value" >/dev/null 2>&1 || true
				conntrack -D -f ipv6 -d "$value" >/dev/null 2>&1 || true
				;;
		esac
	done < "$SELECTORS_FILE"
}

program_queue() {
	local qid="$1"
	local sch="$2"
	local rate="$3"

	[ "$rate" -eq 0 ] && return 0
	write_hnat "qdma_txq$qid" "$sch 0 0 1 $rate 4 1"
}

tc_filter_rule() {
	local dir="$1"
	local family="$2"
	local value="$3"
	local pref="$4"
	local classid="$5"
	local dev="$6"
	local tcdev key

	[ -n "$value" ] || return 0

	case "$dir" in
		up)
			tcdev="$dev"
			key="src"
			;;
		dl)
			tcdev="$dev"
			key="dst"
			;;
		*)
			return 1
			;;
	esac

	case "$family" in
		ip)
			tc filter add dev "$tcdev" parent 1: protocol ip pref "$pref" u32 \
				match ip "$key" "$value" flowid "1:$classid"
			;;
		ip6)
			tc filter add dev "$tcdev" parent 1: protocol ipv6 pref "$pref" u32 \
				match ip6 "$key" "$value" flowid "1:$classid"
			;;
		mac)
			tc filter add dev "$tcdev" parent 1: protocol all pref "$pref" flower \
				"${key}_mac" "$value" classid "1:$classid"
			;;
		*)
			return 1
			;;
	esac
}

tc_police_rule() {
	local family="$1"
	local value="$2"
	local pref="$3"
	local dev="$4"
	local rate="$5"
	local burst_kb

	[ -n "$value" ] || return 0
	[ "$rate" -ne 0 ] || return 0

	# A 100 ms token bucket is large enough for TCP/GRO bursts without the
	# IFB redirect which changes the apparent LAN ingress device. Cap the
	# bucket so high-rate rules do not create multi-megabyte bursts.
	burst_kb=$((rate / 80))
	[ "$burst_kb" -ge 64 ] || burst_kb=64
	[ "$burst_kb" -le 2048 ] || burst_kb=2048

	case "$family" in
		ip)
			tc filter add dev "$dev" parent ffff: protocol ip pref "$pref" u32 \
				match ip src "$value" \
				action police rate "${rate}kbit" burst "${burst_kb}k" \
				mtu 64kb conform-exceed drop
			;;
		ip6)
			tc filter add dev "$dev" parent ffff: protocol ipv6 pref "$pref" u32 \
				match ip6 src "$value" \
				action police rate "${rate}kbit" burst "${burst_kb}k" \
				mtu 64kb conform-exceed drop
			;;
		mac)
			tc filter add dev "$dev" parent ffff: protocol all pref "$pref" flower \
				src_mac "$value" \
				action police rate "${rate}kbit" burst "${burst_kb}k" \
				mtu 64kb conform-exceed drop
			;;
		*)
			return 1
			;;
	esac
}

program_tc_queue() {
	local dir="$1"
	local rule_id="$2"
	local rate="$3"
	local ip4="$4"
	local ip6="$5"
	local mac="$6"
	local dev="$7"
	local classid

	[ "$rate" -eq 0 ] && return 0
	[ -n "$ip4$ip6$mac" ] ||
		die "software tc queue requires an IPv4, IPv6 or MAC selector"

	classid="$(tc_classid_from_rule "$rule_id")"
	case "$dir" in
		up)
			# Police at the original br-lan ingress hook. Redirecting a bridge
			# master packet to IFB changes its firewall ingress context and can
			# make mwan3/multi-WAN drop every packet from the limited device.
			tc_police_rule ip "$ip4" "$rule_id" "$dev" "$rate" || return 1
			tc_police_rule ip6 "$ip6" "$rule_id" "$dev" "$rate" || return 1
			tc_police_rule mac "$mac" "$rule_id" "$dev" "$rate" || return 1
			;;
		dl)
			tc class replace dev "$dev" parent 1:1 classid "1:$classid" \
				htb rate "${rate}kbit" ceil "${rate}kbit" || return 1
			tc_filter_rule dl ip "$ip4" "$rule_id" "$classid" "$dev" || return 1
			tc_filter_rule dl ip6 "$ip6" "$rule_id" "$classid" "$dev" || return 1
			tc_filter_rule dl mac "$mac" "$rule_id" "$classid" "$dev" || return 1
			;;
		*) return 1 ;;
	esac
}

nft_mark_rule() {
	local dir="$1"
	local family="$2"
	local value="$3"
	local qid="$4"
	local addr

	[ -n "$value" ] || return 0

	case "$dir" in
		up) addr="saddr" ;;
		dl) addr="daddr" ;;
		*)
			return 1
			;;
	esac

	case "$family" in
		ip)
			"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				ip "$addr" "$value" \
				meta mark '&' "$FLOW_BYPASS_MARK" '==' 0 \
				counter \
				meta mark set meta mark '|' "$qid"
			;;
		ip6)
			"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				ip6 "$addr" "$value" \
				meta mark '&' "$FLOW_BYPASS_MARK" '==' 0 \
				counter \
				meta mark set meta mark '|' "$qid"
			;;
		mac)
			"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				ether "$addr" "$value" \
				meta mark '&' "$FLOW_BYPASS_MARK" '==' 0 \
				counter \
				meta mark set meta mark '|' "$qid"
			;;
		*)
			return 1
			;;
	esac
}

nft_exception_rule() {
	local dir="$1"
	local family="$2"
	local value="$3"
	local addr

	[ -n "$value" ] || return 0

	case "$dir" in
		up) addr="saddr" ;;
		dl) addr="daddr" ;;
		*)
			return 1
			;;
	esac

	case "$family" in
		ip)
			"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				ip "$addr" "$value" \
				meta mark set meta mark '|' "$FLOW_BYPASS_MARK"
			;;
		ip6)
			"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				ip6 "$addr" "$value" \
				meta mark set meta mark '|' "$FLOW_BYPASS_MARK"
			;;
		mac)
			"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				ether "$addr" "$value" \
				meta mark set meta mark '|' "$FLOW_BYPASS_MARK"
			;;
		*)
			return 1
			;;
	esac
}

add_rule() {
	local backend="$1"
	local rule_id="$2"
	local dl="$3"
	local up="$4"
	local ip4="$5"
	local ip6="$6"
	local mac="$7"
	local total_dl="$8"
	local total_up="$9"
	local up_profile="${10:-}"
	local dl_profile="${11:-}"
	local dev="$DEV_DEFAULT"
	local up_qid dl_qid selector_count

	is_uinteger "$rule_id" || die "rule ID must be an integer"
	is_uinteger "$dl" || die "download rate must be an integer"
	is_uinteger "$up" || die "upload rate must be an integer"

	[ "$rule_id" -ge 1 ] && [ "$rule_id" -le "$RULE_ID_MAX" ] ||
		die "rule ID must be between 1 and $RULE_ID_MAX"
	# The persistent rule ID is only a tc class/filter identifier. HNAT
	# profiles are allocated independently by the service and may be shared by
	# every rule with the same rate.  Keep the old direct CLI form compatible.
	if [ -z "$up_profile$dl_profile" ]; then
		if [ "$rule_id" -le "$HNAT_PROFILE_MAX" ]; then
			up_profile="$rule_id"
			dl_profile="$rule_id"
		else
			up_profile=0
			dl_profile=0
		fi
	fi
	is_uinteger "$up_profile" && is_uinteger "$dl_profile" ||
		die "HNAT rate profiles must be integers"
	[ "$up_profile" -ge 0 ] && [ "$up_profile" -le "$HNAT_PROFILE_MAX" ] &&
		[ "$dl_profile" -ge 0 ] && [ "$dl_profile" -le "$HNAT_PROFILE_MAX" ] ||
		die "HNAT rate profiles must be between 0 and $HNAT_PROFILE_MAX"
	[ "$dl" -le "$QDMA_RATE_MAX" ] && [ "$up" -le "$QDMA_RATE_MAX" ] ||
		die "device rate must not exceed $QDMA_RATE_MAX kbit/s"
	[ -n "$ip4" ] && valid_ipv4 "$ip4" || [ -z "$ip4" ] ||
		die "invalid IPv4 selector"
	[ -n "$ip6" ] && valid_ipv6 "$ip6" || [ -z "$ip6" ] ||
		die "invalid IPv6 selector"
	[ -n "$mac" ] && valid_mac "$mac" || [ -z "$mac" ] ||
		die "invalid MAC selector"

	selector_count=0
	[ -z "$ip4" ] || selector_count=$((selector_count + 1))
	[ -z "$ip6" ] || selector_count=$((selector_count + 1))
	[ -z "$mac" ] || selector_count=$((selector_count + 1))
	[ "$selector_count" -eq 1 ] ||
		die "exactly one selector is required: IPv4, IPv6 or MAC"

	[ "$dl" -ne 0 ] || [ "$up" -ne 0 ] || return 0
	remember_selector ip "$ip4" || return 1
	remember_selector ip6 "$ip6" || return 1
	remember_selector mac "$mac" || return 1

	case "$backend" in
		hnat|hybrid|software) ;;
		*) die "invalid EQoS backend: $backend" ;;
	esac

	if [ "$backend" = software ]; then
		ensure_tc_qos "$dev" "$total_dl" "$total_up" || return 1
		program_tc_queue up "$rule_id" "$up" "$ip4" "$ip6" "$mac" "$dev" || return 1
		program_tc_queue dl "$rule_id" "$dl" "$ip4" "$ip6" "$mac" "$dev" || return 1
		# Flowtable forwarding bypasses tc. Tag both directions of every
		# limited connection so firewall4 keeps only those flows on the regular
		# forwarding path; mwan3's conntrack mark remains untouched.
		nft_exception_rule up ip "$ip4" || return 1
		nft_exception_rule up ip6 "$ip6" || return 1
		nft_exception_rule up mac "$mac" || return 1
		nft_exception_rule dl ip "$ip4" || return 1
		nft_exception_rule dl ip6 "$ip6" || return 1
		nft_exception_rule dl mac "$mac" || return 1
		return 0
	fi
	if [ "$backend" = hybrid ]; then
		need_nft
		# External 5G/USB traverses the PPD-reserved queue. Bypass PPE and
		# flowtable only for this rule and shape both directions with tc;
		# unrelated flows remain eligible for HNAT.
		ensure_tc_qos "$dev" "$total_dl" "$total_up" || return 1
		program_tc_queue up "$rule_id" "$up" "$ip4" "$ip6" "$mac" "$dev" || return 1
		program_tc_queue dl "$rule_id" "$dl" "$ip4" "$ip6" "$mac" "$dev" || return 1
		nft_exception_rule up ip "$ip4" || return 1
		nft_exception_rule up ip6 "$ip6" || return 1
		nft_exception_rule up mac "$mac" || return 1
		nft_exception_rule dl ip "$ip4" || return 1
		nft_exception_rule dl ip6 "$ip6" || return 1
		nft_exception_rule dl mac "$mac" || return 1
		return 0
	fi

	need_nft
	need_qdma_layout

	# Profile 0 means that this rule could not be represented by the 31
	# hardware rate profiles in at least one active direction.  Keep the whole
	# bidirectional flow on tc so the other direction cannot bind an HNAT entry
	# first and accidentally bypass the software half of the rule.
	if { [ "$up" -ne 0 ] && [ "$up_profile" -eq 0 ]; } ||
	   { [ "$dl" -ne 0 ] && [ "$dl_profile" -eq 0 ]; }; then
		ensure_tc_qos "$dev" "$total_dl" "$total_up" || return 1
		program_tc_queue up "$rule_id" "$up" "$ip4" "$ip6" "$mac" "$dev" || return 1
		program_tc_queue dl "$rule_id" "$dl" "$ip4" "$ip6" "$mac" "$dev" || return 1

		nft_exception_rule up ip "$ip4" || return 1
		nft_exception_rule up ip6 "$ip6" || return 1
		nft_exception_rule up mac "$mac" || return 1
		nft_exception_rule dl ip "$ip4" || return 1
		nft_exception_rule dl ip6 "$ip6" || return 1
		nft_exception_rule dl mac "$mac" || return 1

		return 0
	fi

	up_qid="$(queue_from_profile "$up_profile" up)"
	dl_qid="$(queue_from_profile "$dl_profile" dl)"

	program_queue "$up_qid" "$UP_SCH" "$up" || return 1
	program_queue "$dl_qid" "$DL_SCH" "$dl" || return 1

	if [ "$up" -ne 0 ]; then
		nft_mark_rule up ip "$ip4" "$up_qid" || return 1
		nft_mark_rule up ip6 "$ip6" "$up_qid" || return 1
		nft_mark_rule up mac "$mac" "$up_qid" || return 1
	fi

	if [ "$dl" -ne 0 ]; then
		nft_mark_rule dl ip "$ip4" "$dl_qid" || return 1
		nft_mark_rule dl ip6 "$ip6" "$dl_qid" || return 1
		nft_mark_rule dl mac "$mac" "$dl_qid" || return 1
	fi

}

add_inferred_rule() {
	local backend="$1"
	local rule_id="$2"
	local dl="$3"
	local up="$4"
	local selector="$5"
	local total_dl="$6"
	local total_up="$7"
	local up_profile="${8:-}"
	local dl_profile="${9:-}"
	local ip4="" ip6="" mac=""

	[ -n "$selector" ] || die "selector is required"

	# Test the fixed-width MAC form first.  The old order let addresses such as
	# 1a:3d:8c:86:20:56 pass the permissive IPv6 character check, causing nft
	# to parse the MAC as an IPv6 hostname and abort the whole EQoS transaction.
	if valid_mac "$selector"; then
		mac="$(printf '%s' "$selector" | tr 'A-F' 'a-f')"
	elif valid_ipv4 "$selector"; then
		ip4="$selector"
	elif valid_ipv6 "$selector"; then
		ip6="$selector"
	else
		die "selector must be an IPv4, IPv6 or MAC address"
	fi

	add_rule "$backend" "$rule_id" "$dl" "$up" "$ip4" "$ip6" "$mac" \
		"$total_dl" "$total_up" "$up_profile" "$dl_profile"
}

add_download_alias() {
	local backend="$1"
	local rate="$2"
	local selector="$3"
	local dl_profile="${4:-0}"
	local family qid

	case "$backend" in
		hnat|hybrid|software) ;;
		*) die "invalid EQoS backend: $backend" ;;
	esac
	is_uinteger "$rate" || die "download alias rate must be an integer"
	[ "$rate" -gt 0 ] || return 0
	if valid_ipv4 "$selector"; then
		family=ip
	elif valid_ipv6 "$selector"; then
		family=ip6
	else
		die "download alias must be an IPv4 or IPv6 address"
	fi

	case "$backend" in
		hnat)
			is_uinteger "$dl_profile" &&
				[ "$dl_profile" -ge 1 ] && [ "$dl_profile" -le "$HNAT_PROFILE_MAX" ] ||
				die "HNAT download alias requires a hardware rate profile"
			qid="$(queue_from_profile "$dl_profile" dl)"
			nft_mark_rule dl "$family" "$selector" "$qid"
			;;
		hybrid|software)
			# A routed packet's Ethernet destination in the inet forward hook is
			# not reliably the LAN client's MAC yet. Add its resolved L3 address
			# solely to the acceleration-bypass rule; the existing dst_mac tc
			# classifier still owns the per-device download class.
			nft_exception_rule dl "$family" "$selector"
			;;
	esac
}

activate_backend() {
	local backend="$1"

	case "$backend" in
		hnat)
			# Existing FOE entries were bound before the new per-device marks
			# existed. Invalidate every PPE cache without toggling or changing
			# the user's selected acceleration mode; the next packets rebind with
			# the HQoS queue or software-fallback bypass bit.
			[ -e "$HNAT_DIR/hnat_entry" ] ||
				die "$HNAT_DIR/hnat_entry is missing"
			flush_hnat_entries
			;;
		hybrid)
			# Both directions of limited clients carry HNAT_EXCEPTION_TAG and
			# stay on tc/IFB; unrelated flows can rebind to PPE.
			[ -e "$HNAT_DIR/hnat_entry" ] ||
				die "$HNAT_DIR/hnat_entry is missing"
			flush_hnat_entries
			"$NFT" flush flowtable inet fw4 ft 2>/dev/null || true
			;;
		software)
			# Drop only cached flowtable entries. Conntrack/NAT state remains and
			# unmarked traffic becomes offload-eligible again immediately.
			"$NFT" flush flowtable inet fw4 ft 2>/dev/null || true
			;;
		*) die "invalid EQoS backend: $backend" ;;
	esac
}

diagnose_runtime() {
	local acceleration="$1" backend="${2:-}" node hook qos

	[ -d "/sys/class/net/$DEV_DEFAULT" ] || {
		echo "LAN device $DEV_DEFAULT is not ready"
		return 1
	}
	[ -x "$NFT" ] || {
		echo "nftables is not installed"
		return 1
	}

	if [ "$backend" = hybrid ]; then
		[ "$acceleration" = mediatek_hnat ] || {
			echo "hybrid limiter requires MediaTek HNAT"
			return 1
		}
		[ "$(cat "$HNAT_DIR/hook_toggle" 2>/dev/null)" = enabled ] || {
			echo "HNAT hook is not enabled"
			return 1
		}
		qos="$(cat "$HNAT_DIR/qos_toggle" 2>/dev/null)"
		printf '%s\n' "$qos" | grep -Fq 'mode=disabled' || {
			echo "external-uplink HQoS did not stay disabled: ${qos:-unreadable}"
			return 1
		}
		command -v tc >/dev/null 2>&1 || {
			echo "tc is not installed"
			return 1
		}
		tc qdisc show dev "$DEV_DEFAULT" 2>/dev/null | grep -q 'qdisc htb 1:' || {
			echo "selective download tc is not active"
			return 1
		}
		tc qdisc show dev "$DEV_DEFAULT" 2>/dev/null | grep -q 'qdisc ingress ffff:' || {
			echo "selective upload police is not active"
			return 1
		}
	elif [ "$acceleration" = mediatek_hnat ]; then
		[ -d "$HNAT_DIR" ] || {
			echo "HNAT debugfs is not ready"
			return 1
		}
		for node in hook_toggle qos_toggle hnat_entry \
			qdma_sch$UP_SCH qdma_sch$DL_SCH qdma_txq0 \
			qdma_txq$UP_QID_BASE qdma_txq$DL_QID_BASE \
			qdma_txq$MANAGED_QID_LAST qdma_txq$PPD_QID; do
			[ -e "$HNAT_DIR/$node" ] || {
				echo "HNAT HQoS node is missing: $HNAT_DIR/$node"
				return 1
			}
		done
		hook="$(cat "$HNAT_DIR/hook_toggle" 2>/dev/null)"
		[ "$hook" = enabled ] || {
			echo "HNAT hook is not enabled: ${hook:-unreadable}"
			return 1
		}
		qos="$(cat "$HNAT_DIR/qos_toggle" 2>/dev/null)"
		printf '%s\n' "$qos" |
			grep -Fq 'mode=hqos uplink=enabled downlink=enabled' || {
			echo "HNAT HQoS is not enabled: ${qos:-unreadable}"
			return 1
		}
	else
		command -v tc >/dev/null 2>&1 || {
			echo "tc is not installed"
			return 1
		}
		command -v ip >/dev/null 2>&1 || {
			echo "ip-full is not installed"
			return 1
		}
		tc qdisc show dev "$DEV_DEFAULT" 2>/dev/null | grep -q 'qdisc htb 1:' || {
			echo "download HTB is not active"
			return 1
		}
		tc qdisc show dev "$DEV_DEFAULT" 2>/dev/null | grep -q 'qdisc ingress ffff:' || {
			echo "upload police is not active"
			return 1
		}
	fi

	echo "EQoS did not finish applying; run /etc/init.d/eqos reload for the exact error"
	return 1
}

start_all() {
	local backend="$1"
	local dl="$2"
	local up="$3"
	local dev="$DEV_DEFAULT"
	local tmp

	case "$backend" in
		hnat|hybrid|software) ;;
		*) die "backend must be hnat, hybrid or software" ;;
	esac

	is_uinteger "$dl" || die "download rate must be an integer"
	is_uinteger "$up" || die "upload rate must be an integer"
	[ "$dl" -gt 0 ] || die "download rate must be greater than 0"
	[ "$up" -gt 0 ] || die "upload rate must be greater than 0"
	[ "$dl" -le "$TOTAL_RATE_MAX" ] && [ "$up" -le "$TOTAL_RATE_MAX" ] ||
		die "total rate must not exceed $TOTAL_RATE_MAX Mbit/s"

	stop_qos "$dev"
	nft_stop
	stop_hnat_qos
	flush_limited_conntrack
	mkdir -p "$RUNTIME_DIR" || die "failed to create EQoS runtime directory"
	: > "$SELECTORS_FILE" || die "failed to initialize selector state"

	case "$backend" in
		hnat)
			need_qdma_layout
			start_hnat_qos "$dl" "$up"
			nft_start "$dev" hnat || die "failed to configure nftables"
			;;
		hybrid)
			# QDMA HQoS is unsafe on the external PPD topology. Limited
			# connections use selective tc/ingress policing while unrelated
			# traffic remains eligible for HNAT.
			nft_start "$dev" hnat || die "failed to configure nftables"
			start_qos "$dev" "$dl" "$up" ||
				die "failed to configure selective external-uplink shaping"
			;;
		software)
			nft_start "$dev" software || die "failed to configure nftables"
			start_qos "$dev" "$dl" "$up" ||
				die "failed to configure tc HTB/Police shaping"
			;;
	esac

	tmp="${BACKEND_FILE}.$$"
	printf '%s\n' "$backend" > "$tmp" && mv "$tmp" "$BACKEND_FILE" ||
		die "failed to publish EQoS backend"
}

stop_all() {
	local dev="$DEV_DEFAULT"

	stop_qos "$dev"
	nft_stop
	stop_hnat_qos
	flush_limited_conntrack
	rm -f "$BACKEND_FILE" "$SELECTORS_FILE"
}

usage() {
	cat <<EOF
Usage: $0 <command> [options]

Commands:
  start <hnat|hybrid|software> <download_mbit> <upload_mbit>
  add <hnat|hybrid|software> <rule_id> <download_kbit> <upload_kbit> <ipv4|ipv6|mac> [total_down_mbit] [total_up_mbit] [up_profile] [down_profile]
  download-alias <hnat|hybrid|software> <download_kbit> <ipv4|ipv6> [down_profile]
  activate <hnat|hybrid|software>
  diagnose <mediatek_hnat|flow_offloading|disabled> [backend]
  stop

In the HNAT backend, the persistent rule ID is independent of QDMA. Rules
with the same rate share one of 31 upload profiles (qid1-31) and one of 31
download profiles (qid32-62). qid0 remains the default queue and qid63 is
reserved for PPD. External cellular/USB uplinks use a selective hybrid:
only limited connections use download HTB and upload ingress policing, QDMA HQoS stays off,
and unrelated connections remain hardware accelerated. A shared QDMA profile is an
aggregate cap for all rules assigned to it. The software backend uses the same
download HTB/upload police path and excludes only limited connections from
firewall4 flow offload.
EOF
}

case "$1" in
	start)
		require_c2000_accel_locks
		shift
		start_all "$@"
		;;
	stop)
		require_c2000_accel_locks
		shift
		stop_all "$@"
		;;
	add)
		require_c2000_accel_locks
		shift
		add_inferred_rule "$@"
		;;
	download-alias)
		require_c2000_accel_locks
		shift
		add_download_alias "$@"
		;;
	activate)
		require_c2000_accel_locks
		shift
		activate_backend "$@"
		;;
	diagnose)
		shift
		diagnose_runtime "$@"
		;;
	*)
		usage
		exit 1
		;;
esac
