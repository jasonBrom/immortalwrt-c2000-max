#!/bin/sh

. /lib/functions.sh
. /lib/functions/system.sh

if [ "$(board_name)" = "nradio,c2000-max" ]; then
	case "$ACTION" in
		ifup|ifdown|update) ;;
		*) exit 0 ;;
	esac
	[ ! -e /var/run/c2000max-port-role.switching ] || exit 0
	if [ "$INTERFACE" = "lan" ] && [ "$ACTION" = "ifdown" ]; then
		/etc/init.d/eqos stop >/dev/null 2>&1
	fi
	# External/QModem routes commonly settle after br-lan on a soft boot.
	# Re-evaluate after every interface transition and after the later HNAT
	# hotplug handler. flock coalesces bursts into one delayed reload.
	(
		exec 9>/var/lock/c2000max-eqos-hotplug.lock
		flock -n 9 || exit 0
		sleep 4
		/etc/init.d/eqos reload >/dev/null 2>&1
	) &
	exit 0
fi

[ "$ACTION" = "ifup" ] || exit 0
[ "$INTERFACE" = "lan" ] || exit 0
/etc/init.d/eqos start
