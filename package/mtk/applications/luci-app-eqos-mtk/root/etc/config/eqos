config eqos 'config'
	option enabled      0
	option download     100
	option upload       20

# Per-device bandwidth is kbit/s.
# Under MediaTek HNAT, slots 1~31 use NETSYS V2/V3 64-QDMA HQoS and later
# slots fall back to tc. Under software flow offload or no acceleration, every
# slot is automatically implemented by tc/IFB. The UCI rules never change when
# the acceleration method changes.
# qid0 is the default queue and qid63 is reserved for PPD.
# Configure exactly one of ip, ip6 or mac. LuCI may also save selector.
