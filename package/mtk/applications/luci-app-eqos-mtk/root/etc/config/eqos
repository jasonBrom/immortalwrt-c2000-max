config eqos 'config'
	option enabled      0
	option download     -1
	option upload       -1

# Per-device bandwidth is kbit/s.
# The queue option is a stable rule ID, not a hardware QID. Under MediaTek
# HNAT, rules with the same rate share one of 31 upload and 31 download QDMA
# profiles. A shared profile caps the aggregate traffic of all rules using it.
# A rule that needs a 32nd distinct active rate falls back to tc. HNAT external
# cellular/USB uplinks use a hybrid mode: only limited connections bypass HNAT
# for download HTB and upload ingress policing while all others keep hardware
# acceleration. Software flow offload and normal forwarding use the same safe
# tc path. The UCI rules never change when the acceleration method changes.
# qid0 is the default queue and qid63 is reserved for PPD.
# Configure exactly one of ip, ip6 or mac. LuCI may also save selector.
#config device
#	option enabled  1
#	option queue    1
#	option selector 'ip'
#	option ip       '192.168.1.100'
#	option mac      'aa:bb:cc:dd:ee:ff'
#	option download 10000
#	option upload   5000
