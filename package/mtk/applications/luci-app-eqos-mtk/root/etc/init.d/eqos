#!/bin/sh /etc/rc.common
# Copyright (C) 2006 OpenWrt.org

. /lib/functions/system.sh

START=50
USE_PROCD=1

QDMA_RATE_MAX=1000000
TOTAL_RATE_MAX=1000
QUEUE_SLOT_MAX=4094
TOTAL_DOWNLOAD_KBIT=$QDMA_RATE_MAX
TOTAL_UPLOAD_KBIT=$QDMA_RATE_MAX
C2000_ROLE_LOCK="${C2000_ROLE_LOCK:-/var/lock/c2000max-port-role.lock}"
C2000_HNAT_LOCK="${C2000_HNAT_LOCK:-/var/lock/c2000max-hnat.lock}"
C2000_EQOS_ROLE_HELD=0
C2000_EQOS_HNAT_HELD=0

: >>"$C2000_ROLE_LOCK" || exit 1
: >>"$C2000_HNAT_LOCK" || exit 1
exec 4<>"$C2000_ROLE_LOCK" || exit 1
exec 5<>"$C2000_HNAT_LOCK" || exit 1

c2000_eqos_signal_abort() {
	trap '' HUP INT TERM
	# A limiter failure must never silently change the user's acceleration
	# choice. Clean up only EQoS-owned QDMA/tc/nft state before releasing locks.
	if [ "$C2000_EQOS_HNAT_HELD" = 1 ]; then
		eqos stop >/dev/null 2>&1 || true
		flock -u 5 >/dev/null 2>&1 || true
		C2000_EQOS_HNAT_HELD=0
	fi
	if [ "$C2000_EQOS_ROLE_HELD" = 1 ]; then
		flock -u 4 >/dev/null 2>&1 || true
		C2000_EQOS_ROLE_HELD=0
	fi
	exit 1
}

is_uinteger() {
	case "$1" in
		''|*[!0-9]*|0[0-9]*) return 1 ;;
	esac

	return 0
}

validate_device() {
	local cfg="$1"
	local enabled

	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	local ip ip6 queue selector selector_count selector_key
	local download upload
	config_get ip "$cfg" ip
	config_get ip6 "$cfg" ip6
	config_get download "$cfg" download 0
	config_get upload "$cfg" upload 0
	config_get queue "$cfg" queue
	config_get selector "$cfg" selector
	[ -n "$queue" ] || config_get queue "$cfg" comment

	if ! is_uinteger "$queue" || [ "$queue" -lt 1 ] || [ "$queue" -gt "$QUEUE_SLOT_MAX" ]; then
		echo "eqos: $cfg queue slot must be between 1 and $QUEUE_SLOT_MAX" >&2
		CONFIG_ERROR=1
		return 0
	fi

	case " $USED_QUEUES " in
		*" $queue "*)
			echo "eqos: queue slot $queue is used by more than one rule" >&2
			CONFIG_ERROR=1
			return 0
			;;
	esac
	USED_QUEUES="${USED_QUEUES}${queue} "

	if ! is_uinteger "$download" || ! is_uinteger "$upload"; then
		echo "eqos: $cfg download and upload rates must be integers" >&2
		CONFIG_ERROR=1
		return 0
	fi

	if [ "$download" -gt "$QDMA_RATE_MAX" ] || [ "$upload" -gt "$QDMA_RATE_MAX" ]; then
		echo "eqos: $cfg download and upload rates must not exceed $QDMA_RATE_MAX kbit/s" >&2
		CONFIG_ERROR=1
		return 0
	fi
	if [ "$download" -gt "$TOTAL_DOWNLOAD_KBIT" ] ||
	   [ "$upload" -gt "$TOTAL_UPLOAD_KBIT" ]; then
		echo "eqos: $cfg device rate must not exceed the configured total bandwidth" >&2
		CONFIG_ERROR=1
		return 0
	fi

	selector_count=0
	[ -z "$ip" ] || selector_count=$((selector_count + 1))
	[ -z "$ip6" ] || selector_count=$((selector_count + 1))

	if [ "$selector_count" -ne 1 ]; then
		echo "eqos: $cfg must set exactly one match field: ip or ip6" >&2
		CONFIG_ERROR=1
		return 0
	fi

	case "$selector" in
		''|ip|ip6) ;;
		*)
			echo "eqos: $cfg selector must be ip or ip6" >&2
			CONFIG_ERROR=1
			return 0
			;;
	esac

	case "$selector" in
		ip)
			if [ -z "$ip" ]; then
				echo "eqos: $cfg selector does not match configured field" >&2
				CONFIG_ERROR=1
				return 0
			fi
			;;
		ip6)
			if [ -z "$ip6" ]; then
				echo "eqos: $cfg selector does not match configured field" >&2
				CONFIG_ERROR=1
				return 0
			fi
			;;
	esac

	if [ -n "$ip" ]; then
		selector_key="ip:$ip"
	else
		selector_key="ip6:$ip6"
	fi

	case "$USED_SELECTORS" in
		*" $selector_key "*)
			echo "eqos: selector $selector_key is used by more than one rule" >&2
			CONFIG_ERROR=1
			return 0
			;;
	esac
	USED_SELECTORS="${USED_SELECTORS}${selector_key} "
}

parse_device() {
	local cfg="$1"
	local enabled

	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	local ip ip6 address download upload queue total_download total_upload
	config_get ip "$cfg" ip
	config_get ip6 "$cfg" ip6
	config_get download "$cfg" download 0
	config_get upload "$cfg" upload 0
	config_get queue "$cfg" queue
	config_get total_download config download
	config_get total_upload config upload
	[ -n "$queue" ] || config_get queue "$cfg" comment

	address="$ip"
	[ -n "$address" ] || address="$ip6"
	if ! eqos add "$EQOS_BACKEND" "$queue" "$download" "$upload" "$address" \
		"$total_download" "$total_upload"; then
		CONFIG_ERROR=1
	fi
}

eqos_start_service_locked() {
	config_load eqos

	local enabled effective hook
	config_get_bool enabled config enabled 0
	[ "$enabled" -eq 1 ] || return 0

	# The saved rules are acceleration-independent. Select the fastest safe
	# implementation from the effective runtime, not from the requested UCI
	# value (WAN roles may intentionally fall back from HNAT to flow offload).
	effective="$(cat /var/run/c2000max-hnat-effective 2>/dev/null)"
	hook="$(cat /sys/kernel/debug/hnat/hook_toggle 2>/dev/null)"
	if [ "$effective" = mediatek_hnat ] && [ "$hook" = enabled ]; then
		EQOS_BACKEND=hnat
	else
		EQOS_BACKEND=software
	fi
	export EQOS_BACKEND

	local download upload
	config_get download config download
	config_get upload config upload

	if ! is_uinteger "$download" || ! is_uinteger "$upload" ||
	   [ "$download" -lt 1 ] || [ "$upload" -lt 1 ] ||
	   [ "$download" -gt "$TOTAL_RATE_MAX" ] || [ "$upload" -gt "$TOTAL_RATE_MAX" ]; then
		echo "eqos: total download and upload rates must be between 1 and $TOTAL_RATE_MAX Mbit/s" >&2
		return 1
	fi
	TOTAL_DOWNLOAD_KBIT=$((download * 1000))
	TOTAL_UPLOAD_KBIT=$((upload * 1000))

	CONFIG_ERROR=0
	USED_QUEUES=" "
	USED_SELECTORS=" "
	config_foreach validate_device device
	[ "$CONFIG_ERROR" -eq 0 ] || return 1

	# Take a final snapshot before either accelerator cache is invalidated.
	# Sampling failures do not block rate limiting and are retried by procd.
	[ ! -x /usr/sbin/c2000max-traffic ] ||
		/usr/sbin/c2000max-traffic mib-sync >/dev/null 2>&1 || true
	[ ! -x /usr/sbin/c2000max-traffic ] ||
		/usr/sbin/c2000max-traffic sample >/dev/null 2>&1 || true

	if ! eqos start "$EQOS_BACKEND" "$download" "$upload"; then
		eqos stop >/dev/null 2>&1
		return 1
	fi

	CONFIG_ERROR=0
	config_foreach parse_device device
	if [ "$CONFIG_ERROR" -ne 0 ]; then
		eqos stop >/dev/null 2>&1
		return 1
	fi

	if ! eqos activate "$EQOS_BACKEND"; then
		eqos stop >/dev/null 2>&1
		return 1
	fi

}

eqos_stop_service_locked() {
	eqos stop
}

eqos_reload_service_locked() {
	local enabled

	config_load eqos
	config_get_bool enabled config enabled 0
	if [ "$enabled" -eq 1 ]; then
		eqos_start_service_locked
	else
		eqos_stop_service_locked
	fi
}

c2000_eqos_run_locked() {
	local callback="$1" rc old_locks

	shift
	if [ "$(board_name)" != "nradio,c2000-max" ] ||
	   [ "${C2000MAX_ACCEL_LOCKS_HELD:-0}" = "1" ]; then
		"$callback" "$@"
		return $?
	fi

	# rc.common already serializes EQoS service calls with its procd lock.
	# Acquire the shared acceleration locks in the one permitted order and keep
	# them across HNAT convergence, QDMA programming, nftables and tc/IFB.
	trap c2000_eqos_signal_abort HUP INT TERM
	flock -x 4 || {
		trap - HUP INT TERM
		return 1
	}
	C2000_EQOS_ROLE_HELD=1
	if ! flock -x 5; then
		flock -u 4
		C2000_EQOS_ROLE_HELD=0
		trap - HUP INT TERM
		return 1
	fi
	C2000_EQOS_HNAT_HELD=1
	old_locks="${C2000MAX_ACCEL_LOCKS_HELD:-0}"
	C2000MAX_ACCEL_LOCKS_HELD=1
	export C2000MAX_ACCEL_LOCKS_HELD
	"$callback" "$@"
	rc=$?
	C2000MAX_ACCEL_LOCKS_HELD="$old_locks"
	export C2000MAX_ACCEL_LOCKS_HELD
	flock -u 5
	C2000_EQOS_HNAT_HELD=0
	flock -u 4
	C2000_EQOS_ROLE_HELD=0
	trap - HUP INT TERM
	return "$rc"
}

start_service() {
	c2000_eqos_run_locked eqos_start_service_locked "$@"
}

stop_service() {
	c2000_eqos_run_locked eqos_stop_service_locked "$@"
}

reload_service() {
	c2000_eqos_run_locked eqos_reload_service_locked "$@"
}

service_triggers() {
	procd_add_reload_trigger eqos
}
