#!/bin/sh /etc/rc.common
# Copyright (C) 2006 OpenWrt.org

. /lib/functions/system.sh

START=99
USE_PROCD=1

QDMA_RATE_MAX=1000000
TOTAL_RATE_MAX=1000
# A tc parent is still required for the selected clients when the user leaves
# the aggregate uncapped. Use a ceiling far above any C2000MAX interface;
# only explicitly selected child classes are shaped and unrelated HNAT flows
# never traverse this software parent.
TC_UNLIMITED_RATE_MBIT=100000
RULE_ID_MAX=4094
HNAT_PROFILE_MAX=31
TOTAL_DOWNLOAD_KBIT=$QDMA_RATE_MAX
TOTAL_UPLOAD_KBIT=$QDMA_RATE_MAX
C2000_ROLE_LOCK="${C2000_ROLE_LOCK:-/var/lock/c2000max-port-role.lock}"
C2000_HNAT_LOCK="${C2000_HNAT_LOCK:-/var/lock/c2000max-hnat.lock}"
C2000_EQOS_ROLE_HELD=0
C2000_EQOS_HNAT_HELD=0
EQOS_RUNTIME_DIR="${EQOS_RUNTIME_DIR:-/var/run/eqos}"
EQOS_ERROR_FILE="$EQOS_RUNTIME_DIR/last_error"
EQOS_PROFILE_FILE="$EQOS_RUNTIME_DIR/profiles"
EQOS_HNAT_DIR="${EQOS_HNAT_DIR:-/sys/kernel/debug/hnat}"
EQOS_IP="${EQOS_IP:-ip}"
EQOS_SYS_CLASS_NET="${EQOS_SYS_CLASS_NET:-/sys/class/net}"
HNAT_UP_PROFILES=""
HNAT_DL_PROFILES=""
HNAT_UP_PROFILE_COUNT=0
HNAT_DL_PROFILE_COUNT=0
HNAT_PROFILE_ID=0

: >>"$C2000_ROLE_LOCK" || exit 1
: >>"$C2000_HNAT_LOCK" || exit 1
exec 4<>"$C2000_ROLE_LOCK" || exit 1
exec 5<>"$C2000_HNAT_LOCK" || exit 1

c2000_eqos_signal_abort() {
	trap '' HUP INT TERM
	# A limiter failure must never silently change the user's acceleration
	# choice. Clean up only EQoS-owned QDMA/tc/nft state before releasing locks.
	if [ "$C2000_EQOS_HNAT_HELD" = 1 ]; then
		eqos stop >/dev/null 2>&1 || true
		flock -u 5 >/dev/null 2>&1 || true
		C2000_EQOS_HNAT_HELD=0
	fi
	if [ "$C2000_EQOS_ROLE_HELD" = 1 ]; then
		flock -u 4 >/dev/null 2>&1 || true
		C2000_EQOS_ROLE_HELD=0
	fi
	exit 1
}

is_uinteger() {
	case "$1" in
		''|*[!0-9]*|0[0-9]*) return 1 ;;
	esac

	return 0
}

valid_total_rate() {
	[ "$1" = -1 ] && return 0
	is_uinteger "$1" && [ "$1" -ge 1 ] && [ "$1" -le "$TOTAL_RATE_MAX" ]
}

valid_mac() {
	case "$1" in
		[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]) return 0 ;;
	esac
	return 1
}

addresses_for_mac() {
	local wanted

	wanted="$(printf '%s' "$1" | tr 'A-F' 'a-f')"
	{
		awk -v mac="$wanted" 'tolower($2) == mac { print $3 }' /tmp/dhcp.leases 2>/dev/null
		ip neigh show dev br-lan 2>/dev/null |
			awk -v mac="$wanted" '{ for (i=1; i<NF; i++) if ($i=="lladdr" && tolower($(i+1))==mac) print $1 }'
		ip -6 neigh show dev br-lan 2>/dev/null |
			awk -v mac="$wanted" '{ for (i=1; i<NF; i++) if ($i=="lladdr" && tolower($(i+1))==mac) print $1 }'
	} | sort -u
}

c2000_eqos_external_uplink_active() {
	local ext_devices route_devices ext route_dev
	local sys_class_net="${EQOS_SYS_CLASS_NET:-/sys/class/net}"

	[ -r "$EQOS_HNAT_DIR/external_interface" ] || return 1
	ext_devices="$(sed -n \
		's/^ext devices \[[^]]*\] = \([^[:space:]]*\).*/\1/p' \
		"$EQOS_HNAT_DIR/external_interface" 2>/dev/null)"
	[ -n "$ext_devices" ] || return 1

	route_devices="$({
		"$EQOS_IP" -4 route show table all default 2>/dev/null
		"$EQOS_IP" -6 route show table all default 2>/dev/null
	} | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") print $(i + 1) }' |
		sort -u)"

	for ext in $ext_devices; do
		for route_dev in $route_devices; do
			[ "$ext" = "$route_dev" ] && return 0
		done
		# During a soft reboot QModem may create eth2 before installing its
		# default route. Treat an up, non-bridge HNAT external device as an
		# uplink candidate so EQoS never briefly enables the unsafe QDMA upload
		# path. Wi-Fi external devices are br-lan members and are excluded.
		[ -d "$sys_class_net/$ext" ] || continue
		[ ! -e "$sys_class_net/$ext/brport" ] || continue
		"$EQOS_IP" link show dev "$ext" 2>/dev/null |
			grep -Eq '(^|[<,])UP([,>]|$)|state[[:space:]]+UP' && return 0
	done

	return 1
}

allocate_hnat_profile() {
	local dir="$1"
	local rate="$2"
	local profiles count item item_rate item_id

	HNAT_PROFILE_ID=0
	case "$EQOS_BACKEND:$dir" in
		hnat:up|hnat:dl) ;;
		*) return 0 ;;
	esac
	[ "$rate" -ne 0 ] || return 0

	case "$dir" in
		up)
			profiles="$HNAT_UP_PROFILES"
			count="$HNAT_UP_PROFILE_COUNT"
			;;
		dl)
			profiles="$HNAT_DL_PROFILES"
			count="$HNAT_DL_PROFILE_COUNT"
			;;
		*) return 1 ;;
	esac

	# A QDMA queue is a rate profile, not a device/rule ID. Reuse it for
	# every rule with the same rate. The resulting hardware cap is shared by
	# all devices assigned to that profile.
	for item in $profiles; do
		item_rate="${item%%:*}"
		item_id="${item#*:}"
		if [ "$item_rate" = "$rate" ]; then
			HNAT_PROFILE_ID="$item_id"
			return 0
		fi
	done

	[ "$count" -lt "$HNAT_PROFILE_MAX" ] || return 0
	count=$((count + 1))
	HNAT_PROFILE_ID="$count"
	case "$dir" in
		up)
			HNAT_UP_PROFILE_COUNT="$count"
			HNAT_UP_PROFILES="${profiles}${rate}:${count} "
			;;
		dl)
			HNAT_DL_PROFILE_COUNT="$count"
			HNAT_DL_PROFILES="${profiles}${rate}:${count} "
			;;
	esac
}

validate_device() {
	local cfg="$1"
	local enabled

	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	local ip ip6 mac rule_id selector selector_count selector_key
	local download upload
	config_get ip "$cfg" ip
	config_get ip6 "$cfg" ip6
	config_get mac "$cfg" mac
	config_get download "$cfg" download 0
	config_get upload "$cfg" upload 0
	config_get rule_id "$cfg" queue
	config_get selector "$cfg" selector
	[ -n "$rule_id" ] || config_get rule_id "$cfg" comment

	if ! is_uinteger "$rule_id" || [ "$rule_id" -lt 1 ] || [ "$rule_id" -gt "$RULE_ID_MAX" ]; then
		echo "eqos: $cfg rule ID must be between 1 and $RULE_ID_MAX" >&2
		CONFIG_ERROR=1
		return 0
	fi

	case " $USED_RULE_IDS " in
		*" $rule_id "*)
			echo "eqos: rule ID $rule_id is used by more than one rule" >&2
			CONFIG_ERROR=1
			return 0
			;;
	esac
	USED_RULE_IDS="${USED_RULE_IDS}${rule_id} "

	if ! is_uinteger "$download" || ! is_uinteger "$upload"; then
		echo "eqos: $cfg download and upload rates must be integers" >&2
		CONFIG_ERROR=1
		return 0
	fi

	if [ "$download" -gt "$QDMA_RATE_MAX" ] || [ "$upload" -gt "$QDMA_RATE_MAX" ]; then
		echo "eqos: $cfg download and upload rates must not exceed $QDMA_RATE_MAX kbit/s" >&2
		CONFIG_ERROR=1
		return 0
	fi
	if [ "$download" -gt "$TOTAL_DOWNLOAD_KBIT" ] ||
	   [ "$upload" -gt "$TOTAL_UPLOAD_KBIT" ]; then
		echo "eqos: $cfg device rate must not exceed the configured total bandwidth" >&2
		CONFIG_ERROR=1
		return 0
	fi

	selector_count=0
	[ -z "$ip" ] || selector_count=$((selector_count + 1))
	[ -z "$ip6" ] || selector_count=$((selector_count + 1))
	[ -z "$mac" ] || selector_count=$((selector_count + 1))

	if [ "$selector_count" -ne 1 ]; then
		echo "eqos: $cfg must set exactly one match field: ip, ip6 or mac" >&2
		CONFIG_ERROR=1
		return 0
	fi

	case "$selector" in
		''|ip|ip6|mac) ;;
		*)
			echo "eqos: $cfg selector must be ip, ip6 or mac" >&2
			CONFIG_ERROR=1
			return 0
			;;
	esac

	case "$selector" in
		ip)
			if [ -z "$ip" ]; then
				echo "eqos: $cfg selector does not match configured field" >&2
				CONFIG_ERROR=1
				return 0
			fi
			;;
		ip6)
			if [ -z "$ip6" ]; then
				echo "eqos: $cfg selector does not match configured field" >&2
				CONFIG_ERROR=1
				return 0
			fi
			;;
		mac)
			if [ -z "$mac" ]; then
				echo "eqos: $cfg selector does not match configured field" >&2
				CONFIG_ERROR=1
				return 0
			fi
			;;
	esac

	if [ -n "$ip" ]; then
		selector_key="ip:$ip"
	elif [ -n "$ip6" ]; then
		selector_key="ip6:$ip6"
	else
		if ! valid_mac "$mac"; then
			echo "eqos: $cfg has an invalid MAC address" >&2
			CONFIG_ERROR=1
			return 0
		fi
		mac="$(printf '%s' "$mac" | tr 'A-F' 'a-f')"
		selector_key="mac:$mac"
	fi

	case "$USED_SELECTORS" in
		*" $selector_key "*)
			echo "eqos: selector $selector_key is used by more than one rule" >&2
			CONFIG_ERROR=1
			return 0
			;;
	esac
	USED_SELECTORS="${USED_SELECTORS}${selector_key} "
}

parse_device() {
	local cfg="$1"
	local enabled

	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	local ip ip6 mac address resolved download upload rule_id total_download total_upload
	local up_profile dl_profile
	config_get ip "$cfg" ip
	config_get ip6 "$cfg" ip6
	config_get mac "$cfg" mac
	config_get download "$cfg" download 0
	config_get upload "$cfg" upload 0
	config_get rule_id "$cfg" queue
	total_download=$((TOTAL_DOWNLOAD_KBIT / 1000))
	total_upload=$((TOTAL_UPLOAD_KBIT / 1000))
	[ -n "$rule_id" ] || config_get rule_id "$cfg" comment

	allocate_hnat_profile up "$upload" || {
		CONFIG_ERROR=1
		return 0
	}
	up_profile="$HNAT_PROFILE_ID"
	allocate_hnat_profile dl "$download" || {
		CONFIG_ERROR=1
		return 0
	}
	dl_profile="$HNAT_PROFILE_ID"

	address="$ip"
	[ -n "$address" ] || address="$ip6"
	[ -n "$address" ] || address="$mac"
	if ! eqos add "$EQOS_BACKEND" "$rule_id" "$download" "$upload" "$address" \
		"$total_download" "$total_upload" "$up_profile" "$dl_profile"; then
		echo "eqos: failed to apply rule $rule_id ($address) on $EQOS_BACKEND" >&2
		CONFIG_ERROR=1
		return 0
	fi

	# The MAC rule above already owns the per-device tc class and both filters.
	# Add known L3 download aliases without repeating the tc rule: inet/forward
	# cannot reliably match the final LAN destination MAC of a routed packet.
	# Pure HNAT uses the alias to apply the download QID; hybrid/software use it
	# to keep the download flow out of HNAT/flowtable before dst_mac HTB shaping.
	[ -n "$mac" ] && [ "$download" -ne 0 ] || return 0
	for resolved in $(addresses_for_mac "$mac"); do
		if ! eqos download-alias "$EQOS_BACKEND" "$download" "$resolved" \
			"$dl_profile"; then
			echo "eqos: failed to apply resolved address $resolved for rule $rule_id" >&2
			CONFIG_ERROR=1
			return 0
		fi
	done
}

eqos_start_service_locked() {
	config_load eqos

	local enabled effective hook
	config_get_bool enabled config enabled 0
	[ "$enabled" -eq 1 ] || return 0

	# The saved rules are acceleration-independent. Select the fastest safe
	# implementation from the effective runtime, not from the requested UCI
	# value (WAN roles may intentionally fall back from HNAT to flow offload).
	effective="$(cat /var/run/c2000max-hnat-effective 2>/dev/null)"
	hook="$(cat /sys/kernel/debug/hnat/hook_toggle 2>/dev/null)"
	if [ "$effective" = mediatek_hnat ] && [ "$hook" = enabled ]; then
		if c2000_eqos_external_uplink_active; then
			# USB/cellular HNAT uses the PPD-reserved queue 63. QDMA HQoS on
			# either direction is firmware/topology dependent and has caused
			# both near-zero speed and complete loss of connectivity. Keep HNAT
			# for unrelated clients and move only limited flows to tc/police.
			EQOS_BACKEND=hybrid
		else
			EQOS_BACKEND=hnat
		fi
	else
		EQOS_BACKEND=software
	fi
	export EQOS_BACKEND

	local download upload effective_download effective_upload
	config_get download config download
	config_get upload config upload

	if ! valid_total_rate "$download" || ! valid_total_rate "$upload"; then
		echo "eqos: total download and upload rates must be -1 (unlimited) or between 1 and $TOTAL_RATE_MAX Mbit/s" >&2
		return 1
	fi

	# QDMA HQoS necessarily programs an aggregate scheduler. When either
	# direction is unlimited, keep unrelated traffic fully on HNAT and shape
	# only selected clients with the existing selective tc path instead.
	if [ "$EQOS_BACKEND" = hnat ] && { [ "$download" = -1 ] || [ "$upload" = -1 ]; }; then
		EQOS_BACKEND=hybrid
		export EQOS_BACKEND
	fi
	effective_download="$download"
	effective_upload="$upload"
	[ "$effective_download" != -1 ] || effective_download="$TC_UNLIMITED_RATE_MBIT"
	[ "$effective_upload" != -1 ] || effective_upload="$TC_UNLIMITED_RATE_MBIT"
	TOTAL_DOWNLOAD_KBIT=$((effective_download * 1000))
	TOTAL_UPLOAD_KBIT=$((effective_upload * 1000))

	CONFIG_ERROR=0
	USED_RULE_IDS=" "
	USED_SELECTORS=" "
	HNAT_UP_PROFILES=""
	HNAT_DL_PROFILES=""
	HNAT_UP_PROFILE_COUNT=0
	HNAT_DL_PROFILE_COUNT=0
	rm -f "$EQOS_PROFILE_FILE"
	config_foreach validate_device device
	[ "$CONFIG_ERROR" -eq 0 ] || return 1

	# Take a final snapshot before either accelerator cache is invalidated.
	# Sampling failures do not block rate limiting and are retried by procd.
	[ ! -x /usr/sbin/c2000max-traffic ] ||
		/usr/sbin/c2000max-traffic mib-sync >/dev/null 2>&1 || true
	[ ! -x /usr/sbin/c2000max-traffic ] ||
		/usr/sbin/c2000max-traffic sample >/dev/null 2>&1 || true

	if ! eqos start "$EQOS_BACKEND" "$effective_download" "$effective_upload"; then
		echo "eqos: failed to initialize the $EQOS_BACKEND limiter backend" >&2
		eqos stop >/dev/null 2>&1
		return 1
	fi

	CONFIG_ERROR=0
	config_foreach parse_device device
	if [ "$CONFIG_ERROR" -ne 0 ]; then
		echo "eqos: one or more limiter rules could not be programmed" >&2
		eqos stop >/dev/null 2>&1
		return 1
	fi

	if ! eqos activate "$EQOS_BACKEND"; then
		echo "eqos: failed to invalidate cached accelerated flows" >&2
		eqos stop >/dev/null 2>&1
		return 1
	fi

	# Publish only compact numeric state for LuCI/runtime diagnostics.
	{
		printf 'upload=%s\n' "$HNAT_UP_PROFILE_COUNT"
		printf 'download=%s\n' "$HNAT_DL_PROFILE_COUNT"
	} >"$EQOS_PROFILE_FILE.tmp" &&
		mv "$EQOS_PROFILE_FILE.tmp" "$EQOS_PROFILE_FILE"

}

eqos_stop_service_locked() {
	eqos stop
	rm -f "$EQOS_PROFILE_FILE" "$EQOS_PROFILE_FILE.tmp"
}

eqos_reload_service_locked() {
	local enabled

	config_load eqos
	config_get_bool enabled config enabled 0
	if [ "$enabled" -eq 1 ]; then
		eqos_start_service_locked
	else
		eqos_stop_service_locked
	fi
}

c2000_eqos_run_locked() {
	local callback="$1" rc old_locks

	shift
	if [ "$(board_name)" != "nradio,c2000-max" ] ||
	   [ "${C2000MAX_ACCEL_LOCKS_HELD:-0}" = "1" ]; then
		"$callback" "$@"
		return $?
	fi

	# rc.common already serializes EQoS service calls with its procd lock.
	# Acquire the shared acceleration locks in the one permitted order and keep
	# them across HNAT convergence, QDMA programming, nftables and tc/police.
	trap c2000_eqos_signal_abort HUP INT TERM
	flock -x 4 || {
		trap - HUP INT TERM
		return 1
	}
	C2000_EQOS_ROLE_HELD=1
	if ! flock -x 5; then
		flock -u 4
		C2000_EQOS_ROLE_HELD=0
		trap - HUP INT TERM
		return 1
	fi
	C2000_EQOS_HNAT_HELD=1
	old_locks="${C2000MAX_ACCEL_LOCKS_HELD:-0}"
	C2000MAX_ACCEL_LOCKS_HELD=1
	export C2000MAX_ACCEL_LOCKS_HELD
	"$callback" "$@"
	rc=$?
	C2000MAX_ACCEL_LOCKS_HELD="$old_locks"
	export C2000MAX_ACCEL_LOCKS_HELD
	flock -u 5
	C2000_EQOS_HNAT_HELD=0
	flock -u 4
	C2000_EQOS_ROLE_HELD=0
	trap - HUP INT TERM
	return "$rc"
}

eqos_run_reported() {
	local callback="$1" rc tmp

	shift
	mkdir -p "$EQOS_RUNTIME_DIR" || return 1
	tmp="$EQOS_RUNTIME_DIR/service.$$"
	c2000_eqos_run_locked "$callback" "$@" >"$tmp" 2>&1
	rc=$?
	if [ "$rc" -eq 0 ]; then
		rm -f "$EQOS_ERROR_FILE" "$tmp"
		return 0
	fi
	if [ ! -s "$tmp" ]; then
		# The failed transaction has already removed its partial HQoS/tc state.
		# Diagnosing that cleaned state would only hide the real operation which
		# failed behind a misleading "HQoS is disabled" message.
		echo "eqos: limiter transaction failed without command output; check logread -e eqos" >"$tmp"
	fi
	[ -s "$tmp" ] ||
		echo "eqos: limiter backend failed without a diagnostic" >"$tmp"
	cat "$tmp" >&2
	mv "$tmp" "$EQOS_ERROR_FILE"
	return "$rc"
}

start_service() {
	eqos_run_reported eqos_start_service_locked "$@"
}

stop_service() {
	c2000_eqos_run_locked eqos_stop_service_locked "$@"
}

reload_service() {
	eqos_run_reported eqos_reload_service_locked "$@"
}

service_triggers() {
	procd_add_reload_trigger eqos
}
