#!/bin/sh /etc/rc.common

START=51
STOP=89
USE_PROCD=1

start_service()
{
	local enabled

	config_load eqos
	config_get_bool enabled config statistics_enabled 1
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/c2000max-traffic daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service()
{
	/usr/sbin/c2000max-traffic flush >/dev/null 2>&1 || true
	rm -f /tmp/c2000max-traffic/daemon.pid
}

reload_service()
{
	stop
	start
}

service_triggers()
{
	procd_add_reload_trigger eqos
}
