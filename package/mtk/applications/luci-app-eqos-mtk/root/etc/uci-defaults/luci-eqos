#!/bin/sh

uci -q batch <<-EOF >/dev/null
	delete ucitrack.@eqos[-1]
	add ucitrack eqos
	set ucitrack.@eqos[-1].init=eqos
	commit ucitrack
EOF

rm -f /tmp/luci-indexcache /tmp/luci-indexcache.*
[ -n "$IPKG_INSTROOT" ] || {
	/etc/init.d/eqos enable >/dev/null 2>&1
	# Do not start the limiter from uci-defaults during the first boot after a
	# sysupgrade. HNAT, the external uplink and QDMA are not converged yet.
	# S99eqos and c2000max-hnat apply the preserved configuration in order.
}
exit 0
