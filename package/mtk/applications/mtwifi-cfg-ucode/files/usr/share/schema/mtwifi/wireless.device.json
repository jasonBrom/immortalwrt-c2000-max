{
    "description": "mtwifi device schema",
    "type": "object",
    "properties": {
        "band": {
            "type": "string",
            "description": "WiFi Band (2g, 5g, 6g)",
            "enum": [
                "2g",
                "5g",
                "6g"
            ]
        },
        "phy": {
            "type": "string",
            "description": "cfg80211 phy name"
        },
        "channel": {
            "type": "string",
            "description": "WiFi Channel (can be 'auto')"
        },
        "hwmode": {
            "type": "string",
            "description": "Hardware mode (e.g., 11a, 11g, 11ax, 11be)"
        },
        "htmode": {
            "type": "string",
            "description": "High Throughput Mode (e.g., HE160, EHT160, EHT320-2)",
            "enum": [
                "HT20",
                "HT40",
                "VHT20",
                "VHT40",
                "VHT80",
                "VHT160",
                "HE20",
                "HE40",
                "HE80",
                "HE160",
                "EHT20",
                "EHT40",
                "EHT80",
                "EHT160",
                "EHT320",
                "EHT320-2"
            ]
        },
        "noscan": {
            "type": "string",
            "description": "Disable scanning (set to '1' to disable)"
        },
        "txpower": {
            "type": "integer",
            "description": "Transmission power (0-100)"
        },
        "beacon_int": {
            "type": "integer",
            "description": "Beacon interval"
        },
        "mu_beamformer": {
            "type": "boolean",
            "description": "Enable MU-MIMO Beamformer"
        },
        "country": {
            "type": "string",
            "description": "Country code (e.g., CN, US)"
        },
        "twt": {
            "type": "string",
            "description": "Target Wake Time support"
        }
    }
}
