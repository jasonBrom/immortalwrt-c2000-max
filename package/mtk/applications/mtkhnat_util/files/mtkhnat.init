START=19

USE_PROCD=1
NAME=mtkhnat
PROG=/sbin/mtkhnat

start_service() {
	# C2000MAX uses c2000max-hnat as the sole acceleration state machine.
	# Do not probe mtkhnat here: the module enables its hook during probe and
	# could briefly overlap the preserved software flowtable before S20.
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" != "nradio,c2000-max" ] ||
		return 0

	procd_open_instance
	procd_set_param command "${PROG}"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "mtkhnat"
}
