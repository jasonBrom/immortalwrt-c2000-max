+function match_mtwifi_devices(devices, dev_names)
+{
+	if (!length(dev_names))
+		return false;
+
+	for (let dev_name in dev_names) {
+		let dev = devices[dev_name];
+		if (!dev || dev.config.type != "mtwifi")
+			return false;
+	}
+
+	return true;
+}
+
+// Admit the complete MLO AP before splitting it into radio payloads.
+function validate_mtwifi_mlo_ap(devices, dev_names, iface_name)
+{
+	for (let dev_name in dev_names) {
+		let dev = devices[dev_name];
+		if (dev.config.disabled)
+			continue;
+		if (index(dev.config.htmode, "EHT") != 0) {
+			warn(`mtwifi: drop MLO AP ${iface_name}: ${dev_name} is not EHT`);
+			return false;
+		}
+
+		let vif_count = length(filter(dev.vif, (vif) => vif.config.mode == "ap"));
+		if (vif_count >= MTWIFI_MAX_AP_VIFS) {
+			warn(`mtwifi: drop MLO AP ${iface_name}: no AP VIF slot on ${dev_name}`);
+			return false;
+		}
+	}
+
+	return true;
+}
