+bool hostapd_is_mtk_private_mld(struct hostapd_data *hapd)
+{
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	return hapd && hapd->conf && hapd->conf->mtk_private_mld;
+#else /* CONFIG_DRIVER_NL80211_MTK */
+	return false;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+}
+
+
+#ifdef CONFIG_DRIVER_NL80211_MTK
+static const char *
+mtk_mld_update_source_to_str(enum mtk_mld_update_source source)
+{
+	switch (source) {
+	case MTK_MLD_UPDATE_FROM_QUERY:
+		return "query";
+	case MTK_MLD_UPDATE_FROM_EVENT:
+		return "event";
+	}
+
+	return "unknown";
+}
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+
+
+int hostapd_update_mtk_private_mld_link(struct hostapd_data *hapd,
+					u8 group_idx, u8 link_id,
+					const u8 *mld_addr,
+					enum mtk_mld_update_source source)
+{
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	struct hapd_interfaces *interfaces;
+	const char *ifname;
+	const char *source_str;
+	bool is_changed;
+	size_t i, j;
+
+	if (!hostapd_is_mtk_private_mld(hapd))
+		return 0;
+
+	ifname = hapd->conf->iface;
+	source_str = mtk_mld_update_source_to_str(source);
+
+	if (!group_idx) {
+		wpa_printf(MSG_ERROR,
+			   "MTK private MLD: refuse update without driver group: "
+			   "iface=%s source=%s",
+			   ifname, source_str);
+		return -1;
+	}
+
+	if (!mld_addr || is_zero_ether_addr(mld_addr))
+		return -1;
+
+	if (hapd->mtk_mld_group_idx &&
+	    hapd->mtk_mld_group_idx != group_idx) {
+		wpa_printf(MSG_ERROR,
+			   "MTK private MLD: refuse group change: "
+			   "iface=%s source=%s cached_group=%u driver_group=%u",
+			   ifname, source_str,
+			   hapd->mtk_mld_group_idx, group_idx);
+		return -1;
+	}
+
+	interfaces = hapd->iface ? hapd->iface->interfaces : NULL;
+	if (interfaces) {
+		for (i = 0; i < interfaces->count; i++) {
+			struct hostapd_iface *iface = interfaces->iface[i];
+
+			if (!iface)
+				continue;
+
+			for (j = 0; j < iface->num_bss; j++) {
+				struct hostapd_data *bss = iface->bss[j];
+
+				if (!bss || bss == hapd ||
+				    !hostapd_is_mtk_private_mld(bss))
+					continue;
+
+				if (!bss->mtk_mld_group_idx ||
+				    is_zero_ether_addr(bss->conf->mld_addr))
+					continue;
+
+				if (bss->mtk_mld_group_idx == group_idx) {
+					if (ether_addr_equal(bss->conf->mld_addr,
+							     mld_addr))
+						continue;
+
+					wpa_printf(MSG_ERROR,
+						   "MTK private MLD: refuse conflicting group member: "
+						   "iface=%s group=%u mld_addr=" MACSTR
+						   " partner_iface=%s partner_mld_addr=" MACSTR,
+						   ifname, group_idx, MAC2STR(mld_addr),
+						   bss->conf->iface,
+						   MAC2STR(bss->conf->mld_addr));
+					return -1;
+				}
+
+				if (ether_addr_equal(bss->conf->mld_addr,
+						     mld_addr)) {
+					wpa_printf(MSG_ERROR,
+						   "MTK private MLD: refuse duplicate MLD address: "
+						   "iface=%s group=%u mld_addr=" MACSTR
+						   " partner_iface=%s partner_group=%u",
+						   ifname, group_idx, MAC2STR(mld_addr),
+						   bss->conf->iface,
+						   bss->mtk_mld_group_idx);
+					return -1;
+				}
+			}
+		}
+	}
+
+	is_changed = hapd->mtk_mld_group_idx != group_idx ||
+		is_zero_ether_addr(hapd->conf->mld_addr) ||
+		!ether_addr_equal(hapd->conf->mld_addr, mld_addr);
+	if (!is_changed && hapd->mld &&
+	    !ether_addr_equal(hapd->mld->mld_addr, mld_addr))
+		is_changed = true;
+
+	if (!is_zero_ether_addr(hapd->conf->mld_addr) &&
+	    !ether_addr_equal(hapd->conf->mld_addr, mld_addr)) {
+		wpa_printf(MSG_DEBUG,
+			   "MTK private MLD: replace cached MLD address: "
+			   "iface=%s source=%s "
+			   "old=" MACSTR " new=" MACSTR,
+			   ifname, source_str,
+			   MAC2STR(hapd->conf->mld_addr),
+			   MAC2STR(mld_addr));
+	}
+
+	hapd->mtk_mld_group_idx = group_idx;
+	hapd->mld_link_id = link_id;
+	os_memcpy(hapd->conf->mld_addr, mld_addr, ETH_ALEN);
+	if (hapd->mld)
+		os_memcpy(hapd->mld->mld_addr, mld_addr, ETH_ALEN);
+	if (hapd->mld && !hapd->link.next && hostapd_mld_add_link(hapd))
+		return -1;
+
+	if (hapd->wpa_auth &&
+	    wpa_auth_set_mld_addr(hapd->wpa_auth, mld_addr, link_id)) {
+		wpa_printf(MSG_ERROR,
+			   "MTK private MLD: failed to update WPA MLD info: iface=%s",
+			   ifname);
+		return -1;
+	}
+
+	/*
+	 * The MTK driver owns private MLD beacon/ML IE state. It can report
+	 * the final MLD address while the link beacon path is still settling,
+	 * so keep hostapd/WPA state in sync without pushing another beacon.
+	 */
+	if (is_changed && hapd->started)
+		wpa_printf(MSG_DEBUG,
+			   "MTK private MLD: updated driver-owned link: "
+			   "iface=%s source=%s group=%u link_id=%u "
+			   "mld_addr=" MACSTR,
+			   ifname, source_str, group_idx, link_id,
+			   MAC2STR(mld_addr));
+
+	return 0;
+#else /* CONFIG_DRIVER_NL80211_MTK */
+	return hostapd_is_mtk_private_mld(hapd) ? -1 : 0;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+}
+
+
+int hostapd_remove_mtk_private_mld_link(struct hostapd_data *hapd,
+					u8 group_idx, u8 link_id)
+{
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	struct hostapd_mld *mld;
+	const char *ifname;
+
+	if (!hostapd_is_mtk_private_mld(hapd))
+		return 0;
+
+	ifname = hapd->conf->iface;
+
+	if (!group_idx) {
+		wpa_printf(MSG_ERROR,
+			   "MTK private MLD: refuse DEL_LINK without driver group: iface=%s",
+			   ifname);
+		return -1;
+	}
+
+	if (hapd->mtk_mld_group_idx &&
+	    hapd->mtk_mld_group_idx != group_idx) {
+		wpa_printf(MSG_ERROR,
+			   "MTK private MLD: refuse DEL_LINK group mismatch: "
+			   "iface=%s driver_group=%u cached_group=%u",
+			   ifname, group_idx,
+			   hapd->mtk_mld_group_idx);
+		return -1;
+	}
+
+	if (hapd->mld_link_id != link_id) {
+		wpa_printf(MSG_ERROR,
+			   "MTK private MLD: refuse DEL_LINK link mismatch: "
+			   "iface=%s driver_link_id=%u cached_link_id=%u",
+			   ifname, link_id, hapd->mld_link_id);
+		return -1;
+	}
+
+	if (hapd->wpa_auth && wpa_auth_clear_mld_addr(hapd->wpa_auth)) {
+		wpa_printf(MSG_ERROR,
+			   "MTK private MLD: failed to clear WPA MLD info: iface=%s",
+			   ifname);
+		return -1;
+	}
+
+	mld = hapd->mld;
+	if (hostapd_mld_remove_link(hapd))
+		return -1;
+
+	os_memset(hapd->conf->mld_addr, 0, ETH_ALEN);
+	hapd->mtk_mld_group_idx = 0;
+	if (mld && dl_list_empty(&mld->links))
+		os_memset(mld->mld_addr, 0, ETH_ALEN);
+
+	return 0;
+#else /* CONFIG_DRIVER_NL80211_MTK */
+	return hostapd_is_mtk_private_mld(hapd) ? -1 : 0;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+}
+
+
+int hostapd_sync_mtk_private_mld_link(struct hostapd_data *hapd)
+{
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	u8 mld_addr[ETH_ALEN];
+	u8 group_idx = 0;
+	u8 link_id = 0;
+
+	if (!hostapd_is_mtk_private_mld(hapd))
+		return 0;
+
+	if (!hapd->driver || !hapd->driver->get_bss_mlo_info)
+		return -1;
+
+	os_memset(mld_addr, 0, sizeof(mld_addr));
+	if (hapd->driver->get_bss_mlo_info(hapd->drv_priv, mld_addr,
+					   &link_id, &group_idx))
+		return -1;
+
+	if (is_zero_ether_addr(mld_addr)) {
+		/*
+		 * The MTK driver may publish private MLD info after the BSS is
+		 * attached. Match the SDK path by not synthesizing link state
+		 * before a non-zero driver MLD address is available.
+		 */
+		wpa_printf(MSG_DEBUG,
+			   "MTK private MLD: defer driver MLD address: iface=%s",
+			   hapd->conf->iface);
+		return 0;
+	}
+
+	return hostapd_update_mtk_private_mld_link(hapd, group_idx, link_id,
+						   mld_addr,
+						   MTK_MLD_UPDATE_FROM_QUERY);
+#else /* CONFIG_DRIVER_NL80211_MTK */
+	return hostapd_is_mtk_private_mld(hapd) ? -1 : 0;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+}
