#!/bin/sh /etc/rc.common

# Keep this shim deliberately small and stable. APK may preserve a locally
# changed file as uuplugin.apk-new; all release-specific logic lives in
# /usr/libexec so the canonical rc.d target cannot fork an old implementation.
UU_ROOT="${IPKG_INSTROOT:-}"
UU_SERVICE="$UU_ROOT/usr/libexec/uuplugin-service"

if [ ! -r "$UU_SERVICE" ]; then
	echo "uuplugin service helper is missing: $UU_SERVICE" >&2
	exit 1
fi

. "$UU_SERVICE"
