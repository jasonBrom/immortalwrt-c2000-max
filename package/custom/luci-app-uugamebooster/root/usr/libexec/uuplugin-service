#!/bin/sh

USE_PROCD=1
START=99
STOP=10

CONF="uuplugin"
RUNDIR="/tmp/uu"
LAUNCHER="/usr/libexec/uuplugin-launcher"
MIGRATOR="/usr/libexec/uuplugin-migrate-apk-new"
STATE_FILE="/tmp/uuplugin.state"

start_service() {
	local enabled

	[ ! -x "$MIGRATOR" ] || "$MIGRATOR" / >/dev/null 2>&1 || return 1
	config_load "$CONF"
	config_get_bool enabled "uuplugin" "enabled" "0"

	if [ "$enabled" -ne 1 ]; then
		if ! "$LAUNCHER" --cleanup-only; then
			echo 'UU 已停用，但旧规则清理失败；软件卸载和 HNAT 保持禁用' > "$STATE_FILE"
			return 1
		fi
		echo '已停用；启用 UU 前的加速设置已恢复' > "$STATE_FILE"
		return 0
	fi

	# A failed stale-runtime cleanup must prevent a new core from starting.
	# The launcher keeps acceleration disabled on every cleanup failure.
	"$LAUNCHER" --prepare-only || return 1
	mkdir -p "$RUNDIR" || return 1

	procd_open_instance uuplugin
	procd_set_param command "$LAUNCHER"
	procd_set_param file /etc/config/uuplugin
	procd_set_param file /usr/libexec/uuplugin-launcher
	procd_set_param limits core="unlimited"
	procd_set_param term_timeout 15
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_stopped() {
	"$LAUNCHER" --cleanup-only
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger uuplugin
}
