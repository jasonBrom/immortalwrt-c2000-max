#!/bin/sh /etc/rc.common

START=96
STOP=10
USE_PROCD=1

service_triggers() {
	procd_add_reload_trigger "speedtestx"
}

start_service() {
	config_load speedtestx
	config_get_bool enabled main enabled 0
	[ "$enabled" = "1" ] || return 0

	config_get listen main listen '0.0.0.0:9001'
	config_get max_download_mb main max_download_mb '50'
	config_get max_clients main max_clients '24'
	config_get history_limit main history_limit '100'

	procd_open_instance
	procd_set_param command /usr/bin/speedtest-x-go
	procd_append_param command -listen "$listen"
	procd_append_param command -max-download-mb "$max_download_mb"
	procd_append_param command -max-clients "$max_clients"
	procd_append_param command -history-limit "$history_limit"
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="4096 4096"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
