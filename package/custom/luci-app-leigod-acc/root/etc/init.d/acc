#!/bin/sh /etc/rc.common

START=50
STOP=15
USE_PROCD=1

BIN="/usr/sbin/leigod/acc-gw.linux.arm64"

start_service() {
	local enabled
	config_load accelerator
	config_get_bool enabled base enabled 0
	[ "$enabled" -eq 1 ] || return 0
	[ -x "$BIN" ] || {
		logger -t leigod "missing accelerator binary: $BIN"
		return 1
	}

	procd_open_instance
	procd_set_param command "$BIN" --mode tun
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="65535 65535"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger accelerator
}
