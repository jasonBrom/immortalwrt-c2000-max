#!/bin/sh

. /lib/functions.sh
. /lib/functions/system.sh

[ "$(board_name)" = "nradio,c2000-max" ] || exit 0

ROLE_LIB=/usr/lib/c2000max/port-role.sh
[ ! -r "$ROLE_LIB" ] || . "$ROLE_LIB"

uci -q set network.lan.ipaddr='192.168.66.1'
uci -q set network.lan.netmask='255.255.255.0'
uci -q set system.@system[0].hostname='C2000MAX'
uci -q set system.@system[0].timezone='CST-8'
uci -q set system.@system[0].zonename='Asia/Shanghai'

# Add the role controller without trusting a stale marker during sysupgrade.
# The actual network topology is authoritative.
if [ -z "$(uci -q get c2000max.ethernet)" ]; then
	uci -q set c2000max.ethernet='ethernet'
fi
role=inconsistent
if command -v c2000_actual_role >/dev/null 2>&1; then
	role="$(c2000_actual_role)"
fi
case "$role" in lan|wan) ;; *) role=lan ;; esac
uci -q set "c2000max.ethernet.role=$role"
uci -q set c2000max.ethernet.port='eth1'
uci -q set c2000max.ethernet.wan4='c2000_wan'
uci -q set c2000max.ethernet.wan6='c2000_wan6'
wan_metric="$(uci -q get c2000max.ethernet.wan_metric)"
case "$wan_metric" in
	''|*[!0-9]*) uci -q set c2000max.ethernet.wan_metric='5' ;;
esac
wan_mode="$(uci -q get c2000max.ethernet.wan_mode)"
case "$wan_mode" in
	ethernet_only|ethernet_5g_balance) ;;
	*) uci -q set c2000max.ethernet.wan_mode='ethernet_only' ;;
esac
ethernet_weight="$(uci -q get c2000max.ethernet.ethernet_weight)"
cellular_weight="$(uci -q get c2000max.ethernet.cellular_weight)"
case "$ethernet_weight:$cellular_weight" in
	*[!0-9:]*|:*|*:)
		ethernet_weight=60
		cellular_weight=40
		;;
	*)
		if [ "$ethernet_weight" -lt 1 ] 2>/dev/null ||
		   [ "$ethernet_weight" -gt 99 ] 2>/dev/null ||
		   [ "$cellular_weight" -lt 1 ] 2>/dev/null ||
		   [ "$cellular_weight" -gt 99 ] 2>/dev/null ||
		   [ $((ethernet_weight + cellular_weight)) -ne 100 ] 2>/dev/null; then
			ethernet_weight=60
			cellular_weight=40
		fi
		;;
esac
uci -q set "c2000max.ethernet.ethernet_weight=$ethernet_weight"
uci -q set "c2000max.ethernet.cellular_weight=$cellular_weight"
cellular_modem="$(uci -q get c2000max.ethernet.cellular_modem)"
case "$cellular_modem" in
	''|*[!A-Za-z0-9_]*)
		uci -q set c2000max.ethernet.cellular_modem='auto'
		;;
esac

# V35 adds compressed-memory SWAP. Preserve valid user values on upgrades and
# mirror them into the standard zram-swap UCI options.
if [ -z "$(uci -q get c2000max.swap)" ]; then
	uci -q set c2000max.swap='swap'
fi
swap_enabled="$(uci -q get c2000max.swap.enabled)"
case "$swap_enabled" in 0|1) ;; *) swap_enabled=1 ;; esac
swap_size="$(uci -q get c2000max.swap.size_mb)"
case "$swap_size" in
	''|*[!0-9]*) swap_size=256 ;;
	*) [ "$swap_size" -ge 64 ] && [ "$swap_size" -le 1024 ] || swap_size=256 ;;
esac
swap_algo="$(uci -q get c2000max.swap.comp_algo)"
case "$swap_algo" in lzo|lzo-rle|lz4|zstd) ;; *) swap_algo=lzo ;; esac
swap_priority="$(uci -q get c2000max.swap.priority)"
case "$swap_priority" in
	''|*[!0-9]*) swap_priority=100 ;;
	*) [ "$swap_priority" -ge 1 ] && [ "$swap_priority" -le 32767 ] ||
		swap_priority=100 ;;
esac
swap_swappiness="$(uci -q get c2000max.swap.swappiness)"
case "$swap_swappiness" in
	''|*[!0-9]*) swap_swappiness=150 ;;
	*) [ "$swap_swappiness" -ge 0 ] && [ "$swap_swappiness" -le 200 ] ||
		swap_swappiness=150 ;;
esac
uci -q set "c2000max.swap.enabled=$swap_enabled"
uci -q set "c2000max.swap.size_mb=$swap_size"
uci -q set "c2000max.swap.comp_algo=$swap_algo"
uci -q set "c2000max.swap.priority=$swap_priority"
uci -q set "c2000max.swap.swappiness=$swap_swappiness"
uci -q set "system.@system[0].zram_size_mb=$swap_size"
uci -q set "system.@system[0].zram_comp_algo=$swap_algo"
uci -q set "system.@system[0].zram_priority=$swap_priority"

# Seed one small usable source and clamp list concurrency on this 512 MiB
# board.  This helper belongs to c2000max-board, so a later adblock-fast package
# upgrade cannot remove the policy.  It never starts the service and it never
# overwrites an enabled user-selected source or a local blocked-domain list.
[ ! -x /usr/sbin/c2000max-adblock-compat ] ||
	/usr/sbin/c2000max-adblock-compat seed >/dev/null 2>&1 || true

# Global device access control is deliberately off by default. Never migrate
# the former Wi-Fi-only blacklist into this list: it had different semantics.
if [ -z "$(uci -q get c2000max.access_control)" ]; then
	uci -q set c2000max.access_control='access_control'
	uci -q set c2000max.access_control.enabled='0'
	uci -q set c2000max.access_control.mode='blacklist'
	uci -q set c2000max.access_control.lan_device='auto'
fi
access_enabled="$(uci -q get c2000max.access_control.enabled)"
case "$access_enabled" in 0|1) ;; *)
	access_enabled=0
	uci -q set c2000max.access_control.enabled='0'
	;;
esac
access_mode="$(uci -q get c2000max.access_control.mode)"
case "$access_mode" in blacklist|whitelist) ;; *)
	uci -q set c2000max.access_control.mode='blacklist'
	;;
esac
access_lan="$(uci -q get c2000max.access_control.lan_device)"
case "$access_lan" in
	''|*[!A-Za-z0-9_.:-]*) uci -q set c2000max.access_control.lan_device='auto' ;;
esac

# V24 retires V23's persisted process-state quarantine.  QModem and mwan3
# startup timing is not a network-transaction invariant; stale state here must
# never disable the router again after an upgrade or interrupted switch.
for stale_option in \
	pending pending_role pending_wan_mode pending_ethernet_weight \
	pending_cellular_weight pending_cellular_modem \
	pending_resolved_cellular_modem pending_cellular_interface journal_phase \
	services_override_active qmodem_saved_running qmodem_saved_enabled \
	mwan_saved_running mwan_saved_enabled; do
	uci -q delete "c2000max.ethernet.${stale_option}" || true
done

# Keep the managed interface names permanently in a fail-closed WAN zone.
# Names without a live network interface are harmless in LAN mode and remove
# firewall from the runtime multi-config switch transaction.
wan_zone="$(uci -q show firewall |
	sed -n "s/^firewall\.\([^.=]*\)\.name='wan'$/\1/p" |
	head -n 1)"
if [ -z "$wan_zone" ]; then
	wan_zone="$(uci -q add firewall zone)"
	uci -q set "firewall.${wan_zone}.name=wan"
	uci -q set "firewall.${wan_zone}.output=ACCEPT"
fi
wan_networks="$(uci -q get "firewall.${wan_zone}.network")"
for wan_network in wan wan6 c2000_wan c2000_wan6; do
	c2000_list_has "$wan_networks" "$wan_network" ||
		uci -q add_list "firewall.${wan_zone}.network=$wan_network"
done
uci -q set "firewall.${wan_zone}.input=REJECT"
uci -q set "firewall.${wan_zone}.forward=REJECT"
uci -q set "firewall.${wan_zone}.masq=1"
uci -q set "firewall.${wan_zone}.mtu_fix=1"

uci -q set luci.main.lang='zh_cn'
uci -q set luci.main.mediaurlbase='/luci-static/argon'
uci -q set argon.@global[0].online_wallpaper='bing'
uci -q set argon.@global[0].primary='#168ab0'
uci -q set argon.@global[0].dark_primary='#168ab0'

# V35.16 retires the optional iStoreX/Quickstart integration.  Remove only
# their preserved configuration and startup hooks, keep Argon as the sole
# LuCI theme, and leave unrelated user settings untouched.
[ ! -x /etc/init.d/quickstart ] || \
	/etc/init.d/quickstart stop >/dev/null 2>&1 || true
[ ! -x /etc/init.d/quickstart ] || \
	/etc/init.d/quickstart disable >/dev/null 2>&1 || true
rm -f /etc/rc.d/*quickstart /etc/rc.d/*startdhns
rm -f /etc/hotplug.d/block/09-quickstart
rm -f /etc/config/istorex /etc/config/quickstart
uci -q delete argon.@global[0].skin

# V35.24-TEST matches the official/MYOS fast-start path: keep Zero-Wait off and
# disable the DFS gate itself.  RadarChannelCheck() then skips CAC, so channel
# 36 / EHT160 can advertise immediately without a temporary 80 MHz BSS.
# Remove the old DAT-only ByPassCac token because this driver does not parse it.
wifi_profile=/etc/wireless/mediatek/mt7993.b1.dat
if [ -f "$wifi_profile" ]; then
	sed -i \
		-e '/^ByPassCac=/d' \
		-e 's/^IEEE80211H=.*/IEEE80211H=1/' \
		-e 's/^DfsEnable=.*/DfsEnable=0/' \
		-e 's/^DfsZeroWait=.*/DfsZeroWait=0/' \
		-e 's/^DfsDedicatedZeroWait=.*/DfsDedicatedZeroWait=0/' \
		-e 's/^DfsZeroWaitDefault=.*/DfsZeroWaitDefault=0/' \
		-e 's/^OcacEnable=.*/OcacEnable=0/' \
		"$wifi_profile"
fi

# MediaTek HNAT remains the fresh-install LAN default. Preserve all supported
# user choices across upgrades; WAN roles automatically fall back from HNAT to
# the generic software flowtable without overwriting the saved LAN preference.
uci -q set turboacc.global.set='1'
fastpath="$(uci -q get turboacc.config.fastpath)"
case "$fastpath" in
	disabled|flow_offloading|mediatek_hnat) ;;
	*) fastpath='mediatek_hnat' ;;
esac
uci -q set turboacc.config.fastpath="$fastpath"
uci -q set turboacc.config.fastpath_fo_hw='0'
uci -q set turboacc.config.fullcone='1'
uci -q set turboacc.config.tcpcca='cubic'

# Keep hardware flow offload disabled. The generic nft software flowtable is
# enabled only when it is the effective mode for the current port role.
effective_fastpath="$fastpath"
if command -v c2000_effective_fastpath >/dev/null 2>&1; then
	effective_fastpath="$(c2000_effective_fastpath "$role" "$fastpath")"
fi
[ "$access_enabled" != 1 ] || effective_fastpath=disabled
flow_offloading=0
[ "$effective_fastpath" != flow_offloading ] || flow_offloading=1
uci -q set "firewall.@defaults[0].flow_offloading=$flow_offloading"
uci -q set firewall.@defaults[0].flow_offloading_hw='0'

# The generic S19 helper is bypassed on this board.  c2000max-hnat is the sole
# state machine and loads the module only after the firewall path is safe.
uci -q set mtkhnat.global.enable='0'

# Older test images incorrectly attached the GPIO9 chassis status LED to the
# LAN carrier trigger.  The RJ45 LED is driven directly by the internal 2.5G
# PHY, so remove the stale UCI section on both fresh install and sysupgrade.
uci -q delete system.lan

# Only initialize SSID/security when this boot actually creates wireless UCI.
# Older images reran these assignments after sysupgrade and could erase the
# user's password and force 5 GHz back to auto/EHT160.
wireless_is_new=0
if ! uci -q show wireless 2>/dev/null | grep -q '=wifi-device'; then
	wireless_is_new=1
	wifi config >/dev/null 2>&1
fi

if [ "$wireless_is_new" = '1' ]; then
	for radio in $(uci -q show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p"); do
		band="$(uci -q get wireless.$radio.band)"
		case "$band" in
			2g)
				ssid='ImmortalWrt-2.4G'
				uci -q set "wireless.$radio.channel=auto"
				;;
			5g)
				ssid='ImmortalWrt-5G'
				# Fixed maximum-width profile requested for C2000MAX.  The
				# private driver applies its active regulatory/DFS policy.
				uci -q set "wireless.$radio.channel=36"
				uci -q set "wireless.$radio.htmode=EHT160"
				;;
			*)
				continue
				;;
		esac
		uci -q set "wireless.$radio.disabled=0"
		uci -q set "wireless.$radio.country=CN"
		uci -q delete "wireless.$radio.txpower"
		for iface in $(uci -q show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)\.device='$radio'$/\1/p"); do
			uci -q set "wireless.$iface.disabled=0"
			uci -q set "wireless.$iface.ssid=$ssid"
			uci -q set "wireless.$iface.encryption=none"
			uci -q delete "wireless.$iface.key"
		done
	done
fi

# V35.14 accidentally branded the factory SSIDs as OpenWRT.  On preserved
# upgrades, migrate only those two exact generated values; never touch a
# user-selected SSID, security mode or password.
if [ "$(uci -q get c2000max.migration.wifi_ssid_brand_v1)" != '1' ]; then
	for iface in $(uci -q show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-iface$/\1/p"); do
		case "$(uci -q get wireless.$iface.ssid)" in
			OpenWRT-2.4G)
				uci -q set "wireless.$iface.ssid=ImmortalWrt-2.4G"
				;;
			OpenWRT-5G)
				uci -q set "wireless.$iface.ssid=ImmortalWrt-5G"
				;;
		esac
	done
	uci -q set c2000max.migration='migration'
	uci -q set c2000max.migration.wifi_ssid_brand_v1='1'
fi

# One-time V17 migration.  Touch only the exact former factory combination;
# custom channels, widths, countries, SSIDs and security are preserved.
if [ "$(uci -q get c2000max.migration.wifi_defaults_v18)" != '1' ]; then
	for radio in $(uci -q show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p"); do
		[ "$(uci -q get wireless.$radio.band)" = '5g' ] || continue
		[ "$(uci -q get wireless.$radio.country)" = 'CN' ] || continue
		[ "$(uci -q get wireless.$radio.channel)" = 'auto' ] || continue
		[ "$(uci -q get wireless.$radio.htmode)" = 'EHT160' ] || continue
		uci -q set "wireless.$radio.channel=36"
		uci -q set "wireless.$radio.htmode=EHT160"
	done
	uci -q set c2000max.migration='migration'
	uci -q set c2000max.migration.wifi_defaults_v18='1'
fi

/etc/init.d/c2000max-sim enable
/etc/init.d/c2000max-leds enable
/etc/init.d/c2000max-fan enable
/etc/init.d/c2000max-hnat enable
/etc/init.d/c2000max-access enable
/etc/init.d/c2000max-swap-tune enable
/etc/init.d/c2000max-uplink enable
/etc/init.d/c2000max-service-worker enable
/etc/init.d/cpufreq enable
/etc/init.d/turboacc enable >/dev/null 2>&1
if [ "$swap_enabled" = 1 ]; then
	/etc/init.d/zram enable >/dev/null 2>&1
else
	/etc/init.d/zram disable >/dev/null 2>&1
fi
[ ! -x /etc/init.d/c2000max-uplink-guard ] ||
	/etc/init.d/c2000max-uplink-guard disable >/dev/null 2>&1 || true

# mwan3 ships enabled with an IPv4 catch-all policy for network.wan.  This
# board has no network.wan while eth1 is a LAN port, so starting that untouched
# policy can install an unreachable default before the user enables balanced
# WAN.  Preserve custom configurations that already reference a live netifd
# interface; otherwise keep mwan3 disabled until the V24 role selects balance.
if [ "$role:$wan_mode" != "wan:ethernet_5g_balance" ]; then
	mwan_live=0
	for mwan_interface in $(uci -q show mwan3 2>/dev/null |
		sed -n 's/^mwan3\.\([^.=]*\)=interface$/\1/p'); do
		[ "$(uci -q get "mwan3.${mwan_interface}.enabled")" = 1 ] ||
			continue
		[ "$(uci -q get "network.${mwan_interface}")" = interface ] ||
			continue
		mwan_live=1
		break
	done
	if [ "$mwan_live" = 0 ]; then
		/etc/init.d/mwan3 disable >/dev/null 2>&1 || true
	fi
fi

# Initialize the maintained cpufreq service exactly once for the V16
# migration.  A board-specific marker also upgrades preserved installations
# where a manually installed cpufreq package already had global.set=1.
if [ "$(uci -q get c2000max.migration.cpu_defaults_v16)" != '1' ]; then
	uci -q set cpufreq.cpufreq.governor0='performance'
	uci -q set cpufreq.cpufreq.minfreq0='500000'
	uci -q set cpufreq.cpufreq.maxfreq0='2000000'
	uci -q set cpufreq.global.set='1'
	uci -q set c2000max.migration='migration'
	uci -q set c2000max.migration.cpu_defaults_v16='1'
fi

# Remove the V14/V15 module URLs.  Besides cleaning a possible overlay copy,
# the new v16 filename prevents a browser from reusing the old 304-cached JS.
rm -f /www/luci-static/resources/view/status/include/15_c2000max_v7.js
rm -f /www/luci-static/resources/view/status/include/15_c2000max_v10.js
rm -f /www/luci-static/resources/view/c2000max/port_role_v20.js
rm -f /www/luci-static/resources/view/c2000max/port_role_v21.js
rm -f /www/luci-static/resources/view/c2000max/port_role_v22.js
rm -f /www/luci-static/resources/view/c2000max/port_role_v23.js
rm -f /www/luci-static/resources/view/c2000max/port_role_v24.js
rm -f /www/luci-static/resources/view/c2000max/port_role_v25.js
rm -f /www/luci-static/resources/view/c2000max/port_role_v26.js
rm -f /tmp/luci-indexcache
rm -f /tmp/luci-indexcache.*
rm -rf /tmp/luci-modulecache

# Retire the former board-specific frequency service on preserved upgrades.
[ ! -x /etc/init.d/c2000max-cpufreq ] || /etc/init.d/c2000max-cpufreq disable
uci -q delete c2000max.cpu

# Remove the old QModem C2000-MAX RGB controller on both fresh installs and
# sysupgrade with preserved configuration.  c2000max-leds is the sole owner.
uci -q delete qmodem_led.modem_status
uci -q commit qmodem_led

# Migrate the former five-second RGB poll to the lower-churn default without
# overriding users who already chose a different interval.
if [ "$(uci -q get c2000max.led.interval)" = 5 ]; then
	uci -q set c2000max.led.interval='15'
fi

# The board has several AT consumers (QModem, SIM switching, RGB status and
# the MT5700 panel).  Make at-daemon their single serial reader.  Explicit
# per-modem direct backends remain available as a troubleshooting override.
uci -q set qmodem.main.serialized_at='1'
for modem in $(uci -q show qmodem 2>/dev/null |
	sed -n "s/^qmodem\.\([A-Za-z0-9_]*\)=\(['\"]\{0,1\}\)modem-device\2$/\1/p"); do
	case "$(uci -q get "qmodem.${modem}.at_backend")" in
		tom_modem|sms_tool_q) ;;
		*) uci -q set "qmodem.${modem}.use_ubus=1" ;;
	esac
done
uci -q commit qmodem

uci -q commit network
uci -q commit system
uci -q commit firewall
uci -q commit luci
uci -q commit argon
uci -q commit turboacc
uci -q commit mtkhnat
uci -q commit wireless
uci -q commit cpufreq
uci -q commit c2000max

/etc/init.d/qmodem_led reload >/dev/null 2>&1 || true

exit 0
