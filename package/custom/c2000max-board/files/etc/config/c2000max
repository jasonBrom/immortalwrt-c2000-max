config sim 'sim'
	option slot 'external2'
	option vendor 'auto'
	option at_port 'auto'

config led 'led'
	option enabled '1'
	option interval '15'
	option weak_rsrp '-90'
	option good_rsrp '-80'

config fan 'fan'
	option enabled '1'
	option mode 'smart'
	option interval '5'
	option temp_low '55'
	option temp_medium '65'
	option temp_high '75'
	option hysteresis '3'
	option speed_low '35'
	option speed_medium '65'
	option speed_high '100'
	option manual_speed '50'

config ethernet 'ethernet'
	option role 'lan'
	option port 'eth1'
	option wan4 'c2000_wan'
	option wan6 'c2000_wan6'
	option wan_metric '5'
	option wan_mode 'ethernet_only'
	option ethernet_weight '60'
	option cellular_weight '40'
	option cellular_modem 'auto'

config swap 'swap'
	option enabled '1'
	option size_mb '256'
	option comp_algo 'lzo'
	option priority '100'
	option swappiness '150'

config access_control 'access_control'
	option enabled '0'
	option mode 'blacklist'
	option lan_device 'auto'

config wifi_performance 'wifi_performance'
	option enabled '1'

config ip_family 'ip_family'
	option preference 'auto'
	option dns_service '1'
	option stun_ipv4 'stun.miwifi.com:3478'
	option stun_ipv6 'stun.hot-chilli.net:3478'
