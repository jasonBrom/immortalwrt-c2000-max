#!/bin/sh /etc/rc.common

START=18
STOP=10
USE_PROCD=1

start_service() {
	# Respect an explicit disable without keeping a five-second polling daemon
	# alive merely to rediscover it; a UCI reload starts it when enabled.
	[ "$(uci -q get c2000max.fan.enabled)" = "1" ] || {
		/usr/sbin/c2000max-fan stop >/dev/null 2>&1
		return 0
	}
	procd_open_instance
	procd_set_param command /usr/sbin/c2000max-fan daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	/usr/sbin/c2000max-fan stop >/dev/null 2>&1
}

service_triggers() {
	procd_add_reload_trigger c2000max
}
