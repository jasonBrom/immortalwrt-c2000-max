#!/bin/sh /etc/rc.common

START=75
STOP=10

boot() {
	local state=/tmp/c2000max-sim-boot.json
	if C2000MAX_SIM_AT_BACKEND=tom_modem \
		/usr/sbin/c2000max-sim boot-restore >"$state" 2>&1; then
		logger -t c2000max-sim "saved SIM slot restored before QModem startup"
		return 0
	fi

	logger -t c2000max-sim \
		"early SIM restore failed; scheduling serialized runtime retries"
	(
		for delay in 15 30 60; do
			sleep "$delay"
			/usr/sbin/c2000max-sim boot-restore >"$state" 2>&1 && exit 0
		done
		exit 1
	) &
}

start() {
	/usr/sbin/c2000max-sim apply >/dev/null 2>&1 &
}

reload() {
	/usr/sbin/c2000max-sim apply >/dev/null 2>&1 &
}
