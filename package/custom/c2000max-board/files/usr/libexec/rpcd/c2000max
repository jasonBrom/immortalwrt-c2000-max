#!/bin/sh

case "$1" in
	list)
		cat <<'EOF'
{
	"sim_status": {},
	"sim_switch": { "slot": "string" },
	"sim_force": { "slot": "string" },
	"hardware_status": {},
	"factory_status": {},
	"fan_status": {},
	"swap_status": {},
	"swap_apply": {
		"enabled": "bool",
		"size_mb": "int",
		"comp_algo": "string",
		"priority": "int",
		"swappiness": "int"
	},
	"access_status": {},
	"access_apply": {},
	"official_boot_status": {},
	"official_boot_once": {},
	"port_status": {},
	"port_switch": {
		"role": "string",
		"wan_mode": "string",
		"ethernet_weight": "int",
		"cellular_weight": "int",
		"cellular_modem": "string"
	},
	"port_repair": {},
	"port_job_status": { "job_id": "string" }
	,"ip_family_status": {}
	,"ip_family_apply": {
		"preference": "string",
		"dns_service": "bool",
		"ipv4_dns": "string",
		"ipv6_dns": "string",
		"stun_ipv4": "string",
		"stun_ipv6": "string"
	}
	,"stun_test": { "family": "string", "server": "string" }
}
EOF
		;;
	call)
		read -r input
		case "$2" in
			sim_status)
				exec /usr/sbin/c2000max-sim status
				;;
			sim_switch)
				slot="$(jsonfilter -s "$input" -e '@.slot')"
				case "$slot" in
					external1|external2|internal)
						result="$(/usr/sbin/c2000max-sim switch "$slot")"
						printf '%s\n' "$result"
						;;
					*)
						echo '{"success":false,"message":"无效卡槽"}'
						;;
				esac
				;;
			sim_force)
				slot="$(jsonfilter -s "$input" -e '@.slot')"
				case "$slot" in
					external1|external2)
						result="$(/usr/sbin/c2000max-sim force "$slot")"
						printf '%s\n' "$result"
						;;
					*)
						echo '{"success":false,"message":"强制 GPIO 模式仅支持两个外置卡槽"}'
						;;
				esac
				;;
			hardware_status)
				exec /usr/sbin/c2000max-hwmon
				;;
			factory_status)
				exec /usr/sbin/c2000max-factory status-json
				;;
			fan_status)
				exec /usr/sbin/c2000max-fan status
				;;
			swap_status)
				exec /usr/sbin/c2000max-swap status
				;;
			swap_apply)
				enabled="$(jsonfilter -s "$input" -e '@.enabled')"
				size_mb="$(jsonfilter -s "$input" -e '@.size_mb')"
				comp_algo="$(jsonfilter -s "$input" -e '@.comp_algo')"
				priority="$(jsonfilter -s "$input" -e '@.priority')"
				swappiness="$(jsonfilter -s "$input" -e '@.swappiness')"
				exec /usr/sbin/c2000max-swap apply \
					"$enabled" "$size_mb" "$comp_algo" "$priority" "$swappiness"
				;;
			access_status)
				exec /usr/sbin/c2000max-access status
				;;
			access_apply)
				exec /usr/sbin/c2000max-access apply
				;;
			official_boot_status)
				exec /usr/sbin/c2000max-boot-official-once status-json
				;;
			official_boot_once)
				exec /usr/sbin/c2000max-boot-official-once arm
				;;
			port_status)
				exec /usr/sbin/c2000max-port-role status
				;;
			port_switch)
				role="$(jsonfilter -s "$input" -e '@.role')"
				wan_mode="$(jsonfilter -s "$input" -e '@.wan_mode')"
				ethernet_weight="$(jsonfilter -s "$input" -e '@.ethernet_weight')"
				cellular_weight="$(jsonfilter -s "$input" -e '@.cellular_weight')"
				cellular_modem="$(jsonfilter -s "$input" -e '@.cellular_modem')"
				case "$role" in
					lan|wan)
						exec /usr/sbin/c2000max-port-role switch "$role" \
							"$wan_mode" "$ethernet_weight" "$cellular_weight" \
							"${cellular_modem:-auto}"
						;;
					*)
						echo '{"success":false,"message":"无效网口角色"}'
						;;
				esac
				;;
			port_repair)
				exec /usr/sbin/c2000max-port-role repair
				;;
			port_job_status)
				job_id="$(jsonfilter -s "$input" -e '@.job_id')"
				exec /usr/sbin/c2000max-port-role job-status "$job_id"
				;;
			ip_family_status)
				exec /usr/sbin/c2000max-ip-family status
				;;
			ip_family_apply)
				preference="$(jsonfilter -s "$input" -e '@.preference')"
				dns_service="$(jsonfilter -s "$input" -e '@.dns_service')"
				ipv4_dns="$(jsonfilter -s "$input" -e '@.ipv4_dns')"
				ipv6_dns="$(jsonfilter -s "$input" -e '@.ipv6_dns')"
				stun_ipv4="$(jsonfilter -s "$input" -e '@.stun_ipv4')"
				stun_ipv6="$(jsonfilter -s "$input" -e '@.stun_ipv6')"
				exec /usr/sbin/c2000max-ip-family apply \
					"$preference" "$dns_service" "$ipv4_dns" "$ipv6_dns" \
					"$stun_ipv4" "$stun_ipv6"
				;;
			stun_test)
				family="$(jsonfilter -s "$input" -e '@.family')"
				server="$(jsonfilter -s "$input" -e '@.server')"
				exec /usr/sbin/c2000max-ip-family stun "$family" "$server"
				;;
		esac
		;;
esac
