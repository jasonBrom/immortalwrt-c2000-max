#!/bin/sh

# Arm exactly one boot into the untouched SPI-NOR factory firmware.  The
# vendor U-Boot does not execute bootcmd: it enters mtkautoboot and selects
# bootmenu_0.  The temporary menu command first persists the normal TF-card
# source, removes itself, then changes boot_from_sd only in U-Boot RAM before
# calling mtkboardboot.  The following reset therefore loads boot_from_sd=1.

ENV_LABEL='u-boot-env'
ENV_SIZE=65536
MENU_VAR='bootmenu_0'
SOURCE_VAR='boot_from_sd'
ONE_SHOT_VALUE='Startup system (one-time factory)=setenv boot_from_sd 1; setenv bootmenu_0; saveenv; setenv boot_from_sd 0; mtkboardboot'

json_result() {
	local ready="$1" armed="$2" message="$3"
	. /usr/share/libubox/jshn.sh
	json_init
	json_add_boolean ready "$ready"
	json_add_boolean armed "$armed"
	json_add_string message "$message"
	json_dump
}

find_env_mtd() {
	local name rest hexsize size
	while IFS=: read -r name rest; do
		case "$rest" in
			*\"$ENV_LABEL\"*) ;;
			*) continue ;;
		esac
		hexsize="${rest# }"
		hexsize="${hexsize%% *}"
		size=$((0x$hexsize))
		[ "$size" -eq "$ENV_SIZE" ] || return 1
		printf '/dev/%s\n' "$name"
		return 0
	done < /proc/mtd
	return 1
}

make_env_config() {
	ENV_MTD="$(find_env_mtd)" || return 1
	[ -c "$ENV_MTD" ] || return 1
	ENV_CONFIG="/tmp/c2000max-fw-env.$$"
	(umask 077; printf '%s 0x0 0x10000 0x10000\n' "$ENV_MTD" > "$ENV_CONFIG") || return 1
}

cleanup() {
	[ -z "$ENV_CONFIG" ] || rm -f "$ENV_CONFIG"
	[ -z "$ENV_BATCH" ] || rm -f "$ENV_BATCH"
}
trap cleanup EXIT INT TERM

env_get() {
	fw_printenv -c "$ENV_CONFIG" -n "$1" 2>/dev/null
}

validate_environment() {
	local source boot_system
	fw_printenv -c "$ENV_CONFIG" >/dev/null 2>&1 || return 1
	source="$(env_get "$SOURCE_VAR")" || return 1
	case "$source" in 0|1) ;; *) return 1 ;; esac
	boot_system="$(env_get boot_system)" || return 1
	case "$boot_system" in ''|*[!0-9]*) return 1 ;; esac
	return 0
}

status_json() {
	local menu
	if ! command -v fw_printenv >/dev/null 2>&1 ||
	   ! command -v fw_setenv >/dev/null 2>&1; then
		json_result 0 0 '缺少 U-Boot 环境工具，无法安全切换。'
		return
	fi
	if ! make_env_config; then
		json_result 0 0 '未找到独立的 64 KiB SPI-NOR U-Boot 环境分区。'
		return
	fi
	if ! validate_environment; then
		json_result 0 0 '无法校验 SPI-NOR U-Boot 环境，未进行任何写入。'
		return
	fi
	menu="$(env_get "$MENU_VAR" 2>/dev/null || true)"
	case "$menu" in
		"$ONE_SHOT_VALUE")
			json_result 1 1 '已安排下次重启进入官方系统；再下一次自动返回 TF 卡系统。'
			;;
		'')
			json_result 1 0 '可安全安排一次性启动官方系统。'
			;;
		*)
			json_result 0 0 '检测到自定义 bootmenu_0，拒绝覆盖现有 U-Boot 菜单。'
			;;
	esac
}

arm_once() {
	local menu source verify_source
	command -v fw_printenv >/dev/null 2>&1 || {
		json_result 0 0 '缺少 fw_printenv。'; return 1;
	}
	command -v fw_setenv >/dev/null 2>&1 || {
		json_result 0 0 '缺少 fw_setenv。'; return 1;
	}
	make_env_config || {
		json_result 0 0 '未找到独立的 64 KiB SPI-NOR U-Boot 环境分区。'; return 1;
	}
	validate_environment || {
		json_result 0 0 '无法读取或校验 SPI-NOR U-Boot 环境。'; return 1;
	}
	menu="$(env_get "$MENU_VAR" 2>/dev/null || true)"
	case "$menu" in
		"$ONE_SHOT_VALUE")
			json_result 1 1 '一次性官方系统启动已经安排。'
			return 0
			;;
		'') ;;
		*)
			json_result 0 0 '检测到自定义 bootmenu_0，拒绝覆盖现有 U-Boot 菜单。'
			return 1
			;;
	esac

	# boot_from_sd is deliberately not changed here.  This single environment
	# update is recoverable: if mtkautoboot does not consume it, the board still
	# follows its current TF-card setting.
	source="$(env_get "$SOURCE_VAR")"
	ENV_BATCH="/tmp/c2000max-fw-env-batch.$$"
	(umask 077; printf '%s %s\n' "$MENU_VAR" "$ONE_SHOT_VALUE" > "$ENV_BATCH") || {
		json_result 0 0 '无法创建环境更新事务。'; return 1;
	}
	if ! fw_setenv -c "$ENV_CONFIG" -s "$ENV_BATCH" >/dev/null 2>&1; then
		json_result 0 0 '写入 U-Boot 环境失败，未安排重启。'
		return 1
	fi
	menu="$(env_get "$MENU_VAR" 2>/dev/null || true)"
	verify_source="$(env_get "$SOURCE_VAR" 2>/dev/null || true)"
	if [ "$menu" != "$ONE_SHOT_VALUE" ] || [ "$verify_source" != "$source" ]; then
		json_result 0 0 'U-Boot 环境回读校验失败，请勿重启并检查 SPI-NOR。'
		return 1
	fi
	json_result 1 1 '已安排：下次重启进入官方系统一次，随后自动恢复 TF 卡启动。'
}

ENV_MTD=
ENV_CONFIG=
ENV_BATCH=

case "$1" in
	status-json|status|'') status_json ;;
	arm) arm_once ;;
	*) echo "usage: $0 {status-json|arm}" >&2; exit 2 ;;
esac
