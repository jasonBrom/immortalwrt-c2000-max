#!/bin/sh
# Read-only C2000-MAX Factory/EEPROM discovery and validation.
# Device numbers and OEM release hashes are deliberately not hard-coded: both
# can change after an OEM update, while partition labels and EEPROM structure
# remain discoverable and independently verifiable.

PATH=/usr/sbin:/usr/bin:/sbin:/bin

status_file="${C2000_FACTORY_STATUS_FILE:-/var/run/c2000max-factory.status}"
proc_mtd="${C2000_FACTORY_PROC_MTD:-/proc/mtd}"
sys_block="${C2000_FACTORY_SYS_BLOCK:-/sys/class/block}"
sys_ubi="${C2000_FACTORY_SYS_UBI:-/sys/class/ubi}"
dev_root="${C2000_FACTORY_DEV_ROOT:-/dev}"

factory_log() {
	logger -t c2000max-factory -- "$*" 2>/dev/null ||
		printf '%s\n' "c2000max-factory: $*" >&2
}

file_size() {
	wc -c < "$1" 2>/dev/null | tr -d '[:space:]'
}

hex_at() {
	hexdump -v -n "$3" -s "$2" -e '1/1 "%02x"' "$1" 2>/dev/null
}

valid_mac_hex() {
	local mac="$1" first rest

	[ "${#mac}" -eq 12 ] || return 1
	case "$mac" in
		*[!0-9a-fA-F]*|000000000000|ffffffffffff|FFFFFFFFFFFF) return 1 ;;
	esac
	rest="${mac#??}"
	first="${mac%$rest}"
	[ $((0x$first & 1)) -eq 0 ]
}

validate_eeprom() {
	local file="$1" expected_size="$2" size magic mac0 mac1

	[ -r "$file" ] || return 1
	size="$(file_size "$file")"
	[ "$size" = "$expected_size" ] || return 1
	magic="$(hex_at "$file" 0 2)"
	[ "$magic" = 9379 ] || return 1
	mac0="$(hex_at "$file" 4 6)"
	mac1="$(hex_at "$file" 10 6)"
	valid_mac_hex "$mac0" && valid_mac_hex "$mac1"
}

mac_text() {
	printf '%s\n' "$1" | sed 's/../&:/g; s/:$//'
}

sha256_file() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" 2>/dev/null | sed 's/[[:space:]].*//'
	else
		printf '%s\n' unavailable
	fi
}

# Output is kind:path. Paths produced by Linux block/MTD/UBI discovery do not
# contain whitespace or colons. Explicit candidates are used by recovery and
# tests, and are still subjected to exactly the same content validation.
factory_candidates() {
	local item label dev uevent name mtd_index

	for item in ${C2000_FACTORY_CANDIDATES:-}; do
		case "$item" in
			*:*) printf '%s\n' "$item" ;;
			*) printf 'explicit:%s\n' "$item" ;;
		esac
	done

	if command -v blkid >/dev/null 2>&1; then
		for label in factory Factory FACTORY; do
			for dev in $(blkid -t "PARTLABEL=$label" -o device 2>/dev/null); do
				[ -e "$dev" ] && printf 'block:%s\n' "$dev"
			done
		done
	fi

	for uevent in "$sys_block"/*/uevent; do
		[ -r "$uevent" ] || continue
		name="$(sed -n 's/^PARTNAME=//p' "$uevent" | head -n 1)"
		[ "$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" = factory ] || continue
		dev="$dev_root/${uevent%/uevent}"
		dev="$dev_root/${dev##*/}"
		[ -e "$dev" ] && printf 'block:%s\n' "$dev"
	done

	for name in "$sys_ubi"/ubi*_*/name; do
		[ -r "$name" ] || continue
		[ "$(tr '[:upper:]' '[:lower:]' < "$name" 2>/dev/null)" = factory ] || continue
		dev="$dev_root/${name%/name}"
		dev="$dev_root/${dev##*/}"
		[ -e "$dev" ] && printf 'ubi:%s\n' "$dev"
	done

	[ -r "$proc_mtd" ] || return 0
	while read -r mtd_index _ label; do
		label="${label#\"}"
		label="${label%\"}"
		[ "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" = factory ] || continue
		mtd_index="${mtd_index%:}"
		dev="$dev_root/$mtd_index"
		[ -e "$dev" ] && printf 'mtd:%s\n' "$dev"
	done < "$proc_mtd"
}

read_exact() {
	local source="$1" output="$2" count="$3" blocks

	rm -f "$output"
	if [ $((count % 2048)) -eq 0 ]; then
		blocks=$((count / 2048))
		dd if="$source" of="$output" bs=2048 count="$blocks" 2>/dev/null
	else
		dd if="$source" of="$output" bs=1 count="$count" 2>/dev/null
	fi
	[ "$(file_size "$output")" = "$count" ]
}

record_status() {
	local source_kind="$1" source="$2" image="$3" quality="$4"
	local temporary="${status_file}.new" mac0 mac1

	mac0="$(hex_at "$image" 4 6)"
	mac1="$(hex_at "$image" 10 6)"
	umask 077
	mkdir -p "${status_file%/*}" 2>/dev/null || true
	{
		printf 'schema=1\n'
		printf 'source_kind=%s\n' "$source_kind"
		printf 'source=%s\n' "$source"
		printf 'quality=%s\n' "$quality"
		printf 'size=%s\n' "$(file_size "$image")"
		printf 'sha256=%s\n' "$(sha256_file "$image")"
		printf 'mac0=%s\n' "$(mac_text "$mac0")"
		printf 'mac1=%s\n' "$(mac_text "$mac1")"
	} > "$temporary" && mv -f "$temporary" "$status_file"
}

prepare_eeprom() {
	local output="$1" count="$2" template="$3"
	local entry kind source temporary="${output}.new"

	case "$count" in ''|*[!0-9]*) factory_log "invalid EEPROM size: $count"; return 2 ;; esac
	[ "$count" -ge 7680 ] || {
		factory_log "EEPROM size is too small: $count"
		return 2
	}
	mkdir -p "${output%/*}" 2>/dev/null || true

	for entry in $(factory_candidates); do
		kind="${entry%%:*}"
		source="${entry#*:}"
		[ -r "$source" ] || continue
		if read_exact "$source" "$temporary" "$count" &&
		   validate_eeprom "$temporary" "$count"; then
			mv -f "$temporary" "$output" || return 1
			record_status "$kind" "$source" "$output" calibrated
			factory_log "validated $count-byte EEPROM from $kind source $source"
			return 0
		fi
		rm -f "$temporary"
	done

	# A reference EEPROM is a safe last-resort boot path, but it does not claim
	# to contain this unit's pre-calibration. The status exposes that distinction.
	if [ -r "$template" ] && validate_eeprom "$template" 7680; then
		dd if=/dev/zero of="$temporary" bs=2048 count=$((count / 2048)) 2>/dev/null || return 1
		[ $((count % 2048)) -eq 0 ] ||
			dd if=/dev/zero of="$temporary" bs=1 count="$count" 2>/dev/null || return 1
		dd if="$template" of="$temporary" bs=7680 count=1 conv=notrunc 2>/dev/null || return 1
		if validate_eeprom "$temporary" "$count"; then
			mv -f "$temporary" "$output" || return 1
			record_status template "$template" "$output" reference-only
			factory_log "no validated full EEPROM; using uncalibrated reference template"
			return 0
		fi
	fi

	rm -f "$temporary"
	factory_log "no structurally valid $count-byte EEPROM source found"
	return 1
}

show_status() {
	if [ -r "$status_file" ]; then
		cat "$status_file"
		return 0
	fi
	printf 'schema=1\nquality=unknown\nsource=unresolved\n'
	return 1
}

show_status_json() {
	local key value
	. /usr/share/libubox/jshn.sh
	json_init
	if [ ! -r "$status_file" ]; then
		json_add_boolean success 0
		json_add_string quality unknown
		json_add_string source unresolved
		json_dump
		return 0
	fi
	json_add_boolean success 1
	while IFS='=' read -r key value; do
		case "$key" in
			schema|size) json_add_int "$key" "${value:-0}" ;;
			source_kind|source|quality|sha256|mac0|mac1)
				json_add_string "$key" "$value"
				;;
		esac
	done < "$status_file"
	json_dump
}

case "${1:-status}" in
	prepare-eeprom)
		[ "$#" -ge 3 ] || {
			echo "Usage: $0 prepare-eeprom <output> <size> [template]" >&2
			exit 2
		}
		prepare_eeprom "$2" "$3" "${4:-/lib/firmware/MT7993_EEPROM.bin}"
		;;
	status)
		show_status
		;;
	status-json)
		show_status_json
		;;
	candidates)
		factory_candidates
		;;
	*)
		echo "Usage: $0 {status|status-json|candidates|prepare-eeprom <output> <size> [template]}" >&2
		exit 2
		;;
esac
