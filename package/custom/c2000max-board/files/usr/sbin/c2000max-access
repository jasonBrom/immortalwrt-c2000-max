#!/bin/sh

. /lib/functions.sh

TAG="c2000max-access"
LOCK="${C2000_ACCESS_LOCK:-/var/lock/c2000max-access.lock}"
FIREWALL_INIT="${C2000_ACCESS_FIREWALL_INIT:-/etc/init.d/firewall}"
HNAT_ENTRY="${C2000_ACCESS_HNAT_ENTRY:-/sys/kernel/debug/hnat/hnat_entry}"
NFT="${C2000_ACCESS_NFT:-nft}"
IP="${C2000_ACCESS_IP:-ip}"
CONNTRACK="${C2000_ACCESS_CONNTRACK:-conntrack}"
RULE_ALLOW="c2000max_access_allow"
RULE_BLOCK="c2000max_access_block"
ACCESS_MACS=""
ACCESS_COUNT=0
ACCESS_INVALID=""

json_escape()
{
	printf '%s' "$1" | sed \
		-e 's/\\/\\\\/g' \
		-e 's/"/\\"/g' \
		-e 's/\t/\\t/g' \
		-e ':a;N;$!ba;s/\n/\\n/g'
}

json_result()
{
	local success="$1" message="$2"
	printf '{"success":%s,"message":"%s"}\n' \
		"$success" "$(json_escape "$message")"
}

normalize_mac()
{
	local mac first
	mac="$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"
	case "$mac" in
		[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]) ;;
		*) return 1 ;;
	esac
	[ "$mac" != "00:00:00:00:00:00" ] &&
		[ "$mac" != "FF:FF:FF:FF:FF:FF" ] || return 1
	first="${mac%%:*}"
	[ $((0x$first & 1)) -eq 0 ] || return 1
	printf '%s\n' "$mac"
}

mac_selected()
{
	case " $ACCESS_MACS " in *" $1 "*) return 0 ;; esac
	return 1
}

collect_device()
{
	local section="$1" enabled mac normalized
	config_get_bool enabled "$section" enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get mac "$section" mac
	normalized="$(normalize_mac "$mac")" || {
		ACCESS_INVALID="${ACCESS_INVALID}${ACCESS_INVALID:+, }${mac:-（空）}"
		return 0
	}
	mac_selected "$normalized" && return 0
	ACCESS_MACS="${ACCESS_MACS}${ACCESS_MACS:+ }$normalized"
	ACCESS_COUNT=$((ACCESS_COUNT + 1))
}

load_policy()
{
	config_load c2000max
	config_get_bool ACCESS_ENABLED access_control enabled 0
	config_get ACCESS_MODE access_control mode blacklist
	config_get ACCESS_LAN access_control lan_device auto
	case "$ACCESS_MODE" in blacklist|whitelist) ;; *) ACCESS_MODE=invalid ;; esac
	ACCESS_MACS=""
	ACCESS_COUNT=0
	ACCESS_INVALID=""
	config_foreach collect_device access_device
}

resolve_lan_device()
{
	local device
	device="$ACCESS_LAN"
	if [ -z "$device" ] || [ "$device" = auto ]; then
		device="$(uci -q get network.lan.device)"
		[ -n "$device" ] || device="$(ubus call network.interface.lan status 2>/dev/null |
			jsonfilter -e '@.l3_device' 2>/dev/null)"
		[ -n "$device" ] || device=br-lan
	fi
	case "$device" in *[!A-Za-z0-9_.:-]*|'') return 1 ;; esac
	printf '%s\n' "$device"
}

delete_managed_rules()
{
	uci -q delete "firewall.$RULE_ALLOW" || true
	uci -q delete "firewall.$RULE_BLOCK" || true
}

add_rule_header()
{
	local section="$1" name="$2" target="$3"
	uci -q set "firewall.$section=rule" || return 1
	uci -q set "firewall.$section.name=$name" || return 1
	uci -q set "firewall.$section.family=any" || return 1
	uci -q set "firewall.$section.proto=all" || return 1
	uci -q set "firewall.$section.src=lan" || return 1
	uci -q set "firewall.$section.dest=wan" || return 1
	uci -q set "firewall.$section.target=$target" || return 1
	uci -q set "firewall.$section.enabled=1" || return 1
	uci -q set "firewall.$section.c2000max_access=1" || return 1
}

write_firewall_policy()
{
	local mac
	delete_managed_rules
	[ "$ACCESS_ENABLED" = 1 ] || return 0

	case "$ACCESS_MODE" in
		blacklist)
			[ "$ACCESS_COUNT" -gt 0 ] || return 0
			add_rule_header "$RULE_BLOCK" "C2000MAX 设备黑名单" REJECT || return 1
			for mac in $ACCESS_MACS; do
				uci -q add_list "firewall.$RULE_BLOCK.src_mac=$mac" || return 1
			done
			;;
		whitelist)
			if [ "$ACCESS_COUNT" -gt 0 ]; then
				add_rule_header "$RULE_ALLOW" "C2000MAX 设备白名单放行" ACCEPT || return 1
				for mac in $ACCESS_MACS; do
					uci -q add_list "firewall.$RULE_ALLOW.src_mac=$mac" || return 1
				done
			fi
			# The reject rule follows the allow rule. These are standard fw4
			# communication rules, never a private nft hook or HNAT mode switch.
			add_rule_header "$RULE_BLOCK" "C2000MAX 非白名单设备拒绝" REJECT || return 1
			;;
	esac
}

kick_mac_flows()
{
	local mac="$1" lan="$2" line ipaddr neigh_mac normalized
	[ -w "$HNAT_ENTRY" ] && printf '8 %s\n' "$mac" > "$HNAT_ENTRY" 2>/dev/null || true
	command -v "$CONNTRACK" >/dev/null 2>&1 || return 0
	while read -r line; do
		set -- $line
		ipaddr="$1"
		neigh_mac="${line#* lladdr }"
		neigh_mac="${neigh_mac%% *}"
		normalized="$(normalize_mac "$neigh_mac" 2>/dev/null)" || continue
		[ "$normalized" = "$mac" ] || continue
		"$CONNTRACK" -D -s "$ipaddr" >/dev/null 2>&1 || true
		"$CONNTRACK" -D -d "$ipaddr" >/dev/null 2>&1 || true
	done <<-EOF
	$("$IP" neigh show dev "$lan" 2>/dev/null)
	EOF
}

invalidate_affected_flows()
{
	local lan="$1" mac line neigh_mac normalized
	# This is a transient cache flush, not an accelerator configuration change.
	"$NFT" flush flowtable inet fw4 ft >/dev/null 2>&1 || true
	if [ "$ACCESS_MODE" = blacklist ]; then
		for mac in $ACCESS_MACS; do kick_mac_flows "$mac" "$lan"; done
		return 0
	fi
	while read -r line; do
		neigh_mac="${line#* lladdr }"
		neigh_mac="${neigh_mac%% *}"
		normalized="$(normalize_mac "$neigh_mac" 2>/dev/null)" || continue
		mac_selected "$normalized" || kick_mac_flows "$normalized" "$lan"
	done <<-EOF
	$("$IP" neigh show dev "$lan" 2>/dev/null)
	EOF
}

firewall_rules_active()
{
	local block allow
	block="$(uci -q get "firewall.$RULE_BLOCK.c2000max_access")"
	allow="$(uci -q get "firewall.$RULE_ALLOW.c2000max_access")"
	if [ "$ACCESS_ENABLED" != 1 ]; then
		[ -z "$block" ] && [ -z "$allow" ]
	elif [ "$ACCESS_MODE" = blacklist ]; then
		[ "$ACCESS_COUNT" -eq 0 ] || [ "$block" = 1 ]
	else
		[ "$block" = 1 ] && { [ "$ACCESS_COUNT" -eq 0 ] || [ "$allow" = 1 ]; }
	fi
}

apply_policy()
{
	local backup lan
	load_policy
	[ "$ACCESS_MODE" != invalid ] || { json_result false "上网控制模式无效"; return 1; }
	[ -z "$ACCESS_INVALID" ] || {
		json_result false "存在无效或非单播 MAC 地址：$ACCESS_INVALID"
		return 1
	}
	lan="$(resolve_lan_device)" || { json_result false "无法确定安全的 LAN 设备名称"; return 1; }
	backup="/tmp/c2000max-access-firewall.$$"
	uci -q export firewall > "$backup" || { json_result false "无法备份防火墙配置"; return 1; }
	if ! write_firewall_policy || ! uci -q commit firewall ||
	   ! "$FIREWALL_INIT" reload >/dev/null 2>&1; then
		uci -q import firewall < "$backup" >/dev/null 2>&1 || true
		uci -q commit firewall >/dev/null 2>&1 || true
		"$FIREWALL_INIT" reload >/dev/null 2>&1 || true
		rm -f "$backup"
		json_result false "fw4 通信规则应用失败，已恢复原防火墙配置"
		return 1
	fi
	rm -f "$backup"
	invalidate_affected_flows "$lan"
	if [ "$ACCESS_ENABLED" = 1 ]; then
		json_result true "设备黑白名单已通过 fw4 通信规则生效，HNAT 保持启用"
	else
		json_result true "设备上网控制已关闭，托管的 fw4 规则已移除"
	fi
}

status_policy()
{
	local active=false lan
	load_policy
	firewall_rules_active && active=true
	lan="$(resolve_lan_device 2>/dev/null || printf 'br-lan')"
	printf '{"success":true,"enabled":%s,"mode":"%s","entry_count":%s,' \
		"$([ "$ACCESS_ENABLED" = 1 ] && printf true || printf false)" \
		"$ACCESS_MODE" "$ACCESS_COUNT"
	printf '"rules_active":%s,"acceleration_preserved":true,"lan_device":"%s",' \
		"$active" "$(json_escape "$lan")"
	printf '"invalid_entries":"%s"}\n' "$(json_escape "$ACCESS_INVALID")"
}

mkdir -p "${LOCK%/*}"
: >> "$LOCK" || { json_result false "无法创建上网控制锁"; exit 1; }
exec 9<>"$LOCK" || exit 1
flock -x 9 || exit 1

case "${1:-status}" in
	apply|reload) apply_policy ;;
	stop)
		delete_managed_rules
		uci -q commit firewall >/dev/null 2>&1 || true
		"$FIREWALL_INIT" reload >/dev/null 2>&1 || true
		;;
	status) status_policy ;;
	*) json_result false "不支持的操作"; exit 1 ;;
esac
