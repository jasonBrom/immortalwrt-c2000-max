#!/bin/sh

. /lib/functions.sh

TAG="c2000max-access"
TABLE="c2000max_access"
LOCK="${C2000_ACCESS_LOCK:-/var/lock/c2000max-access.lock}"
NFT="${C2000_ACCESS_NFT:-nft}"
HNAT_INIT="${C2000_ACCESS_HNAT_INIT:-/etc/init.d/c2000max-hnat}"
HNAT_EFFECTIVE="${C2000_HNAT_EFFECTIVE:-/var/run/c2000max-hnat-effective}"
HNAT_HOOK="${C2000_HNAT_HOOK:-/sys/kernel/debug/hnat/hook_toggle}"
NFT_SCRIPT="${C2000_ACCESS_NFT_SCRIPT:-/tmp/c2000max-access.nft}"
ACCESS_MACS=""
ACCESS_COUNT=0
ACCESS_INVALID=""

json_escape()
{
	printf '%s' "$1" | sed \
		-e 's/\\/\\\\/g' \
		-e 's/"/\\"/g' \
		-e 's/	/\\t/g' \
		-e ':a;N;$!ba;s/\n/\\n/g'
}

json_result()
{
	local success="$1" message="$2"
	printf '{"success":%s,"message":"%s"}\n' \
		"$success" "$(json_escape "$message")"
}

normalize_mac()
{
	local mac first
	mac="$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"
	case "$mac" in
		[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F])
			;;
		*)
			return 1
			;;
	esac
	[ "$mac" != "00:00:00:00:00:00" ] &&
		[ "$mac" != "FF:FF:FF:FF:FF:FF" ] || return 1
	first="${mac%%:*}"
	[ $((0x$first & 1)) -eq 0 ] || return 1
	printf '%s\n' "$mac"
}

collect_device()
{
	local section="$1" enabled mac normalized
	config_get_bool enabled "$section" enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get mac "$section" mac
	normalized="$(normalize_mac "$mac")" || {
		ACCESS_INVALID="${ACCESS_INVALID}${ACCESS_INVALID:+, }${mac:-（空）}"
		return 0
	}
	case " $ACCESS_MACS " in
		*" $normalized "*) return 0 ;;
	esac
	ACCESS_MACS="${ACCESS_MACS}${ACCESS_MACS:+ }$normalized"
	ACCESS_COUNT=$((ACCESS_COUNT + 1))
}

load_policy()
{
	config_load c2000max
	config_get_bool ACCESS_ENABLED access_control enabled 0
	config_get ACCESS_MODE access_control mode blacklist
	config_get ACCESS_LAN access_control lan_device auto
	case "$ACCESS_MODE" in
		blacklist|whitelist) ;;
		*) ACCESS_MODE=invalid ;;
	esac
	ACCESS_MACS=""
	ACCESS_COUNT=0
	ACCESS_INVALID=""
	config_foreach collect_device access_device
}

resolve_lan_device()
{
	local device
	device="$ACCESS_LAN"
	if [ -z "$device" ] || [ "$device" = auto ]; then
		device="$(uci -q get network.lan.device)"
		[ -n "$device" ] || device="$(ubus call network.interface.lan status 2>/dev/null |
			jsonfilter -e '@.l3_device' 2>/dev/null)"
		[ -n "$device" ] || device=br-lan
	fi
	case "$device" in
		*[!A-Za-z0-9_.:-]*|'') return 1 ;;
	esac
	printf '%s\n' "$device"
}

table_active()
{
	"$NFT" list table inet "$TABLE" >/dev/null 2>&1
}

acceleration_suspended()
{
	local flow_sw flow_hw hook effective
	flow_sw="$(uci -q get firewall.@defaults[0].flow_offloading)"
	flow_hw="$(uci -q get firewall.@defaults[0].flow_offloading_hw)"
	effective="$(cat "$HNAT_EFFECTIVE" 2>/dev/null)"
	hook=disabled
	[ ! -r "$HNAT_HOOK" ] || hook="$(cat "$HNAT_HOOK" 2>/dev/null)"
	[ "$flow_sw" = 0 ] &&
		[ "$flow_hw" = 0 ] &&
		[ "$hook" != enabled ] &&
		[ "$hook" != 1 ] &&
		[ "$effective" = disabled ]
}

write_ruleset()
{
	local lan="$1" mac first=1
	{
		if table_active; then
			printf 'delete table inet %s\n' "$TABLE"
		fi
		printf 'add table inet %s\n' "$TABLE"
		printf 'add set inet %s devices { type ether_addr; }\n' "$TABLE"
		if [ "$ACCESS_COUNT" -gt 0 ]; then
			printf 'add element inet %s devices { ' "$TABLE"
			for mac in $ACCESS_MACS; do
				[ "$first" = 1 ] || printf ', '
				printf '%s' "$mac"
				first=0
			done
			printf ' }\n'
		fi
		printf 'add chain inet %s forward { type filter hook forward priority -10; policy accept; }\n' "$TABLE"
		case "$ACCESS_MODE" in
			blacklist)
				printf 'add rule inet %s forward iifname "%s" ether saddr @devices counter drop\n' \
					"$TABLE" "$lan"
				;;
			whitelist)
				if [ "$ACCESS_COUNT" -gt 0 ]; then
					printf 'add rule inet %s forward iifname "%s" ether saddr @devices counter return\n' \
						"$TABLE" "$lan"
				fi
				printf 'add rule inet %s forward iifname "%s" counter drop\n' \
					"$TABLE" "$lan"
				;;
		esac
	} > "${NFT_SCRIPT}.$$" || return 1
	"$NFT" -f "${NFT_SCRIPT}.$$"
	rc=$?
	[ "${C2000_ACCESS_KEEP_SCRIPT:-0}" = 1 ] ||
		rm -f "${NFT_SCRIPT}.$$"
	return "$rc"
}

delete_table()
{
	table_active || return 0
	"$NFT" delete table inet "$TABLE" >/dev/null 2>&1
}

reload_hnat()
{
	[ -x "$HNAT_INIT" ] || return 1
	"$HNAT_INIT" reload >/dev/null 2>&1
}

apply_policy()
{
	local lan rc=0
	load_policy
	[ "$ACCESS_MODE" != invalid ] || {
		json_result false "上网控制模式无效"
		return 1
	}
	[ -z "$ACCESS_INVALID" ] || {
		json_result false "存在无效或非单播 MAC 地址：$ACCESS_INVALID"
		return 1
	}

	if [ "$ACCESS_ENABLED" != 1 ]; then
		delete_table || rc=1
		reload_hnat || rc=1
		if [ "$rc" = 0 ]; then
			json_result true "设备上网控制已关闭"
		else
			json_result false "规则已关闭，但网络加速状态恢复失败"
		fi
		return "$rc"
	fi

	lan="$(resolve_lan_device)" || {
		json_result false "无法确定安全的 LAN 设备名称"
		return 1
	}

	# First tear down and flush every acceleration path. If this fails, still
	# install the nft policy but return an error instead of claiming that the
	# access list cannot be bypassed.
	reload_hnat || rc=1
	write_ruleset "$lan" || {
		json_result false "nftables 规则加载失败"
		return 1
	}
	acceleration_suspended || rc=1
	if [ "$rc" = 0 ]; then
		json_result true "设备上网控制规则已生效"
	else
		json_result false "规则已加载，但无法确认网络加速已安全暂停"
	fi
	return "$rc"
}

status_policy()
{
	local active=false suspended=false lan
	load_policy
	table_active && active=true
	acceleration_suspended && suspended=true
	lan="$(resolve_lan_device 2>/dev/null || printf 'br-lan')"
	printf '{"success":true,"enabled":%s,"mode":"%s","entry_count":%s,' \
		"$([ "$ACCESS_ENABLED" = 1 ] && printf true || printf false)" \
		"$ACCESS_MODE" "$ACCESS_COUNT"
	printf '"table_active":%s,"acceleration_suspended":%s,"lan_device":"%s",' \
		"$active" "$suspended" "$(json_escape "$lan")"
	printf '"invalid_entries":"%s"}\n' "$(json_escape "$ACCESS_INVALID")"
}

mkdir -p "${LOCK%/*}"
: >> "$LOCK" || {
	json_result false "无法创建上网控制锁"
	exit 1
}
exec 9<>"$LOCK" || exit 1
flock -x 9 || exit 1

case "${1:-status}" in
	apply|reload)
		apply_policy
		;;
	stop)
		delete_table
		;;
	status)
		status_policy
		;;
	*)
		json_result false "不支持的操作"
		exit 1
		;;
esac
