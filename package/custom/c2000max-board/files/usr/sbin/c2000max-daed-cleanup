#!/bin/sh

# daed 1.27 may exit without detaching clsact BPF filters.  The veth and
# namespace then keep all referenced maps alive.  Refuse to touch anything
# while the actual daemon executable is still running; script names and shell
# command lines must not count as a daemon process.

DAED_PROG="${C2000MAX_DAED_PROG:-/usr/bin/daed}"

daed_running()
{
	local proc exe
	for proc in /proc/[0-9]*; do
		[ "$proc" != "/proc/$$" ] || continue
		exe="$(readlink -f "$proc/exe" 2>/dev/null)" || continue
		[ "$exe" = "$DAED_PROG" ] && return 0
	done
	return 1
}

if daed_running; then
	logger -t c2000max-daed-cleanup "daed 仍在运行，跳过残留资源清理"
	exit 1
fi

if ip netns list 2>/dev/null | grep -q '^daens\([[:space:]]\|$\)'; then
	ip netns exec daens tc qdisc del dev dae0peer clsact >/dev/null 2>&1 || true
fi
tc qdisc del dev dae0 clsact >/dev/null 2>&1 || true
ip link del dev dae0 >/dev/null 2>&1 || true
ip netns del daens >/dev/null 2>&1 || true

# ip-netns normally removes these mountpoints itself.  Remove only empty,
# exact daed paths left by an interrupted teardown.
rmdir /var/run/netns/daens /tmp/run/netns/daens >/dev/null 2>&1 || true

exit 0
