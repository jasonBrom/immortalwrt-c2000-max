#!/bin/sh

# Clean up the board-owned OWE Transition pair shipped by the first V36.10
# image. MT7993 cannot reliably instantiate its hidden rai1 partner, which
# causes netifd to tear down the otherwise healthy 5 GHz rai0 interface.
# Custom wireless sections are never removed or rewritten.

MAIN_MARKER=c2000max_owe_transition
PARTNER_SECTION=c2000max_owe_5g
PARTNER_MARKER=c2000max_factory_owe
CHANGED_WIRELESS=0
CHANGED_BOARD=0

wireless_ifaces()
{
	uci -q show wireless 2>/dev/null |
		sed -n 's/^wireless\.\([^.]*\)=wifi-iface$/\1/p'
}

delete_wireless()
{
	[ -n "$(uci -q get "$1")" ] || return 0
	uci -q delete "$1" >/dev/null 2>&1 || return 1
	CHANGED_WIRELESS=1
}

sync_legacy_pair()
{
	local main= iface=

	main="$(uci -q get c2000max.wireless.owe_main)"
	[ "$(uci -q get "wireless.${main}")" = wifi-iface ] || main=
	if [ -z "$main" ]; then
		for iface in $(wireless_ifaces); do
			[ "$(uci -q get "wireless.${iface}.${MAIN_MARKER}")" = 1 ] || continue
			main="$iface"
			break
		done
	fi

	if [ -n "$main" ]; then
		delete_wireless "wireless.${main}.owe_transition_bssid"
		delete_wireless "wireless.${main}.owe_transition_ifname"
		delete_wireless "wireless.${main}.owe_transition_ssid"
		delete_wireless "wireless.${main}.${MAIN_MARKER}"
	fi

	# Ownership marker is mandatory: a user-created section with the same name
	# is left untouched.
	if [ "$(uci -q get "wireless.${PARTNER_SECTION}.${PARTNER_MARKER}")" = 1 ]; then
		uci -q delete "wireless.${PARTNER_SECTION}" >/dev/null 2>&1 || return 1
		CHANGED_WIRELESS=1
	fi

	if [ -n "$(uci -q get c2000max.wireless.owe_main)" ]; then
		uci -q delete c2000max.wireless.owe_main >/dev/null 2>&1 || return 1
		CHANGED_BOARD=1
	fi

	[ "$CHANGED_WIRELESS" != 1 ] || uci -q commit wireless
	[ "$CHANGED_BOARD" != 1 ] || uci -q commit c2000max
}

case "${1:-sync}" in
	sync) sync_legacy_pair ;;
	*) echo "Usage: $0 [sync]" >&2; exit 2 ;;
esac
