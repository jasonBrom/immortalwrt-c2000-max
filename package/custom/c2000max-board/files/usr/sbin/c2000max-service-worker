#!/bin/sh

# Board-owned compatibility worker.  It intentionally lives outside the two
# optional plugin packages so their updates cannot restore a blocking RPC path
# or erase the usable AdBlock defaults.

TAG=c2000max-service-worker
wake=0
sleeper=
interval="${C2000MAX_WORKER_INTERVAL:-30}"
maintenance_loops=0

case "$interval" in
	''|*[!0-9]*) interval=30 ;;
esac
[ "$interval" -ge 15 ] 2>/dev/null || interval=15

[ ! -w /proc/self/oom_score_adj ] ||
	echo 500 > /proc/self/oom_score_adj 2>/dev/null

wake_worker()
{
	wake=1
	[ -z "$sleeper" ] || kill "$sleeper" >/dev/null 2>&1 || true
}

stop_worker()
{
	[ -z "$sleeper" ] || kill "$sleeper" >/dev/null 2>&1 || true
	exit 0
}

trap wake_worker USR1
trap stop_worker TERM INT

guard_netbird_watchdog()
{
	local script=/usr/share/netbird/netbird-autoreconnect.sh
	local marker=/tmp/c2000max-netbird-watchdog-guarded

	[ -f "$script" ] || return 0
	if grep -Eq 'ubus[[:space:]].*luci[.]netbird.*do_up' "$script"; then
		/etc/init.d/luci-netbird-watchdog stop >/dev/null 2>&1 || true
		/etc/init.d/luci-netbird-watchdog disable >/dev/null 2>&1 || true
		if [ ! -e "$marker" ]; then
			logger -t "$TAG" \
				"disabled an updated NetBird watchdog that reconnects through blocking rpcd"
			: > "$marker"
		fi
	else
		rm -f "$marker"
	fi
}

protect_recoverable_workers()
{
	local proc pid

	# Never fork one tr(1) process for every PID.  pidof plus one grep pass
	# replaces roughly 200 short-lived tasks on every former five-second loop.
	for pid in $(pidof netbird 2>/dev/null); do
		proc="/proc/$pid"
		renice 10 -p "$pid" >/dev/null 2>&1 || true
		[ ! -w "$proc/oom_score_adj" ] ||
			echo 500 > "$proc/oom_score_adj" 2>/dev/null
	done
	for proc in $(grep -aEl '/lib/adblock-fast/adblock-fast[.]uc' \
		/proc/[0-9]*/cmdline 2>/dev/null); do
		proc="${proc%/cmdline}"
		pid="${proc##*/}"
		[ "$pid" = "$$" ] && continue
		renice 10 -p "$pid" >/dev/null 2>&1 || true
		[ ! -w "$proc/oom_score_adj" ] ||
			echo 500 > "$proc/oom_score_adj" 2>/dev/null
	done
}

while :; do
	wake=0
	/usr/sbin/c2000max-netbird-job run-pending >/dev/null 2>&1
	/usr/sbin/c2000max-netbird-job refresh-status >/dev/null 2>&1

	# Slow maintenance is not a status poll.  Ten 30-second loops retain a
	# five-minute repair window without continuously churning fork/exec/slab.
	if [ "$maintenance_loops" -le 0 ]; then
		/usr/sbin/c2000max-adblock-compat ensure-if-enabled >/dev/null 2>&1
		guard_netbird_watchdog
		protect_recoverable_workers
		maintenance_loops=10
	else
		maintenance_loops=$((maintenance_loops - 1))
	fi

	if [ "$wake" != 0 ]; then
		maintenance_loops=0
		continue
	fi
	sleep "$interval" &
	sleeper=$!
	wait "$sleeper" 2>/dev/null || true
	sleeper=
	[ "$wake" = 0 ] || maintenance_loops=0
done
