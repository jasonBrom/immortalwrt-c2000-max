config service 'main'
	option enabled '0'
	option listen '0.0.0.0:9010'
	option transport 'serial'
	option modem_section 'auto'
	option at_port 'auto'
	option baudrate '115200'
	option network_host '192.168.8.1'
	option network_port '20249'
	option command_timeout '8s'
	option long_command_timeout '240s'
	option queue_timeout '60s'
	option websocket_idle_timeout '5m'
	option max_clients '8'
	option log_file '/var/log/mt5700-web.log'
	option log_max_bytes '2097152'
	option log_backups '3'
