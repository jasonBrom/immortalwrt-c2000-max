config app 'main'
	option local_enable '0'
	option remote_enable '0'
	option local_device_enable '1'
	option local_signal_enable '1'
	option local_client_enable '1'
	option local_wifi_enable '1'
	option local_traffic_enable '1'
	option local_sms_enable '1'
	option local_network_write_enable '1'
	option local_sim_switch_enable '1'
	# Official APP SIM selection mode: 0=automatic, 1=manual.
	option sim_mode '1'
	option local_cellular_record_enable '1'
	option password_enable '1'
	option reboot_enable '1'
	# Allows the official per-device `command` event used by APP remote Web
	# login.  It does not expose the separate rpc/exec topic.
	option remote_web_enable '1'
	option device_report_enable '1'
	option signal_report_enable '1'
	option traffic_report_enable '1'
	option terminal_tracking_enable '1'
	option broadcast_enable '1'
	option command_enable '1'
	option file_enable '1'
	option appstore_enable '1'
	option developer_enable '1'
	option cellular_record_enable '1'
	option permission_defaults_v3513 '1'
	option presence_interval '2'
	option status_interval '30'
	option report_interval '300'
	# Rebuild only the official MQTT bridge once a day.  This refreshes the
	# vendor cloud session without rebooting the router or restarting QModem.
	option bridge_restart_interval '86400'
	# Shared APP snapshot lifetimes.  LuCI exposes these values so users can
	# trade modem query load for faster foreground refreshes.
	option modem_cache_interval '10'
	option selector_cache_interval '15'
	option cache_warm_interval '2'
	# APP foreground refresh policy.  The fast path sends only AT^MONSC through
	# QModem's serialized queue; static modem fields retain their own caches.
	option signal_normal_interval '3'
	option signal_test_interval '1'
	# Carrier aggregation topology changes more slowly and uses HFREQINFO.
	option signal_carrier_interval '10'
