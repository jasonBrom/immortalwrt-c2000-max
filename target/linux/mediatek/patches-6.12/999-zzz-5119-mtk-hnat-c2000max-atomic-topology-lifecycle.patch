+static int hnat_debugfs_lifecycle_trylock(struct mtk_hnat *h)
+{
+	if (!h)
+		return -ENODEV;
+
+	/*
+	 * Do not wait here.  Warm reset can be entered by a netdev notifier
+	 * while RTNL is held, and topology writes take RTNL before their own
+	 * serialization.  A non-blocking gate prevents an RTNL/lifecycle
+	 * lock inversion while still excluding reset and teardown.
