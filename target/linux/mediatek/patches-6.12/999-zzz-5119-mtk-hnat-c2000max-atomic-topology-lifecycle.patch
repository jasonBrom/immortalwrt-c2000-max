+static int hnat_unregister_callback(void (**slot)(struct hnat_tuple *),
+				    void (*func)(struct hnat_tuple *))
+{
+	int ret = HNAT_SUCCESS;
+
+	if (!func)
+		return HNAT_FAIL;
+
+	mutex_lock(&hnat_callback_lock);
+	if (READ_ONCE(*slot) != func)
+		ret = HNAT_FAIL;
+	else
