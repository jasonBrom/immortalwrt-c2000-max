+#define HNAT_FLOWCTL_COLLISION_SLOTS	4
+
+struct hnat_flowctl_tuple {
+	u8 family;
+	u8 protonum;
+	u16 sport;
+	u16 dport;
+	union {
+		struct {
+			u32 src;
+			u32 dst;
+		} v4;
+		struct {
+			u32 src[4];
+			u32 dst[4];
+		} v6;
+	};
+};
+
+struct hnat_flowctl_work {
+	struct work_struct work;
+	struct mtk_hnat *h;
+	u8 tuple_count;
+	struct hnat_flowctl_tuple tuple[IP_CT_DIR_MAX];
+};
+
+static bool
+hnat_flowctl_tuple_copy(const struct nf_conntrack_tuple *src,
+			struct hnat_flowctl_tuple *dst)
+{
+	int i;
+
+	if (!src || !dst ||
+	    (src->dst.protonum != IPPROTO_TCP &&
+	     src->dst.protonum != IPPROTO_UDP))
+		return false;
+
+	memset(dst, 0, sizeof(*dst));
+	dst->family = src->src.l3num;
+	dst->protonum = src->dst.protonum;
+	dst->sport = ntohs(src->src.u.all);
+	dst->dport = ntohs(src->dst.u.all);
+
+	switch (dst->family) {
+	case AF_INET:
+		dst->v4.src = ntohl(src->src.u3.ip);
+		dst->v4.dst = ntohl(src->dst.u3.ip);
+		return true;
+	case AF_INET6:
+		for (i = 0; i < ARRAY_SIZE(dst->v6.src); i++) {
+			dst->v6.src[i] = ntohl(src->src.u3.ip6[i]);
+			dst->v6.dst[i] = ntohl(src->dst.u3.ip6[i]);
+		}
+		return true;
+	default:
+		return false;
+	}
+}
+
+static void hnat_flowctl_hash_key(const struct hnat_flowctl_tuple *tuple,
+				  struct foe_entry *key)
+{
+	memset(key, 0, sizeof(*key));
+	key->bfib1.udp = tuple->protonum == IPPROTO_UDP;
+
+	if (tuple->family == AF_INET) {
+		key->bfib1.pkt_type = IPV4_HNAPT;
+		key->ipv4_hnapt.sip = tuple->v4.src;
+		key->ipv4_hnapt.dip = tuple->v4.dst;
+		key->ipv4_hnapt.sport = tuple->sport;
+		key->ipv4_hnapt.dport = tuple->dport;
+		return;
+	}
+
+	key->bfib1.pkt_type = IPV6_5T_ROUTE;
+	key->ipv6_5t_route.ipv6_sip0 = tuple->v6.src[0];
+	key->ipv6_5t_route.ipv6_sip1 = tuple->v6.src[1];
+	key->ipv6_5t_route.ipv6_sip2 = tuple->v6.src[2];
+	key->ipv6_5t_route.ipv6_sip3 = tuple->v6.src[3];
+	key->ipv6_5t_route.ipv6_dip0 = tuple->v6.dst[0];
+	key->ipv6_5t_route.ipv6_dip1 = tuple->v6.dst[1];
+	key->ipv6_5t_route.ipv6_dip2 = tuple->v6.dst[2];
+	key->ipv6_5t_route.ipv6_dip3 = tuple->v6.dst[3];
+	key->ipv6_5t_route.sport = tuple->sport;
+	key->ipv6_5t_route.dport = tuple->dport;
+}
+
+static bool hnat_flowctl_proto_match(const struct foe_entry *entry,
+				     const struct hnat_flowctl_tuple *tuple)
+{
+	return !!entry->bfib1.udp == (tuple->protonum == IPPROTO_UDP);
+}
+
+static bool hnat_flowctl_v6_5t_match(const struct foe_entry *entry,
+				     const struct hnat_flowctl_tuple *tuple)
+{
+	return entry->ipv6_5t_route.ipv6_sip0 == tuple->v6.src[0] &&
+	       entry->ipv6_5t_route.ipv6_sip1 == tuple->v6.src[1] &&
+	       entry->ipv6_5t_route.ipv6_sip2 == tuple->v6.src[2] &&
+	       entry->ipv6_5t_route.ipv6_sip3 == tuple->v6.src[3] &&
+	       entry->ipv6_5t_route.ipv6_dip0 == tuple->v6.dst[0] &&
+	       entry->ipv6_5t_route.ipv6_dip1 == tuple->v6.dst[1] &&
+	       entry->ipv6_5t_route.ipv6_dip2 == tuple->v6.dst[2] &&
+	       entry->ipv6_5t_route.ipv6_dip3 == tuple->v6.dst[3] &&
+	       entry->ipv6_5t_route.sport == tuple->sport &&
+	       entry->ipv6_5t_route.dport == tuple->dport;
+}
+
+static bool hnat_flowctl_v6_hnapt_match(const struct foe_entry *entry,
+				       const struct hnat_flowctl_tuple *tuple)
+{
+	return entry->ipv6_hnapt.ipv6_sip0 == tuple->v6.src[0] &&
+	       entry->ipv6_hnapt.ipv6_sip1 == tuple->v6.src[1] &&
+	       entry->ipv6_hnapt.ipv6_sip2 == tuple->v6.src[2] &&
+	       entry->ipv6_hnapt.ipv6_sip3 == tuple->v6.src[3] &&
+	       entry->ipv6_hnapt.ipv6_dip0 == tuple->v6.dst[0] &&
+	       entry->ipv6_hnapt.ipv6_dip1 == tuple->v6.dst[1] &&
+	       entry->ipv6_hnapt.ipv6_dip2 == tuple->v6.dst[2] &&
+	       entry->ipv6_hnapt.ipv6_dip3 == tuple->v6.dst[3] &&
+	       entry->ipv6_hnapt.sport == tuple->sport &&
+	       entry->ipv6_hnapt.dport == tuple->dport;
+}
+
+/* The hash identifies only one four-entry collision bucket.  Revalidate the
+ * complete ingress tuple while holding entry_lock before invalidating a BIND
+ * entry; this prevents a stale index or hash collision from evicting an
+ * unrelated accelerated connection. */
+static bool hnat_flowctl_entry_match(const struct foe_entry *entry,
+				     const struct hnat_flowctl_tuple *tuple)
+{
+	if (entry->bfib1.state != BIND ||
+	    !hnat_flowctl_proto_match(entry, tuple))
+		return false;
+
+	if (tuple->family == AF_INET)
+		return entry->bfib1.pkt_type == IPV4_HNAPT &&
+		       entry->ipv4_hnapt.sip == tuple->v4.src &&
+		       entry->ipv4_hnapt.dip == tuple->v4.dst &&
+		       entry->ipv4_hnapt.sport == tuple->sport &&
+		       entry->ipv4_hnapt.dport == tuple->dport;
+
+	if (tuple->family != AF_INET6)
+		return false;
+
+	switch (entry->bfib1.pkt_type) {
+	case IPV6_5T_ROUTE:
+		return hnat_flowctl_v6_5t_match(entry, tuple);
+	case IPV6_HNAPT:
+	case IPV6_HNAT:
+		return hnat_flowctl_v6_hnapt_match(entry, tuple);
+	default:
+		return false;
+	}
+}
+
+static unsigned int
+hnat_flowctl_kick_tuple(struct mtk_hnat *h, u32 ppe_index,
+			const struct hnat_flowctl_tuple *tuple)
+{
+	struct foe_entry key;
+	struct foe_entry *entry;
+	u32 entry_count;
+	u32 hash;
+	u32 slot;
+	unsigned int deleted = 0;
+
+	if (!hnat_api_ppe_ready(h, ppe_index))
+		return 0;
+
+	entry_count = READ_ONCE(h->foe_etry_num_ppe[ppe_index]);
+	hnat_flowctl_hash_key(tuple, &key);
+	hash = hnat_get_ppe_hash_by_count(&key, entry_count);
+	hash &= ~(HNAT_FLOWCTL_COLLISION_SLOTS - 1);
+
+	spin_lock_bh(&h->entry_lock);
+	for (slot = 0; slot < HNAT_FLOWCTL_COLLISION_SLOTS &&
+	     hash + slot < entry_count; slot++) {
+		entry = h->foe_table_cpu[ppe_index] + hash + slot;
+		if (!hnat_flowctl_entry_match(entry, tuple))
+			continue;
+		__entry_delete(h, entry);
+		deleted++;
+	}
+	spin_unlock_bh(&h->entry_lock);
+
+	return deleted;
+}
+
+static void hnat_flowctl_kick_work(struct work_struct *work)
+{
+	struct hnat_flowctl_work *request =
+		container_of(work, struct hnat_flowctl_work, work);
+	struct mtk_hnat *h = request->h;
+	unsigned int total = 0;
+	unsigned int deleted;
+	u32 ppe_index;
+	u8 tuple_index;
+
+	if (!hnat_api_ready(h))
+		goto out;
+
+	for (ppe_index = 0; ppe_index < READ_ONCE(h->ppe_num); ppe_index++) {
+		deleted = 0;
+		for (tuple_index = 0; tuple_index < request->tuple_count;
+		     tuple_index++)
+			deleted += hnat_flowctl_kick_tuple(h, ppe_index,
+						       &request->tuple[tuple_index]);
+		if (deleted)
+			hnat_cache_clr(ppe_index);
+		total += deleted;
+	}
+
+	if (total)
+		atomic64_add(total, &h->flowctl_kick_deleted);
+	else
+		atomic64_inc(&h->flowctl_kick_miss);
+out:
+	kfree(request);
+}
+
+int mtk_hnat_kick_conntrack(struct nf_conn *ct)
+{
+	struct hnat_flowctl_work *request;
+	struct workqueue_struct *wq;
+	struct mtk_hnat *h;
+	u8 count = 0;
+	int direction;
+	int ret = 0;
+
+	if (!ct)
+		return -EINVAL;
+
+	h = READ_ONCE(hnat_priv);
+	if (!hnat_api_ready(h))
+		return -ENODEV;
+
+	request = kzalloc(sizeof(*request), GFP_ATOMIC);
+	if (!request) {
+		atomic64_inc(&h->flowctl_kick_alloc_fail);
+		return -ENOMEM;
+	}
+
+	for (direction = IP_CT_DIR_ORIGINAL;
+	     direction < IP_CT_DIR_MAX; direction++) {
+		if (hnat_flowctl_tuple_copy(
+			    &ct->tuplehash[direction].tuple,
+			    &request->tuple[count]))
+			count++;
+	}
+	if (!count) {
+		atomic64_inc(&h->flowctl_kick_unsupported);
+		kfree(request);
+		return -EOPNOTSUPP;
+	}
+
+	INIT_WORK(&request->work, hnat_flowctl_kick_work);
+	request->h = h;
+	request->tuple_count = count;
+
+	/* Serialize queue_work() against teardown swapping the private queue to
+	 * NULL.  The ready check is repeated under the same lock so an API caller
+	 * that raced with warm reset cannot touch a destroyed workqueue. */
+	spin_lock_bh(&h->flowctl_lock);
+	wq = READ_ONCE(h->flowctl_wq);
+	if (!hnat_api_ready(h) || !wq) {
+		ret = -ESHUTDOWN;
+	} else if (!queue_work(wq, &request->work)) {
+		ret = -EBUSY;
+	} else {
+		atomic64_inc(&h->flowctl_kick_queued);
+	}
+	spin_unlock_bh(&h->flowctl_lock);
+
+	if (ret)
+		kfree(request);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_hnat_kick_conntrack);
+
+int hnat_flowctl_init(struct mtk_hnat *h)
+{
+	struct workqueue_struct *wq;
+
+	if (!h)
+		return -EINVAL;
+	wq = alloc_ordered_workqueue("mtk_hnat_flowctl", WQ_MEM_RECLAIM);
+	if (!wq)
+		return -ENOMEM;
+
+	spin_lock_bh(&h->flowctl_lock);
+	if (WARN_ON_ONCE(h->flowctl_wq)) {
+		spin_unlock_bh(&h->flowctl_lock);
+		destroy_workqueue(wq);
+		return -EALREADY;
+	}
+	WRITE_ONCE(h->flowctl_wq, wq);
+	spin_unlock_bh(&h->flowctl_lock);
+	return 0;
+}
+
+void hnat_flowctl_flush(struct mtk_hnat *h)
+{
+	struct workqueue_struct *wq;
+
+	if (!h)
+		return;
+	spin_lock_bh(&h->flowctl_lock);
+	wq = READ_ONCE(h->flowctl_wq);
+	spin_unlock_bh(&h->flowctl_lock);
+	if (wq)
+		flush_workqueue(wq);
+}
+
+void hnat_flowctl_deinit(struct mtk_hnat *h)
+{
+	struct workqueue_struct *wq;
+
+	if (!h)
+		return;
+	spin_lock_bh(&h->flowctl_lock);
+	wq = READ_ONCE(h->flowctl_wq);
+	WRITE_ONCE(h->flowctl_wq, NULL);
+	spin_unlock_bh(&h->flowctl_lock);
+	if (wq)
+		destroy_workqueue(wq);
+}
+
+void hnat_flowctl_note_admission_denied(struct mtk_hnat *h)
+{
+	if (h)
+		atomic64_inc(&h->flowctl_admission_denied);
+}
