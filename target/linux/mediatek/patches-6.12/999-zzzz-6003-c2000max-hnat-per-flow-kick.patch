+static int hnat_flowctl_status_show(struct seq_file *m, void *private)
+{
+	struct mtk_hnat *h = m->private;
+
+	if (!h)
+		return -ENODEV;
+	seq_puts(m, "architecture=per-flow-p1\n");
+	seq_printf(m, "ready=%u\n", hnat_api_ready(h));
+	seq_printf(m, "workqueue=%s\n",
+		   READ_ONCE(h->flowctl_wq) ? "active" : "disabled");
+	seq_printf(m, "admission_denied=%lld\n",
+		   atomic64_read(&h->flowctl_admission_denied));
+	seq_printf(m, "kick_queued=%lld\n",
+		   atomic64_read(&h->flowctl_kick_queued));
+	seq_printf(m, "kick_deleted=%lld\n",
+		   atomic64_read(&h->flowctl_kick_deleted));
+	seq_printf(m, "kick_miss=%lld\n",
+		   atomic64_read(&h->flowctl_kick_miss));
+	seq_printf(m, "kick_alloc_fail=%lld\n",
+		   atomic64_read(&h->flowctl_kick_alloc_fail));
+	seq_printf(m, "kick_unsupported=%lld\n",
+		   atomic64_read(&h->flowctl_kick_unsupported));
+	return 0;
+}
+
+static int hnat_flowctl_status_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, hnat_flowctl_status_show, inode->i_private);
+}
