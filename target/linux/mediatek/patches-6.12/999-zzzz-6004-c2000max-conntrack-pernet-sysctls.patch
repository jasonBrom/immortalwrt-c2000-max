From: C2000MAX maintainers <maintainers@c2000max.invalid>
Subject: [PATCH] netfilter: keep vendor conntrack sysctls per network namespace

Both vendor sysctls are registered for every network namespace.  Pointing a
non-init namespace at init_net or at a static module variable trips the kernel
sysctl validation and makes namespace creation noisy.  Store the TCP switch in
nf_tcp_net and bind both table entries to their owning namespace.

--- a/include/net/netns/conntrack.h
+++ b/include/net/netns/conntrack.h
@@ -24,4 +24,5 @@ struct nf_tcp_net {
 	unsigned int timeouts[TCP_CONNTRACK_TIMEOUT_MAX];
+	unsigned int tcp_no_window_check;
 	u8 tcp_loose;
 	u8 tcp_be_liberal;
 	u8 tcp_max_retrans;
--- a/net/netfilter/nf_conntrack_proto_tcp.c
+++ b/net/netfilter/nf_conntrack_proto_tcp.c
@@ -31,9 +31,6 @@
 #include <net/netfilter/ipv4/nf_conntrack_ipv4.h>
 #include <net/netfilter/ipv6/nf_conntrack_ipv6.h>
 
-/* Do not check the TCP window for incoming packets  */
-static int nf_ct_tcp_no_window_check __read_mostly = 1;
-
   /* FIXME: Examine ipfilter's timeouts and conntrack transitions more
      closely.  They're more complex. --RR */
 
@@ -514,6 +511,7 @@ tcp_in_window(struct nf_conn *ct, enum i
 	      const struct nf_hook_state *hook_state)
 {
 	struct ip_ct_tcp *state = &ct->proto.tcp;
+	const struct nf_tcp_net *tn = nf_tcp_pernet(nf_ct_net(ct));
 	struct ip_ct_tcp_state *sender = &state->seen[dir];
 	struct ip_ct_tcp_state *receiver = &state->seen[!dir];
 	__u32 seq, ack, sack, end, win, swin;
@@ -523,7 +521,7 @@ tcp_in_window(struct nf_conn *ct, enum i
 	s32 receiver_offset;
 	u16 win_raw;
 
-	if (nf_ct_tcp_no_window_check)
+	if (tn->tcp_no_window_check)
 		return NFCT_TCP_ACCEPT;
 
 	/*
@@ -1292,7 +1290,7 @@ int nf_conntrack_tcp_packet(struct nf_co
 		 IP_CT_TCP_FLAG_DATA_UNACKNOWLEDGED &&
 		 timeouts[new_state] > timeouts[TCP_CONNTRACK_UNACK])
 		timeout = timeouts[TCP_CONNTRACK_UNACK];
-	else if (!nf_ct_tcp_no_window_check && ct->proto.tcp.last_win == 0 &&
+	else if (!tn->tcp_no_window_check && ct->proto.tcp.last_win == 0 &&
 		 timeouts[new_state] > timeouts[TCP_CONNTRACK_RETRANS])
 		timeout = timeouts[TCP_CONNTRACK_RETRANS];
 	else
@@ -1595,6 +1593,7 @@ void nf_conntrack_tcp_init_net(struct ne
 	 * connections.
 	 */
 	tn->tcp_loose = 1;
+	tn->tcp_no_window_check = 1;
 
 	/* "Be conservative in what you do,
 	 *  be liberal in what you accept from others."
--- a/net/netfilter/nf_conntrack_standalone.c
+++ b/net/netfilter/nf_conntrack_standalone.c
@@ -26,9 +26,6 @@
 #include <net/netfilter/nf_conntrack_timestamp.h>
 #include <linux/rculist_nulls.h>
 
-/* Do not check the TCP window for incoming packets  */
-static int nf_ct_tcp_no_window_check __read_mostly = 1;
-
 static bool enable_hooks __read_mostly;
 MODULE_PARM_DESC(enable_hooks, "Always enable conntrack hooks");
 module_param(enable_hooks, bool, 0000);
@@ -1032,7 +1029,6 @@ static struct ctl_table nf_ct_sysctl_tab
 #endif
 	[NF_SYSCTL_CT_PROTO_TCP_NO_WINDOW_CHECK] = {
 		.procname       = "nf_conntrack_tcp_no_window_check",
-		.data           = &nf_ct_tcp_no_window_check,
 		.maxlen         = sizeof(unsigned int),
 		.mode           = 0644,
 		.proc_handler   = proc_dointvec,
@@ -1078,6 +1074,7 @@ static void nf_conntrack_standalone_init
 	XASSIGN(LIBERAL, &tn->tcp_be_liberal);
 	XASSIGN(MAX_RETRANS, &tn->tcp_max_retrans);
 	XASSIGN(IGNORE_INVALID_RST, &tn->tcp_ignore_invalid_rst);
+	XASSIGN(NO_WINDOW_CHECK, &tn->tcp_no_window_check);
 #undef XASSIGN
 
 #if IS_ENABLED(CONFIG_NF_FLOW_TABLE)
@@ -1160,6 +1157,7 @@ static int nf_conntrack_standalone_init_
 	table[NF_SYSCTL_CT_CHECKSUM].data = &net->ct.sysctl_checksum;
 	table[NF_SYSCTL_CT_LOG_INVALID].data = &net->ct.sysctl_log_invalid;
 	table[NF_SYSCTL_CT_ACCT].data = &net->ct.sysctl_acct;
+	table[NF_SYSCTL_CT_QOS].data = &net->ct.sysctl_qos;
 #ifdef CONFIG_NF_CONNTRACK_EVENTS
 	table[NF_SYSCTL_CT_EVENTS].data = &net->ct.sysctl_events;
 #endif
