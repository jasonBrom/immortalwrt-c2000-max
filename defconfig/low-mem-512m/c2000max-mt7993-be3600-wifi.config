# C2000-MAX uses the same MT7990AN + MT7976CN dual-band radio module
# (PCI ID 14c3:7993) as the GL.iNet GL-MT3600BE.  Use the MTK Wi-Fi 7
# split-MAC stack so WED/WARP and vendor HNAT can accelerate Wi-Fi traffic.

CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_kmod-warp=y
CONFIG_PACKAGE_kmod-mt_wifi7=y
CONFIG_PACKAGE_kmod-mt_wifi_osal=y
CONFIG_PACKAGE_kmod-mt_hwifi=y
CONFIG_PACKAGE_kmod-mtk_pci=y
CONFIG_PACKAGE_kmod-mtk_wed=y
CONFIG_PACKAGE_kmod-connac_if=y
CONFIG_PACKAGE_kmod-mt7993=y
# CONFIG_PACKAGE_kmod-mt7993_dbg is not set

CONFIG_WARP_CONFIG_MODE=1
CONFIG_WARP_VERSION="3_1"
CONFIG_WARP_CHIPSET="mt7987"
CONFIG_WARP_DBG_SUPPORT=y
CONFIG_WARP_BM_SHRINK_RING=y
CONFIG_MTK_HWIFI_PCI_SUPPORT=y
CONFIG_MTK_HWIFI_CONNAC_IF_SUPPORT=y
CONFIG_MTK_HWIFI_WED_SUPPORT=y
CONFIG_MTK_HWIFI_MT7993=y
CONFIG_MTK_HWIFI_MT7993_RRO_MODE=5
CONFIG_MTK_HWIFI_MT7993_OPTION_TYPE=5
CONFIG_MTK_HWIFI_MT7993_INTR_OPTION_SET=0
CONFIG_MTK_HWIFI_MEM_SHRINK=y
# CONFIG_MTK_HWIFI_MT799B is not set

CONFIG_MTK_WIFI7_MT_WIFI=m
CONFIG_MTK_WIFI7_SUPPORT_OPENWRT=y
CONFIG_MTK_WIFI7_DRIVER=y
CONFIG_MTK_WIFI7_MT_WIFI_PATH="mt_wifi"
CONFIG_MTK_WIFI7_MODE_AP=m
CONFIG_MTK_WIFI7_MT_AP_SUPPORT=m
CONFIG_MTK_WIFI7_UNIFIED_COMMAND=y
CONFIG_MTK_WIFI7_DOT11_N_SUPPORT=y
CONFIG_MTK_WIFI7_DOT11_AX_SUPPORT=y
CONFIG_MTK_WIFI7_DOT11_BE_SUPPORT=y
CONFIG_MTK_WIFI7_MT_MAC=y
CONFIG_MTK_WIFI7_HWIFI_SUPPORT=y
CONFIG_MTK_WIFI7_FIRST_IF_RF_OFFSET=0xc0000
CONFIG_MTK_WIFI7_SECOND_IF_RF_OFFSET=0xc8000
CONFIG_MTK_WIFI7_RT_FIRST_IF_RF_OFFSET=0xc0000
CONFIG_MTK_WIFI7_RT_SECOND_IF_RF_OFFSET=0xc8000
CONFIG_MTK_WIFI7_RT_THIRD_IF_RF_OFFSET=0xd0000
CONFIG_MTK_WIFI7_FIRST_IF_EEPROM_FLASH=y
CONFIG_MTK_WIFI7_MULTI_INF_SUPPORT=y
CONFIG_MTK_WIFI7_BASIC_FUNC=y
CONFIG_MTK_WIFI7_DOT11_VHT_AC=y
CONFIG_MTK_WIFI7_DOT11_HE_AX=y
CONFIG_MTK_WIFI7_DOT11_EHT_BE=y
CONFIG_MTK_WIFI7_WIFI_TWT_SUPPORT=y
CONFIG_MTK_WIFI7_DBDC_MODE=y
CONFIG_MTK_WIFI7_CFG_SUPPORT_FALCON_MURU=y
CONFIG_MTK_WIFI7_CFG_SUPPORT_FALCON_TXCMD_DBG=y
CONFIG_MTK_WIFI7_CFG_SUPPORT_FALCON_SR=y
CONFIG_MTK_WIFI7_CFG_SUPPORT_FALCON_PP=y
CONFIG_MTK_WIFI7_G_BAND_256QAM_SUPPORT=y
CONFIG_MTK_WIFI7_TPC_SUPPORT=y
CONFIG_MTK_WIFI7_ICAP_SUPPORT=y
CONFIG_MTK_WIFI7_SPECTRUM_SUPPORT=y
CONFIG_MTK_WIFI7_BACKGROUND_SCAN_SUPPORT=y
CONFIG_MTK_WIFI7_SMART_CARRIER_SENSE_SUPPORT=y
CONFIG_MTK_WIFI7_SCS_FW_OFFLOAD=y
CONFIG_MTK_WIFI7_MT_DFS_SUPPORT=y
CONFIG_MTK_WIFI7_OFFCHANNEL_SCAN_FEATURE=y
CONFIG_MTK_WIFI7_HDR_TRANS_TX_SUPPORT=y
CONFIG_MTK_WIFI7_HDR_TRANS_RX_SUPPORT=y
CONFIG_MTK_WIFI7_WSC_INCLUDED=y
CONFIG_MTK_WIFI7_WSC_V2_SUPPORT=y
CONFIG_MTK_WIFI7_DOT11W_PMF_SUPPORT=y
CONFIG_MTK_WIFI7_TXBF_SUPPORT=y
CONFIG_MTK_WIFI7_FAST_NAT_SUPPORT=y
CONFIG_MTK_WIFI7_WLAN_HOOK=y
CONFIG_MTK_WIFI7_WHNAT_SUPPORT=m
CONFIG_MTK_WIFI7_WARP_V2=y
CONFIG_MTK_WIFI7_RTMP_FLASH_SUPPORT=y
CONFIG_MTK_WIFI7_CAL_BIN_FILE_SUPPORT=y
CONFIG_MTK_WIFI7_ATE_SUPPORT=y
CONFIG_MTK_WIFI7_WLAN_SERVICE=y
CONFIG_MTK_WIFI7_PASSPOINT_R2=y
CONFIG_MTK_WIFI7_MBO_SUPPORT=y
CONFIG_MTK_WIFI7_OCE_SUPPORT=y
CONFIG_MTK_WIFI7_FTM_SUPPORT=y
CONFIG_MTK_WIFI7_EAP_QUICK_CHANNEL_SWITCH_WITHOUT_CSA=y
CONFIG_MTK_WIFI7_CFG80211_SUPPORT=y
CONFIG_MTK_WIFI7_CFG80211_FULL_OPS_SUPPORT=y
CONFIG_MTK_WIFI7_HOSTAPD_MBSS_SUPPORT=y
CONFIG_MTK_WIFI7_APCLI_SUPPLICANT_SUPPORT=y
CONFIG_MTK_WIFI7_MAP_SUPPORT=y
CONFIG_MTK_WIFI7_MAP_R2_VER_SUPPORT=y
CONFIG_MTK_WIFI7_UAPSD=y
CONFIG_MTK_WIFI7_HIGH_PRIO_QUEUE_SUPPORT=y
CONFIG_MTK_WIFI7_CTXD_MEM_CPY_SUPPORT=y
CONFIG_MTK_WIFI7_OSAL_SUPPORT=y
CONFIG_MTK_WIFI7_RTMP_PCI_SUPPORT=y
CONFIG_MTK_WIFI7_WDS_SUPPORT=y
CONFIG_MTK_WIFI7_MBSS_SUPPORT=y
CONFIG_MTK_WIFI7_APCLI_SUPPORT=y
CONFIG_MTK_WIFI7_APCLI_CERT_SUPPORT=y
CONFIG_MTK_WIFI7_MAC_REPEATER_SUPPORT=y
CONFIG_MTK_WIFI7_MWDS=y
CONFIG_MTK_WIFI7_MUMIMO_SUPPORT=y
CONFIG_MTK_WIFI7_MU_RA_SUPPORT=y
CONFIG_MTK_WIFI7_DOT11R_FT_SUPPORT=y
CONFIG_MTK_WIFI7_DOT11K_RRM_SUPPORT=y
CONFIG_MTK_WIFI7_MLME_MULTI_QUEUE_SUPPORT=y
CONFIG_MTK_WIFI7_EAP_FEATURE=y
CONFIG_MTK_WIFI7_VLAN_SUPPORT=y
CONFIG_MTK_WIFI7_ANTENNA_CONTROL_SUPPORT=y
CONFIG_MTK_WIFI7_MGMT_TXPWR_CTRL=y
CONFIG_MTK_WIFI7_RA_PHY_RATE_SUPPORT=y
CONFIG_MTK_WIFI7_AMPDU_CONF_SUPPORT=y
CONFIG_MTK_WIFI7_ACK_CTS_TIMEOUT_SUPPORT=y
CONFIG_MTK_WIFI7_TX_LATENCY_SUPPORT=y
CONFIG_MTK_WIFI7_DSCP_PRI_SUPPORT=y
CONFIG_MTK_WIFI7_QOS_R1_SUPPORT=y
CONFIG_MTK_WIFI7_CON_WPS_SUPPORT=y
CONFIG_MTK_WIFI7_MCAST_RATE_SPECIFIC=y
CONFIG_MTK_WIFI7_BAND_STEERING=y
CONFIG_MTK_WIFI7_GREENAP_SUPPORT=y
CONFIG_MTK_WIFI7_PCIE_ASPM_DYM_CTRL_SUPPORT=y
CONFIG_MTK_WIFI7_AIR_MONITOR=y
CONFIG_MTK_WIFI7_WNM_SUPPORT=y
CONFIG_MTK_WIFI7_INTERWORKING=y
CONFIG_MTK_WIFI7_WPA3_SUPPORT=y
CONFIG_MTK_WIFI7_OWE_SUPPORT=y
CONFIG_MTK_WIFI7_RSNO_SUPPORT=y
CONFIG_MTK_WIFI7_SINGLE_SKU=y
CONFIG_MTK_WIFI7_TR181_SUPPORT=y
CONFIG_MTK_WIFI7_CSI_SUPPORT=y
CONFIG_MTK_WIFI7_IGMP_SNOOP_SUPPORT=y
# CONFIG_MTK_WIFI7_RED_SUPPORT is not set
# CONFIG_MTK_WIFI7_VOW_SUPPORT is not set
# CONFIG_MTK_WIFI7_RTMP_WLAN_HOOK_SUPPORT is not set
CONFIG_MTK_WIFI7_FIRST_IF_IPAILNA=y
CONFIG_MTK_WIFI7_SECOND_IF_EPAELNA=y
CONFIG_MTK_WIFI7_CHIP_MT7993=y
CONFIG_MTK_WIFI7_FIRST_IF_MT7993=y
CONFIG_MTK_WIFI7_SECOND_IF_MT7993=y
CONFIG_MTK_WIFI7_THIRD_IF_NONE=y
CONFIG_MTK_WIFI7_MULTI_PROFILE_SUPPORT=y
CONFIG_MTK_WIFI7_SKU_TYPE="BE3600"
CONFIG_MTK_WIFI7_FW_LOG_TYPE="string_log"

CONFIG_first_card=y
CONFIG_first_card_name="MT7993"
CONFIG_first_card_profile_path="/etc/wireless/mediatek/mt7993.1.dat"
CONFIG_first_card_init_script="/lib/wifi/mtwifi.lua"
CONFIG_first_card_init_compatible="mtwifi"
CONFIG_first_card_EEPROM_offset="0x0"
CONFIG_first_card_EEPROM_size="0x14a800"
CONFIG_first_card_EEPROM_name="e2p"
CONFIG_first_card_EEPROM_def_bin_path="/lib/firmware/MT7993_EEPROM.bin"
CONFIG_first_card_main_ifname="ra0;rai0"
CONFIG_first_card_ext_ifname="ra;rai"
CONFIG_first_card_wds_ifname="wds;wdsi"
CONFIG_first_card_apcli_ifname="apcli;apclii"
CONFIG_first_card_mesh_ifname="mesh;meshi"
CONFIG_first_card_nvram_zone="dev00;dev01"
CONFIG_first_card_single_sku_path="/rom/etc/wireless/mediatek/mt7993-sku.dat"
CONFIG_first_card_bf_sku_path="/rom/etc/wireless/mediatek/mt7993-sku-bf.dat"
# CONFIG_second_card is not set
# CONFIG_third_card is not set

CONFIG_PACKAGE_mwctl=y
CONFIG_PACKAGE_datconf=y
CONFIG_PACKAGE_ucode-mod-datconf=y
CONFIG_PACKAGE_ucode-mod-l1parser=y
CONFIG_PACKAGE_mtkhnat_util=y
CONFIG_PACKAGE_mtwifi-cfg-ucode=y
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-i18n-mtwifi-cfg-zh-cn=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y
CONFIG_PACKAGE_luci-app-eqos-mtk=y
CONFIG_PACKAGE_luci-i18n-eqos-mtk-zh-cn=y
CONFIG_PACKAGE_mt5700-web-go=y
CONFIG_PACKAGE_luci-app-mt5700-web=y
CONFIG_PACKAGE_wifi-profile=y
# CONFIG_WIFI_SCRIPT_SUPPORT is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_hostapd-utils=y
CONFIG_PACKAGE_wpa-cli=y

# V35: reliable asynchronous port switching, ZRAM and device access control.
# c2000max-board depends on flock as a hard runtime requirement.
CONFIG_PACKAGE_flock=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZO=y

CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All=y
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy is not set
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin=y
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client is not set
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y

CONFIG_PACKAGE_conntrack=y
