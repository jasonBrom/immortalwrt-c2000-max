diff --git a/net/daed/Makefile b/net/daed/Makefile
index f50da4a..7de2b1f 100644
--- a/net/daed/Makefile
+++ b/net/daed/Makefile
@@ -23,6 +23,11 @@ PKG_BUILD_PARALLEL:=1
 PKG_BUILD_FLAGS:=no-mips16
 
 GO_PKG:=github.com/daeuniverse/dae-wing
+GO_PKG_INSTALL_EXTRA:= \
+	dae-core/control/bpf_subobjects.tmpl \
+	dae-core/control/bpf_.*[.]o \
+	dae-core/trace/bpf_.*[.]o \
+	webrender/web
 GO_PKG_LDFLAGS:= \
 	-X '$(GO_PKG)/db.AppDescription=$(PKG_NAME) is a integration solution of dae, API and UI.'
 GO_PKG_LDFLAGS_X= \
@@ -129,6 +134,7 @@ define Build/Compile
 		go generate control/control.go ; \
 		go generate trace/trace.go ; \
 		popd ; \
+		$(call GoPackage/Build/Configure) ; \
 		$(call GoPackage/Build/Compile) ; \
 	)
 endef
diff --git a/net/daed/files/daed.config b/net/daed/files/daed.config
index 3072cd6..f183cb3 100644
--- a/net/daed/files/daed.config
+++ b/net/daed/files/daed.config
@@ -1,7 +1,7 @@
 
 config daed 'config'
 	option enabled '0'
 	option listen_addr '0.0.0.0:2023'
-	option log_maxbackups '1'
-	option log_maxsize '5'
+	option log_maxbackups '0'
+	option log_maxsize '1'
 
diff --git a/net/daed/files/daed.init b/net/daed/files/daed.init
index a35a154..a42a75e 100644
--- a/net/daed/files/daed.init
+++ b/net/daed/files/daed.init
@@ -15,10 +15,13 @@ start_service() {
 	config_get_bool enabled "config" "enabled" "0"
 	[ "$enabled" -eq "1" ] || return 1
 
+	# Release BPF/TC references left by an interrupted former instance.
+	[ ! -x /usr/sbin/c2000max-daed-cleanup ] ||
+		/usr/sbin/c2000max-daed-cleanup >/dev/null 2>&1 || return 1
 	local listen_addr log_maxbackups log_maxsize
 	config_get listen_addr "config" "listen_addr" "0.0.0.0:2023"
-	config_get log_maxbackups "config" "log_maxbackups" "1"
-	config_get log_maxsize "config" "log_maxsize" "5"
+	config_get log_maxbackups "config" "log_maxbackups" "0"
+	config_get log_maxsize "config" "log_maxsize" "1"
 
 	procd_open_instance "$CONF"
 	procd_set_param command "$PROG" run
@@ -28,7 +31,7 @@ start_service() {
 	procd_append_param command --logfile-maxbackups "$log_maxbackups"
 	procd_append_param command --logfile-maxsize "$log_maxsize"
 
-	procd_set_param limits core="unlimited"
+	procd_set_param limits core="0 0"
 	procd_set_param limits nofile="1000000 1000000"
 	procd_set_param respawn
 	# procd_set_param stdout 1
@@ -41,6 +44,11 @@ stop_service() {
 	rm -f "$LOG"
 }
 
+service_stopped() {
+	[ ! -x /usr/sbin/c2000max-daed-cleanup ] ||
+		/usr/sbin/c2000max-daed-cleanup >/dev/null 2>&1 || true
+}
+
 service_triggers() {
 	procd_add_reload_trigger "$CONF"
 }
