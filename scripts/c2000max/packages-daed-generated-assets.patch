diff --git a/net/daed/files/daed.init b/net/daed/files/daed.init
old mode 100644
new mode 100755
index baa7288..e26ad65
--- a/net/daed/files/daed.init
+++ b/net/daed/files/daed.init
@@ -8,6 +8,28 @@ CONF="daed"
 PROG="/usr/bin/daed"
 LOG="/var/log/daed/daed.log"
 
+daed_running() {
+	local proc exe
+	for proc in /proc/[0-9]*; do
+		[ "$proc" != "/proc/$$" ] || continue
+		exe="$(readlink -f "$proc/exe" 2>/dev/null)" || continue
+		[ "$exe" = "$PROG" ] && return 0
+	done
+	return 1
+}
+
+wait_daed_stopped() {
+	local attempts=0
+	while daed_running; do
+		attempts=$((attempts + 1))
+		if [ "$attempts" -ge 10 ]; then
+			logger -t daed "previous daed process did not stop within 10 seconds"
+			return 1
+		fi
+		sleep 1
+	done
+}
+
 start_service() {
 	config_load "$CONF"
 
@@ -15,20 +37,42 @@ start_service() {
 	config_get_bool enabled "config" "enabled" "0"
 	[ "$enabled" -eq "1" ] || return 1
 
+	# Always create the persistent database directory and tmpfs log first, so
+	# LuCI can distinguish a stopped service from a missing log path.
+	mkdir -p /etc/daed /var/log/daed || return 1
+	touch "$LOG" || return 1
+	chmod 0755 /etc/daed /var/log/daed
+	chmod 0644 "$LOG"
+
+	# A config reload may call start before procd has fully reaped the old
+	# daemon.  Match /proc/<pid>/exe exactly so the rc.common wrapper and helper
+	# scripts cannot be mistaken for daed while waiting for that daemon.
+	wait_daed_stopped || return 1
+
+	# Release BPF/TC references left by an interrupted former instance.
+	[ ! -x /usr/sbin/c2000max-daed-cleanup ] ||
+		/usr/sbin/c2000max-daed-cleanup >/dev/null 2>&1 || {
+			logger -t daed "unable to clean stale BPF/TC state"
+			return 1
+		}
 	local listen_addr log_maxbackups log_maxsize
 	config_get listen_addr "config" "listen_addr" "0.0.0.0:2023"
-	config_get log_maxbackups "config" "log_maxbackups" "1"
-	config_get log_maxsize "config" "log_maxsize" "5"
+	config_get log_maxbackups "config" "log_maxbackups" "0"
+	config_get log_maxsize "config" "log_maxsize" "1"
 
 	procd_open_instance "$CONF"
-	procd_set_param command "$PROG" run
+	if [ -x /usr/sbin/c2000max-daed-hybrid ]; then
+		procd_set_param command /usr/sbin/c2000max-daed-hybrid run "$PROG" run
+	else
+		procd_set_param command "$PROG" run
+	fi
 	procd_append_param command --config "/etc/daed/"
 	procd_append_param command --listen "$listen_addr"
 	procd_append_param command --logfile "$LOG"
 	procd_append_param command --logfile-maxbackups "$log_maxbackups"
 	procd_append_param command --logfile-maxsize "$log_maxsize"
 
-	procd_set_param limits core="unlimited"
+	procd_set_param limits core="0 0"
 	procd_set_param limits nofile="1000000 1000000"
 	procd_set_param respawn
 	# procd_set_param stdout 1
@@ -38,7 +82,15 @@ start_service() {
 }
 
 stop_service() {
-	rm -f "$LOG"
+	# Keep the last log in tmpfs so LuCI can explain a failed restart.
+	:
+}
+
+service_stopped() {
+	[ ! -x /usr/sbin/c2000max-daed-cleanup ] ||
+		/usr/sbin/c2000max-daed-cleanup >/dev/null 2>&1 || true
+	[ ! -x /usr/sbin/c2000max-daed-hybrid ] ||
+		/usr/sbin/c2000max-daed-hybrid restore >/dev/null 2>&1 || true
 }
 
